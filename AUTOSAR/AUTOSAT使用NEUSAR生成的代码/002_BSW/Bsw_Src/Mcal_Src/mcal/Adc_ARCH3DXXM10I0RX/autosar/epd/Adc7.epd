                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="883f7cd2-417c-4ca1-a2e5-1f97c1d55559">
                  <SHORT-NAME>AdcPowerStateConfig</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Each instance of this parameter defines a power state and the callback to be called when this power state is reached.</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                  <PARAMETERS>
                    <ECUC-INTEGER-PARAM-DEF UUID="24cdf606-04a0-47e8-9dab-95673ea4d126">
                      <SHORT-NAME>AdcPowerState</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Each instance of this parameter describes a different power state supported by the ADC HW. It should be defined by the HW supplier and used by the ADCDriver to reference specific HW configurations which set the  ADC HW module in the referenced power state.</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
