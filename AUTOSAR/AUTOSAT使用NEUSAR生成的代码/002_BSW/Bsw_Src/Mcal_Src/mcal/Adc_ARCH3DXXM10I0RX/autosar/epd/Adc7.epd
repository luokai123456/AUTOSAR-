                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CLK_SEL_PS_DIV_6</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CLK_SEL_PS_DIV_8</SHORT-NAME>
