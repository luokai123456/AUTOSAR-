                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                    </ECUC-VALUE-CONFIGURATION-CLASS>
                  </VALUE-CONFIG-CLASSES>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>0</DEFAULT-VALUE>
                  <MAX>15</MAX>
                  <MIN>0</MIN>
                </ECUC-INTEGER-PARAM-DEF>
                <ECUC-INTEGER-PARAM-DEF UUID="0eb89cce-8ae6-4ce3-687e-cf952d3895f8">
                  <SHORT-NAME>EQADC89_DigitalFilterLength</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">The DFL bit is set for EQADC89.</L-2>
                  </DESC>
                  <SCOPE>LOCAL</SCOPE>
