                        <ECUC-BOOLEAN-PARAM-DEF UUID="3cacb124-d0108-480e-9ae9-ad701abac082">
                          <SHORT-NAME>ResultTransInhibit</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Result Transfer Inhibit / Decimation Filter Pre-Fill.</L-2>
                          </DESC>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>CCFC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
