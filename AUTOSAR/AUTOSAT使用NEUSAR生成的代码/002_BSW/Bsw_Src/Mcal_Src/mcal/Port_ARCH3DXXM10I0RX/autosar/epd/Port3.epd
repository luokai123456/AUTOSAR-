            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:002fc40a-1304-484b-980a-9290886a1f0b">
              <SHORT-NAME>PortGeneral</SHORT-NAME>
              <DESC>
                <L-2 L="EN">
                        &lt;html&gt;
                          &lt;p&gt;
                            Module wide configuration parameters of the PORT driver.
                          &lt;/p&gt;
                        &lt;/html&gt;</L-2>
              </DESC>
              <PARAMETERS>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:6a7bcc4d-97ad-4a4a-a4bd-a3e4a89090c2">
                  <SHORT-NAME>PortDevErrorDetect</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                          &lt;html&gt;
                            &lt;p&gt;
                              Switches the Development Error Detection and Notification ON or OFF.
                            &lt;/p&gt;
                          &lt;/html&gt;</L-2>
                  </DESC>
