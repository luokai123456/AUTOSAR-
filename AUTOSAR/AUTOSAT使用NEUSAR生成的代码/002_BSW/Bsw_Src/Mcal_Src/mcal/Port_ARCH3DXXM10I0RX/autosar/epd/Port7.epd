                        <ECUC-REFERENCE-DEF UUID="07a3f7c5-d8ac-4b09-aae6-17c730545210">
                          <SHORT-NAME>PortPinEcucPartitionRef</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Maps the Port pin to zero a multiple ECUC partitions. The ECUC partitions referenced are a subset of the ECUC partitions where the Port driver is mapped to.</L-2>
                            <L-2 L="EN">Tags: atp.Status=draft</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY-INFINITE>1</UPPER-MULTIPLICITY-INFINITE>
