                          </a:a>
                          <a:a name="ORIGIN" value="AUTOSAR_ECUC" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          <a:a name="UUID" value="ECUC:5254775c-f65c-49df-31d4-158724c60f2f" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          <a:da name="DEFAULT" value="PORT_PIN_LEVEL_NOTCHANGED" />
                          <a:da name="EDITABLE" value="false"/>
                          <a:da name="RANGE">
                            <a:v>PORT_PIN_LEVEL_HIGH</a:v>
                            <a:v>PORT_PIN_LEVEL_LOW</a:v>
                            <a:v>PORT_PIN_LEVEL_NOTCHANGED</a:v>
                          </a:da>
