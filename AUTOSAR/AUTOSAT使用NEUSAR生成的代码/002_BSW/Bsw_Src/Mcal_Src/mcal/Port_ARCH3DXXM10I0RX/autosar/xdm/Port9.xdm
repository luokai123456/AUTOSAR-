                        <v:var name="PortVoltageModeSelector" type="ENUMERATION">
                          <a:a name="DESC">
                            <a:v>Voltage Mode Selector </a:v>
                          </a:a>
                          <a:a name="ORIGIN" value="CCFC" />
                          <a:a name="SYMBOLICNAMEVALUE" value="false" />
                          <a:a name="UUID" value="e7fc4b4b-68a6-412a-befc-83473a0b779c" />
                          <a:a name="__ORIGIN" value="Elektrobit" />
                          <a:da name="DEFAULT" value="5_0V" />
                          <a:da name="RANGE">
                            <a:v>5_0V</a:v>
                            <a:v>3_3V</a:v>
                            <a:v>1_8V</a:v>
                          </a:da>
                          <a:da name="INVALID" type="XPath">
                            <a:tst expr="(. = '5_0V') and contains(concat(',',string(ecu:get(&apos;PortFastIoPins&apos;)),','),concat(',',node:fallback(../PortPinPcr,0),','))" true ="Fast I/O not support 5_0V"/>
                            <a:tst expr="(. = '1_8V') and not(contains(concat(',',string(ecu:get(&apos;PortFastIoPins&apos;)),','),concat(',',node:fallback(../PortPinPcr,0),',')))" true ="Medium I/O not support 1_8V"/>
                          </a:da>
                        </v:var>

                        <v:var name="PortPinDrivingStrength" type="ENUMERATION">
                          <a:a name="DESC">
                            <a:v>Port Pin Driving Strength </a:v>
                          </a:a>
                          <a:a name="ORIGIN" value="CCFC" />
                          <a:a name="SYMBOLICNAMEVALUE" value="false" />
                          <a:a name="UUID" value="348c8144-96a8-442a-8f94-b1428fb73a0f" />
                          <a:a name="__ORIGIN" value="Elektrobit" />
                          <a:da name="DEFAULT" value="NORMAL_DRIVE" />
                          <a:da name="RANGE">
                            <a:v>NORMAL_DRIVE</a:v>
                            <a:v>MEDIUM_DRIVE</a:v>
                            <a:v>HIGH_DRIVE</a:v>
                          </a:da>
                          <a:da name="INVALID" type="XPath">
                            <a:tst expr="(. = 'HIGH_DRIVE') and not(contains(concat(',',string(ecu:get(&apos;PortFastIoPins&apos;)),','),concat(',',node:fallback(../PortPinPcr,0),',')))" true ="Medium I/O not support HIGH_DRIVE"/>
                          </a:da>
                        </v:var>

