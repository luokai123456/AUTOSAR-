                            <a:v>EIRQ1</a:v>
                            <a:v>EIRQ2</a:v>
                            <a:v>EIRQ3</a:v>
                            <a:v>EIRQ4</a:v>
                            <a:v>EIRQ5</a:v>
                            <a:v>EIRQ6</a:v>
                            <a:v>EIRQ7</a:v>
                            <a:v>EIRQ8</a:v>
                            <a:v>EIRQ9</a:v>
                            <a:v>EIRQ10</a:v>
                            <a:v>EIRQ11</a:v>
                            <a:v>EIRQ12</a:v>
                            <a:v>EIRQ13</a:v>
                            <a:v>EIRQ14</a:v>
                            <a:v>EIRQ15</a:v>
                        </a:da>
                        </v:var>

                        <v:var name="event_edge_sel" type="ENUMERATION">
                        <a:a name="DESC" value="EN: Select trigger source along events." />
                        <a:a name="ORIGIN" value="CCFC" />
                        <a:a name="SYMBOLICNAMEVALUE" value="false" />
                        <a:a name="UUID" value="ae2525a2-5e35-4adf-b970-afc529971d1e" />
                        <a:a name="__ORIGIN" value="Elektrobit" />
                        <a:da name="DEFAULT" value="SIUL2_EVENT_DISABLED" />
                        <a:da name="RANGE">
                                  <a:v>SIUL2_EVENT_DISABLED</a:v>
                                  <a:v>SIUL2_EVENT_RISING_EDGE</a:v>
                                  <a:v>SIUL2_EVENT_FALLING_EDGE</a:v>
                                  <a:v>SIUL2_EVENT_EITHER_EDGE</a:v>
                        </a:da>
                        </v:var>

                        <v:var name="eirq_callback" type="FUNCTION-NAME">
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:<html><p>
                                    callback function.<br>
                                </p></html>]]>
                            </a:v>
                        </a:a>
                        <a:a name="ORIGIN" value="CCFC"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:bf476e30-7c7b-406c-9ed5-850380c1f713"/>
