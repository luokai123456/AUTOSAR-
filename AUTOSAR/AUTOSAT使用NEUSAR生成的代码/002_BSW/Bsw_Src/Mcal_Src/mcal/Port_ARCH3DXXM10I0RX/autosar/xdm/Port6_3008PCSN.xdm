<?xml version="1.0" encoding="utf-8"?>
<datamodel version="7.0" xmlns="http://www.tresos.de/_projects/DataModel2/16/root.xsd" xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd" xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd" xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">
  <d:ctr type="AUTOSAR" factory="autosar" xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd" xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd" xmlns:f="http://www.tresos.de/_projects/DataModel2/14/formulaexpr.xsd" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd" xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd" xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="PortConfig" type="AR-PACKAGE">
        <d:lst type="ELEMENTS">
          <d:chc name="Port" type="AR-ELEMENT" value="MODULE-DEF">
            <v:ctr type="MODULE-DEF">
              <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                <ad:ADMIN-DATA>
                  <ad:DOC-REVISIONS>
                    <ad:DOC-REVISION>
                      <ad:REVISION-LABEL>4.4.0</ad:REVISION-LABEL>
                      <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                    </ad:DOC-REVISION>
                  </ad:DOC-REVISIONS>
                </ad:ADMIN-DATA>
              </a:a>
              <a:a name="DESC" value="EN: Configuration of the Port module." />
              <a:a name="LOWER-MULTIPLICITY" value="1" />
              <a:a name="POSTBUILDVARIANTSUPPORT" value="true" />
              <a:a name="RELEASE" value="asc:4.4.0" />
              <a:a name="UPPER-MULTIPLICITY" value="1" />
              <a:a name="UUID" value="644fc548-e347-4cfa-802f-4e56e6fa0ebe" />
              <v:var name="POST_BUILD_VARIANT_USED" type="BOOLEAN">
                <a:a name="DESC" value="Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points." />
                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                </a:a>
                <a:a name="LABEL" value="Post Build Variant Used" />
                <a:a name="ORIGIN" value="EB" />
                <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                <a:a name="UUID" value="58a698ed-802e-4f25-a77d-551b5230a7b8" />
                <a:a name="__ORIGIN" value="Elektrobit" />
                <a:da name="DEFAULT" value="false" />
                <a:da name="READONLY" value="FALSE" />
                <a:da name="TOOLTIP" value="Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points." />
              </v:var>
              <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                  <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                </a:a>
                <a:a name="LABEL" value="Config Variant" />
                <a:a name="UUID" value="a96de1e1-0091-4ab3-a7aa-7a9511eb1ddc" />
                <a:a name="__ORIGIN" value="Elektrobit" />
                <a:da name="DEFAULT" value="VariantPostBuild" />
                <a:da name="RANGE">
                  <a:v>VariantPostBuild</a:v>
                  <a:v>VariantPreCompile</a:v>
                </a:da>
              </v:var>
              <v:ctr name="PortConfigSet" type="IDENTIFIABLE">
                <a:a name="DESC" value="EN: This container contains the configuration parameters and sub containers of the AUTOSAR Port module." />
                <a:a name="UUID" value="0b2184cb-1cf1-4aa5-a234-1c53838fef97" />
                <v:ctr name="NotUsedPortPin" type="IDENTIFIABLE">
                  <a:a name="DESC" value="EN: The init parameters values for the notused pins in the PORT configuration." />
                  <a:a name="UUID" value="22cc5c28-b5e8-4acf-bbcb-775b52cd87e0" />
                  <v:var name="PortPinWpde" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v>EN: Enable Weak Pull Down for the configured Pin.
                                                 Checked box means Weak Pull Down configurations is enabled for the pin.
                                                 This is an implementation specific parameter.</a:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="ed9175b2-76e2-4115-80ca-c9cf37276172" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="false" />
                  </v:var>
                  <v:var name="PortPinWpue" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v>EN: Enable Weak Pull Up for the configured Pin.
                                                 Checked box means Weak Pull Up configurations is enabled for the pin.
                                                 This is an implementation specific parameter.</a:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="1bf4cd27-9edb-445b-9fab-abddd857e341" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="false" />
                  </v:var>
                  <v:var name="PortPinDirection" type="ENUMERATION">
                    <a:a name="LABEL" value="PortPin Direction" />
                    <a:a name="DESC">
                      <a:v><![CDATA[
                                       <html>
                                         <p>
                                            Configure DIRECTION for the configured Pin.
                                         </p>
                                       </html>
                                    ]]></a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Ccfc" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="ECUC:a25bd9ff-6fe8-9b5c-b874-235891a34f3e" />
                    <a:da name="DEFAULT" value="PORT_PIN_IN" />
                    <a:da name="RANGE">
                      <a:v>PORT_PIN_IN</a:v>
                      <a:v>PORT_PIN_OUT</a:v>
                    </a:da>
                  </v:var>
                  <v:var name="PortPinLevelValue" type="ENUMERATION">
                    <a:a name="LABEL" value="PortPin Level Value" />
                    <a:a name="DESC">
                      <a:v><![CDATA[EN:
                                                            <html>
                                                              <p>
                                                                Port Pin Level value from Port pin list.
                                                              </p>
                                                            </html>
                                                            ]]></a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="ECUC:0fba48fe-308f-e323-7981-add911304ff8" />
                    <a:da name="DEFAULT" value="PORT_PIN_LEVEL_LOW" />
                    <a:da name="RANGE">
                      <a:v>PORT_PIN_LEVEL_HIGH</a:v>
                      <a:v>PORT_PIN_LEVEL_LOW</a:v>
                    </a:da>
                  </v:var>
                </v:ctr>
                <v:lst name="PortContainer" type="MAP">
                  <a:da name="MIN" value="1" />
                  <v:ctr name="PortContainer" type="IDENTIFIABLE">
                    <a:a name="DESC" value="EN: Container collecting the PortPins." />
                    <a:a name="UUID" value="dc2cf48e-9aff-4073-93fc-b77e9c4e0617" />
                    <v:var name="PortNumberOfPortPins" type="INTEGER">
                      <a:a name="LABEL" value="PortNumberOfPortPins" />
                      <a:a name="DESC">
                        <a:v><![CDATA[EN:
                                                    <html>
                                                      <p>
                                                        The number of specified PortPins in this PortContainer.
                                                      </p>
                                                    </html>
                                                    ]]></a:v>
                      </a:a>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v class="PreCompile">VariantPostBuild</icc:v>
                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:a name="UUID" value="ECUC:560a7c73-d4e1-37f3-4b17-733286dab86d" />
                      <a:da name="DEFAULT" type="XPath">
                        <a:tst expr="num:i(count(node:fallback(node:current()/../PortPin/*,text:split('1 2 3'))))" />
                      </a:da>
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&gt;=1" />
                        <a:tst expr="&lt;=406" />
                      </a:da>
                      <a:da name="RANGE" type="XPath">
                        <a:tst expr="node:fallback(., 1) = count(node:fallback(node:current()/../PortPin/*,text:split('1 2 3')))" false=" For calculating the correct value use the CALC button" />
                      </a:da>
                      <a:da name="TOOLTIP" type="XPath" expr="num:i(num:i(count(node:current()/../PortPin/*)))" />
                    </v:var>
                    <v:lst name="PortPin" type="MAP">
                      <a:da name="MIN" value="1" />
                      <v:ctr name="PortPin" type="IDENTIFIABLE">
                        <a:a name="DESC" value="EN: Configuration of the individual port pins." />
                        <a:a name="UUID" value="3f7c642c-2643-4d21-a144-eda571dc3ee9" />
                        <v:var name="PortPinWpde" type="BOOLEAN">
                          <a:a name="DESC">
                            <a:v>EN: Enable Weak Pull Down for the configured Pin.
                                                        Checked box means Weak Pull Down configurations is enabled for the pin.
                                                        This is an implementation specific parameter.</a:v>
                          </a:a>
                          <a:a name="ORIGIN" value="CCFC" />
                          <a:a name="SYMBOLICNAMEVALUE" value="false" />
                          <a:a name="UUID" value="cb2b9ee1-c249-4df2-b6c2-d3fc12f38d68" />
                          <a:a name="__ORIGIN" value="Elektrobit" />
                          <a:da name="DEFAULT" value="false" />
                        </v:var>
                        <v:var name="PortPinWpue" type="BOOLEAN">
                          <a:a name="DESC">
                            <a:v>EN: Enable Weak Pull Up for the configured Pin.
                                                            Checked box means Weak Pull Up configurations is enabled for the pin.
                                                            This is an implementation specific parameter.</a:v>
                          </a:a>
                          <a:a name="ORIGIN" value="CCFC" />
                          <a:a name="SYMBOLICNAMEVALUE" value="false" />
                          <a:a name="UUID" value="861a5ef0-d53e-42da-9467-d66a55a79211" />
                          <a:a name="__ORIGIN" value="Elektrobit" />
                          <a:da name="DEFAULT" value="false" />
                        </v:var>
                        <v:var name="PortPinSafeMode" type="BOOLEAN">
                          <a:a name="LABEL" value="PortPin Safe Mode" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          <a:a name="DESC" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                            <a:v><![CDATA[
                                            <html>
                                              <p>
                                              Enable/Disable Safe Mode for the pin. Checked box means the Safe Mode is enabled.
                                              </p>
                                            </html>
                                        ]]></a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                            <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                            <icc:v class="PostBuild" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="CCFC" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          <a:a name="UUID" value="ECUC:92572946-9cc0-4ca2-0ed9-825fc6c7a13d" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          <a:da name="DEFAULT" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                        </v:var>
                        <v:var name="PortPinWithReadBack" type="BOOLEAN">
                          <a:a name="DESC">
                            <a:v>EN: Enables/Disables the read back possibility for this pin. Checked box means the Read Back is enabled.
                                                        When ReadBack is enabled, the Input Bufer of the pin gets enabled by setting the IBE bit in the MSCR (PCR) of the pin. Some alternate functions working as inputs might require having the IBE set to 1, so check this box in order to achieve this.</a:v>
                          </a:a>
                          <a:a name="ORIGIN" value="CCFC" />
                          <a:a name="SYMBOLICNAMEVALUE" value="false" />
                          <a:a name="UUID" value="e7fc4b4b-68a6-412a-befc-83473a0b779c" />
                          <a:a name="__ORIGIN" value="Elektrobit" />
                          <a:da name="DEFAULT" value="false" />
                        </v:var>
                        <v:var name="PortPinHysteresisControl" type="BOOLEAN">
                          <a:a name="DESC">
                            <a:v>EN: Enable input hysteresis for the associated pin.
                                                        Checked box means Hysteresis configurations is enabled for the pin.
                                                        This is an implementation specific parameter.</a:v>
                          </a:a>
                          <a:a name="ORIGIN" value="CCFC" />
                          <a:a name="SYMBOLICNAMEVALUE" value="false" />
                          <a:a name="UUID" value="09a73d97-c244-407c-bfb5-a7b697961635" />
                          <a:a name="__ORIGIN" value="Elektrobit" />
                          <a:da name="DEFAULT" value="false" />
                        </v:var>
                        <v:var name="PortPinModeChangeable" type="BOOLEAN">
                          <a:a name="LABEL" value="PortPin Mode Changeable" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          <a:a name="DESC" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                            <a:v><![CDATA[EN:
                                                            <html>
                                                              <p>
                                                                Parameter to indicate if the mode of a port pin is changeable during runtime.
                                                                True: Port Pin mode changeable allowed.
                                                                False: Port Pin mode changeable not permitted
                                                              </p>
                                                            </html>
                                                            ]]></a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                            <icc:v class="PostBuild" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                            <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="AUTOSAR_ECUC" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          <a:a name="UUID" value="ECUC:07555032-f5a6-2c08-1748-faa9669d4996" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          <a:da name="DEFAULT" value="true" />
                        </v:var>
                        <v:var name="PortPinDirectionChangeable" type="BOOLEAN">
                          <a:a name="LABEL" value="PortPin Direction Changeable" />
                          <a:a name="DESC" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                            <a:v><![CDATA[EN:
                                                            <html>
                                                              <p>
                                                                Enable/Disable the changeability for the configured Pin.
                                                                Checked box means the Direction Changeability is enabled.
                                                                This is an implementation specific parameter.
                                                              </p>
                                                            </html>
                                                            ]]></a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                            <icc:v class="PostBuild" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                            <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="AUTOSAR_ECUC" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          <a:a name="UUID" value="ECUC:4e9f4de8-fc13-e3bd-27f9-ce554472182e" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          <a:da name="DEFAULT" value="true" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                        </v:var>
                        <v:var name="PortPinDirection" type="ENUMERATION">
                            <a:a name="LABEL" value="PortPin Direction"/>
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:
                                    <html>
                                      <p>
                                        Selects the direction of the pin (IN, OUT or both) that will be configured by Port_Init() function if the pin is configured as GPIO.
                                        If the direction is not changeable, the value configured here is fixed. For the Alternative Function modes (PortPinMode is different than GPIO),
                                        the setting in this enumeration control is kept in the port configuration structure and it is used when Port_SetPinMode() is called at runtime to change the mode of the pin to GPIO.
                                        If your Alternative Function is an input functionality that requires the IBE bit to be set in the MSCR, please select the checkbox 'PortPinWithReadback.
                                      </p>
                                    </html>
                                    ]]>
                              </a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v class="PostBuild">VariantPostBuild</icc:v>
                              <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:dafa241d-31e0-493f-8e05-3716f0464317"/>
                            <a:da name="DEFAULT" value="PORT_PIN_IN"/>
                            <a:da name="RANGE">
                              <a:v>PORT_PIN_IN</a:v>
                              <a:v>PORT_PIN_OUT</a:v>
                            </a:da>
                            <a:da name="INVALID" type="XPath">
                              <a:tst expr="( (. != 'PORT_PIN_IN') and contains(concat(',',string(ecu:get(&apos;PortOnlyInputPins&apos;)),','),concat(',',node:fallback(../PortPinPcr,0),',')) )" true="For pads in Only Input mode the PortPinDirection value shall be set to PORT_PIN_IN" />
                            </a:da>
                        </v:var>
                        <v:var name="PortPinId" type="INTEGER">
                          <a:a name="LABEL" value="PortPin Id" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          <a:a name="DESC" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                            <a:v><![CDATA[EN:
                                                        <html>
                                                          <p>
                                                            Pin Id of the port pin.
                                                            This value will be assigned to the symbolic name
                                                            derived from the port pin container short name.
                                                          </p>
                                                        </html>
                                                        ]]></a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                            <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                            <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="AUTOSAR_ECUC" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          <a:a name="SYMBOLICNAMEVALUE" value="true" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          <a:a name="UUID" value="ECUC:f5d289c9-9087-742c-ad27-310f30c21a7d" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          <a:da name="DEFAULT" type="XPath" expr="num:i((node:fallback(node:current()/../@index, '1') + 1) + (count(node:fallback(../../../../*/PortPin/*/PortPinId,text:split('1 2 3')))) - count(node:fallback(../../*,text:split('1 2 3'))))" />
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&gt;=1" />
                            <a:tst expr="&lt;=332" />
                          </a:da>
                          <a:da name="RANGE" type="XPath">
                            <a:tst expr="text:uniq((node:fallback(../../../../*/PortPin/*/PortPinId,text:split('1 2 3'))), node:fallback(.,1))" false="The value of PortPinId is not unique for this configuration." />
                            <a:tst expr="node:fallback(., 1) &lt;= count(node:fallback(../../../../*/PortPin/*, text:split('1 2 3')))" false="The value of PortPinId can't be higher than the number of defined pins" />
                          </a:da>
                        </v:var>
                        <v:var name="PortPinPcr" type="INTEGER">
                          <a:a name="LABEL" value="PortPinPcr" />
                          <a:a name="DESC">
                            <a:v><![CDATA[EN:
                                                            <html>
                                                              <p>
                                                                Pin Id of the port pin.This value will be assigned to the symbolic name derived from the port pin container short name.
                                                              </p>
                                                            </html>
                                                            ]]></a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PostBuild">VariantPostBuild</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="Ccfc" />
                          <a:a name="SYMBOLICNAMEVALUE" value="false" />
                          <a:a name="UUID" value="ECUC:01514c4d-a9bf-05ff-efe2-dabce07a2395" />
                          <a:da name="DEFAULT" type="XPath" expr="num:i((node:fallback(node:current()/../@index, '0') + 0) + (count(node:fallback(../../../../*/PortPin/*/PortPinPcr,text:split('1 2 3')))) - count(node:fallback(../../*,text:split('1 2 3'))))" />
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&gt;=0" />
                            <a:tst expr="&lt;=331" />
                          </a:da>
                          <a:da name="RANGE" type="XPath">
                            <a:tst expr="contains(concat(',',string(ecu:get(&apos;PortNotAvailablePins&apos;)),','),concat(',',node:fallback(.,0),','))" true ="Invalid Pin number for current package"/>
                            <a:tst expr="text:uniq((node:fallback(../../../../*/PortPin/*/PortPinPcr,text:split('1 2 3'))), node:fallback(.,0))" false="PortPinPcr is repeated for two or more ports. Use the Calc button to calculate correct default value." />
                            <a:tst expr="node:fallback(.,0) &gt; ecu:get('PortMaxPinNumber')" true="Invalid Pin number for current package" />
                          </a:da>
                        </v:var>
                        <v:var name="PortPinInitialMode" type="ENUMERATION">
                          <a:a name="LABEL" value="PortPin Initial Mode"/>
                          <a:a name="DESC">
                            <a:v>
                              <![CDATA[EN:
                                  <html>
                                    <p>
                                      Port pin mode from mode list for use with Port_Init() function.
                                      NOTE: This parameter is not used in the current implementation and is retained as per std
                                      AUTOSAR_EcucParamDef.arxml file.
                                    </p>
                                  </html>
                                  ]]>
                            </a:v>
                          </a:a>
