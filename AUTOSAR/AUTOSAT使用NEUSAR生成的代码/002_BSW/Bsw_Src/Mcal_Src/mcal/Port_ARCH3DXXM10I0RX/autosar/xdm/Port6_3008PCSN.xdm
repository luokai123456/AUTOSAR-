                            <a:tst expr="node:fallback(../PortPinPcr, 0) = 0" true="GTM_TIM1_IN4_9"/> 
                            <a:tst expr="node:fallback(../PortPinPcr, 0) = 0" true="GTM_TIM0_IN6_7"/> 
                            <a:tst expr="node:fallback(../PortPinPcr, 0) = 0" true="IRQ7"/> 
                            <a:tst expr="node:fallback(../PortPinPcr, 0) = 0" true="DSPI_CS3_3"/> 
                            <a:tst expr="node:fallback(../PortPinPcr, 0) = 0" true="DSPI_CS4_5"/> 
                            <a:tst expr="node:fallback(../PortPinPcr, 0) = 0" true="GTM_TOUT61"/> 
                            <a:tst expr="node:fallback(../PortPinPcr, 0) = 0" true="GTM_TOUT51"/> 
                            <a:tst expr="node:fallback(../PortPinPcr, 0) = 0" true="DSPI_CS2_3"/> 
                            <a:tst expr="node:fallback(../PortPinPcr, 0) = 0" true="DSPI_CS3_5"/> 
                            <a:tst expr="node:fallback(../PortPinPcr, 0) = 0" true="GTM_TOUT62"/> 
                            <a:tst expr="node:fallback(../PortPinPcr, 0) = 0" true="DSPI_SOUT_1_OUT"/> 
                            <a:tst expr="node:fallback(../PortPinPcr, 0) = 0" true="GTM_TOUT68"/> 
                          </a:da>
                          <a:da name="INVALID" type="XPath">
                            <a:tst expr="(text:uniq((node:fallback(../../*/PortPinMode,text:split('1 2 3'))), node:fallback(.,0)) or (.='PORT_PIN_MODE_GPIO'))" false="PortPinMode repeated for two or more ports. The only mode that can be repeated for Pins is PORT_PIN_MODE_GPIO"/>
                          </a:da>
                        </v:var>
                        <v:var name="PortPinOutputDriveControl" type="ENUMERATION">
                          <a:a name="DESC">
                            <a:v>EN: Open Drive control for the configured Pin.
                                                            Specifies the type of output drive control for the associated pin.
                                                            Note : After selecting pin as OUTPUT this field can be configured.</a:v>
                          </a:a>
                          <a:a name="ORIGIN" value="CCFC" />
                          <a:a name="SYMBOLICNAMEVALUE" value="false" />
                          <a:a name="UUID" value="f4852593-dce5-42ee-8ecd-f8b46ee31ba3" />
                          <a:a name="__ORIGIN" value="Elektrobit" />
                          <a:da name="DEFAULT" value="PORT_OUTPUT_BUFFER_DISABLED" />
                          <a:da name="RANGE">
                            <a:v>PORT_OUTPUT_BUFFER_DISABLED</a:v>
                            <a:v>PORT_OPEN_DRAIN</a:v>
                            <a:v>PORT_PUSH_PULL</a:v>
                            <a:v>PORT_OPEN_SOURCE</a:v>
                            <a:v>PORT_MICRO_LVDS</a:v>
                            <a:v>PORT_LFAST_LVDS</a:v>
                          </a:da>
                        </v:var>
                        <v:var name="PortPinOutputEdgeRateControl" type="ENUMERATION">
                          <a:a name="DESC">
                            <a:v>EN: Specifies the logic family for the associated pin, which determines its logic switching
                                                            levels Rate for the configured Pin. This is an implementation specific parameter.</a:v>
                          </a:a>
                          <a:a name="ORIGIN" value="CCFC" />
                          <a:a name="SYMBOLICNAMEVALUE" value="false" />
                          <a:a name="UUID" value="80bf768f-66d4-47d9-bec7-bb7a06aae922" />
                          <a:a name="__ORIGIN" value="Elektrobit" />
                          <a:da name="DEFAULT" value="WEAK_DRIVE" />
                          <a:da name="RANGE">
                            <a:v>WEAK_DRIVE</a:v>
                            <a:v>MEDIUM_DRIVE</a:v>
                            <a:v>STRONG_DRIVE</a:v>
                            <a:v>VERY_STRONG_DRIVE</a:v>
                            <a:v>SLEW_RATE_6PF</a:v>
                            <a:v>SLEW_RATE_12PF</a:v>
                            <a:v>SLEW_RATE_18PF</a:v>
                            <a:v>SLEW_RATE_30PF</a:v>
                          </a:da>
                        </v:var>


                      <v:ctr name="PortInterruptSource" type="IDENTIFIABLE">
                        <a:a name="DESC" value="EN: Siul2 Interrup set."/>
                        <a:a name="UUID" value="72871dbe-a1ce-068f-5302-7c4eb4a751d7"/>
                        <a:a name="OPTIONAL" value="true"/>

                        <v:var name="eirq_index" type="ENUMERATION">
                        <a:a name="DESC" value="EN: eirq Interrupt number." />
                        <a:a name="ORIGIN" value="CCFC" />
                        <a:a name="SYMBOLICNAMEVALUE" value="false" />
                        <a:a name="UUID" value="ae2525a3-5e35-4adf-b970-afc529971d1e" />
                        <a:a name="__ORIGIN" value="Elektrobit" />
                        <a:da name="DEFAULT" value="EIRQ0" />
