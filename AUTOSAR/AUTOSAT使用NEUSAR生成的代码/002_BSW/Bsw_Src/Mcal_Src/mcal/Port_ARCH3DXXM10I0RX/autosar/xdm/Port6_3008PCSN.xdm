                        <v:var name="PortPinInputLevelSelection" type="ENUMERATION">
                          <a:a name="DESC">
                            <a:v>EN: Specifies the logic family for the associated pin, which determines its
                                                            logic switching levels Rate for the configured Pin. This is an implementation specific parameter.</a:v>
                          </a:a>
                          <a:a name="ORIGIN" value="CCFC" />
                          <a:a name="SYMBOLICNAMEVALUE" value="false" />
                          <a:a name="UUID" value="348c8144-96a8-442a-8f94-b1428fb73a0f" />
                          <a:a name="__ORIGIN" value="Elektrobit" />
                          <a:da name="DEFAULT" value="AUTOMOTIVE" />
