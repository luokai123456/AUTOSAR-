                            <a:tst expr="node:fallback(../PortLVDSPinPair, 0) = 'PORT_87_107'" true="DSPI14_SOUT"/>
                            <a:tst expr="node:fallback(../PortLVDSPinPair, 0) = 'PORT_87_88'" true="DSPI14_SOUT"/>
                            <a:tst expr="node:fallback(../PortLVDSPinPair, 0) = 'PORT_85_86'" true="DSPI14_SCK"/>
                            <a:tst expr="node:fallback(../PortLVDSPinPair, 0) = 'PORT_148_149'" true="DSPI13_SCK"/>
                            <a:tst expr="node:fallback(../PortLVDSPinPair, 0) = 'PORT_81_83'" true="DSPI11_SCK"/>
                            <a:tst expr="node:fallback(../PortLVDSPinPair, 0) = 'PORT_81_82'" true="DSPI11_SCK"/>
                            <a:tst expr="node:fallback(../PortLVDSPinPair, 0) = 'PORT_83_84'" true="DSPI18_SOUT"/>
                            <a:tst expr="node:fallback(../PortLVDSPinPair, 0) = 'PORT_148_149'" true="DSPI20_SCK"/>
                            <a:tst expr="node:fallback(../PortLVDSPinPair, 0) = 'PORT_81_82'" true="DSPI18_SCK"/>
                            <a:tst expr="node:fallback(../PortLVDSPinPair, 0) = 'PORT_121_122'" true="DSPI15_SCK"/>
                            <a:tst expr="node:fallback(../PortLVDSPinPair, 0) = 'PORT_142_143'" true="DSPI18_SIN"/>
                            <a:tst expr="node:fallback(../PortLVDSPinPair, 0) = 'PORT_105_106'" true="DSPI18_SIN"/>
