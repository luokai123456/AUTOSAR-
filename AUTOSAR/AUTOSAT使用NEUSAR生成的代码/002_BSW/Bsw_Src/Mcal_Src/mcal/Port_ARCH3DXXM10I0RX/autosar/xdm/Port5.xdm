              <v:ctr name="PortGeneral" type="IDENTIFIABLE">
                <a:a name="DESC">
                  <a:v><![CDATA[EN:
                        <html>
                          <p>
                            Module wide configuration parameters of the PORT driver.
                          </p>
                        </html>
                        ]]></a:v>
                </a:a>
                <a:a name="UUID" value="ECUC:002fc40a-1304-484b-980a-9290886a1f0b" />
                <!-- @implements PortDevErrorDetect_Object -->
                <v:var name="PortDevErrorDetect" type="BOOLEAN">
                  <a:a name="LABEL" value="Port Development Error Detect" />
                  <a:a name="DESC">
                    <a:v><![CDATA[EN:
                          <html>
                            <p>
                              Switches the Development Error Detection and Notification ON or OFF.
                            </p>
                          </html>
                          ]]></a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v class="PreCompile">VariantPostBuild</icc:v>
                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="ECUC:6a7bcc4d-97ad-4a4a-a4bd-a3e4a89090c2" />
                  <a:da name="DEFAULT" value="true" />
                </v:var>
                <!-- @implements PortSetPinDirectionApi_Object -->
                <v:var name="PortSetPinDirectionApi" type="BOOLEAN">
                  <a:a name="LABEL" value="Port SetPinDirection Api" />
                  <a:a name="DESC">
                    <a:v><![CDATA[EN:
                          <html>
                            <p>
                              Pre-processor switch to enable/disable the use of the function Port_SetPinDirection().
                            </p>
                          </html>
                          ]]></a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v class="PreCompile">VariantPostBuild</icc:v>
                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="ECUC:f223bc4c-3516-482a-ae62-48f144566318" />
                  <a:da name="DEFAULT" value="true" />
                </v:var>
                <!-- @implements PortSetPinModeApi_Object -->
                <v:var name="PortSetPinModeApi" type="BOOLEAN">
                  <a:a name="LABEL" value="Port SetPinMode Api" />
                  <a:a name="DESC">
                    <a:v><![CDATA[EN:
                          <html>
                            <p>
                              The function for changing the pin modes is not supported by the safety implementation.
                            </p>
                          </html>
                          ]]></a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v class="PreCompile">VariantPostBuild</icc:v>
                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="ECUC:1f7dd044-d03f-43b6-842f-d9374c1d2746" />
                  <a:da name="DEFAULT" value="true" />
                </v:var>
                <!-- @implements PortVersionInfoApi_Object -->
                <v:var name="PortVersionInfoApi" type="BOOLEAN">
                  <a:a name="LABEL" value="Port VersionInfo Api" />
                  <a:a name="DESC">
                    <a:v><![CDATA[EN:
                          <html>
                            <p>
                               Pre-processor switch to enable/disable the API to read out the modules version information.
                            </p>
                          </html>
                          ]]></a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v class="PreCompile">VariantPostBuild</icc:v>
                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="ECUC:2c37b26f-6eb3-4634-b10b-a635599a9f1b" />
                  <a:da name="DEFAULT" value="true" />
                </v:var>
                <!-- @implements PortSetPinModeDoesNotTouchGpioLevel_Object -->
                <v:var name="PortSetPinModeDoesNotTouchGpioLevel" type="BOOLEAN">
                  <a:a name="LABEL" value="Port SetPinMode Does Not Touch GPIO Levels" />
                  <a:a name="DESC">
                    <a:v><![CDATA[EN:
                          <html>
                            <p>
                               Pre-processor switch. When not checked, the function Port_SetPinMode() will set the output level of the pin to the value configured in the PortPinLevelValue combo when called at run time to change mode of a pin from alternate function to GPIO. When checked, the function Port_SetPinMode() will not touch the output level of the pin when called at run time to change mode of a pin from alternate function to GPIO.
                            </p>
                          </html>
                          ]]></a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v class="PreCompile">VariantPostBuild</icc:v>
                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="CCFC" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="ECUC:2c37b26f-6cb3-4634-b20b-b635599a9f1b" />
                  <a:da name="DEFAULT" value="false" />
                </v:var>
                <!-- @implements PortEnableUserModeSupport_Object -->
                <v:var name="PortEnableUserModeSupport" type="BOOLEAN">
                  <a:a name="DESC">
                    <a:v><![CDATA[EN:<html>
                                When this parameter is enabled, the Port module will adapt to run from User Mode, with the following measures:<p/>
                                a) configuring REG_PROT for SIUL2 IP so that the registers under protection can be accessed from user mode by setting UAA bit in REG_PROT_GCR to 1<p/>
                                b) using 'call trusted function' stubs for all internal function calls that access registers requiring supervisor mode.<p/>
                                for more information, please see chapter 5.7 User Mode Support in IM <p/>
                                Note: Implementation Specific Parameter.
                            </html>]]></a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                    <icc:v class="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="LABEL" value="Port Enable User Mode Support" />
                  <a:a name="ORIGIN" value="CCFC" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="ECUC:2c37b26f-6cb3-4634-b20b-b637799a9f1c" />
                  <a:da name="DEFAULT" value="false" />
                </v:var>
                <v:var name="PortInlineSupport" type="BOOLEAN">
                    <a:a name="LABEL" value="PortInlineSupport"/>
                    <a:a name="DESC"
                         value="EN: Whether on or off INLINE can be configured."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:94cb0b73-61e0-a5ec-c2e0-1e14bf1d4c83"/>
                    <a:da name="DEFAULT" value="true"/>
                </v:var>
                <!-- <v:var name="IoDriverEnhance" type="BOOLEAN">
                    <a:a name="LABEL" value="IoDriverEnhance"/>
                    <a:a name="DESC"
                         value="EN: This configuration item enables the enhanced mode of the IO driver."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:94cb0b73-61e0-a5ec-c2e0-1e14bf1d4c93"/>
                    <a:da name="DEFAULT" value="false"/>
                </v:var> -->
                <v:lst name="PortEcucPartitionRef">
                  <v:ref name="PortEcucPartitionRef" type="REFERENCE">
                    <a:a name="DESC" xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd">
                      <a:v>EN: Maps the Port driver to zero a multiple ECUC partitions to make the modules API available in this partition.</a:v>
                      <a:v>EN: Tags: atp.Status=draft</a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd">
                      <icc:v mclass="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                      <icc:v mclass="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                      <icc:v vclass="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd" />
                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd" />
                    <a:a name="SCOPE" value="ECU" xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd" />
                    <a:a name="UUID" value="8167e8ff-941c-49d8-af88-adb54fa12226" xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd" />
                    <a:a name="__ORIGIN" value="Elektrobit" xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd" />
                    <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition" xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd" />
                  </v:ref>
                </v:lst>
              </v:ctr>
              <v:ctr name="CommonPublishedInformation" type="IDENTIFIABLE">
                <a:a name="DESC" value="EN: Common container, aggregated by all modules. It contains published information about vendor and versions." />
                <a:a name="UUID" value="41ef6bd5-47f0-4c21-8f10-371deb236f8a" />
                <v:var name="ArReleaseMajorVersion" type="INTEGER">
                  <a:a name="DESC" value="EN: Major version number of AUTOSAR specification on which the appropriate implementation is based on." />
                  <a:a name="ORIGIN" value="CCFC" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="d0b44564-eb24-42e7-8b48-49a0aa88429d" />
                  <a:a name="__ORIGIN" value="Elektrobit" />
                  <a:da name="DEFAULT" value="4" />
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=4" />
                    <a:tst expr="&gt;=4" />
                  </a:da>
                </v:var>
                <v:var name="ArReleaseMinorVersion" type="INTEGER">
                  <a:a name="DESC" value="EN: Minor version number of AUTOSAR specification on which the appropriate implementation is based on." />
                  <a:a name="ORIGIN" value="CCFC" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="5020f6c8-c51c-4d26-8846-671307d1aea8" />
                  <a:a name="__ORIGIN" value="Elektrobit" />
                  <a:da name="DEFAULT" value="4" />
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=4" />
                    <a:tst expr="&gt;=4" />
                  </a:da>
                </v:var>
                <v:var name="ArReleaseRevisionVersion" type="INTEGER">
                  <a:a name="DESC" value="EN: Revision version number of AUTOSAR specification on which the appropriate implementation is based on." />
                  <a:a name="ORIGIN" value="CCFC" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="3cb33bb5-559a-40c0-a257-9b123b542d6e" />
                  <a:a name="__ORIGIN" value="Elektrobit" />
                  <a:da name="DEFAULT" value="0" />
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=0" />
                    <a:tst expr="&gt;=0" />
                  </a:da>
                </v:var>
                <v:var name="ModuleId" type="INTEGER">
                  <a:a name="DESC" value="EN: Module ID of this module from Module List." />
                  <a:a name="ORIGIN" value="CCFC" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="d44e0fc5-66b2-44d9-ae9f-9eb674893cef" />
                  <a:a name="__ORIGIN" value="Elektrobit" />
                  <a:da name="DEFAULT" value="124" />
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=124" />
                    <a:tst expr="&gt;=124" />
                  </a:da>
                </v:var>
                <v:var name="SwMajorVersion" type="INTEGER">
                  <a:a name="DESC" value="EN: Major version number of the vendor specific implementation of the module. The numbering is vendor specific." />
                  <a:a name="ORIGIN" value="CCFC" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="ae2525a3-5e35-4adf-b970-afc529971d1e" />
                  <a:a name="__ORIGIN" value="Elektrobit" />
                  <a:da name="DEFAULT" value="3" />
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=3" />
                    <a:tst expr="&gt;=3" />
                  </a:da>
                </v:var>
                <v:var name="SwMinorVersion" type="INTEGER">
                  <a:a name="DESC" value="EN: Minor version number of the vendor specific implementation of the module. The numbering is vendor specific." />
                  <a:a name="ORIGIN" value="CCFC" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="d45433a7-8172-4311-9ae7-97e12a16c767" />
                  <a:a name="__ORIGIN" value="Elektrobit" />
                  <a:da name="DEFAULT" value="0" />
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=0" />
                    <a:tst expr="&gt;=0" />
                  </a:da>
                </v:var>
                <v:var name="SwPatchVersion" type="INTEGER">
                  <a:a name="DESC" value="EN: Patch level version number of the vendor specific implementation of the module. The numbering is vendor specific." />
                  <a:a name="ORIGIN" value="CCFC" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="d5356d3f-1401-47cb-8d5f-d69c6bcb4773" />
                  <a:a name="__ORIGIN" value="Elektrobit" />
                  <a:da name="DEFAULT" value="0" />
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=0" />
                    <a:tst expr="&gt;=0" />
                  </a:da>
                </v:var>
                <v:lst name="VendorApiInfix">
                  <a:da name="MAX" value="1" />
                  <v:var name="VendorApiInfix" type="STRING">
                    <a:a name="DESC">
                      <a:v>EN: In driver modules which can be instantiated several times on a single ECU, BSW00347 requires that the name of APIs is extended by the VendorId and a vendor specific name.
                          This parameter is used to specify the vendor specific name. In total, the implementation specific name is generated as follows:
                          &lt;ModuleName&gt;_&gt;VendorId&gt;_&lt;VendorApiInfix&gt;.
                          E.g.  assuming that the VendorId of the implementor is 123 and the implementer chose a VendorApiInfix of "v11r456" a api name Can_Write defined in the SWS will translate to Can_123_v11r456Write.
                          This parameter is mandatory for all modules with upper multiplicity &gt; 1. It shall not be used for modules with upper multiplicity =1.</a:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="a985730b-489d-47d6-b849-e3b2999c5ac3" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="" />
                  </v:var>
                </v:lst>
                <v:var name="VendorId" type="INTEGER">
                  <a:a name="DESC" value="EN: Vendor ID of the dedicated implementation of this module according to the AUTOSAR vendor list." />
                  <a:a name="ORIGIN" value="CCFC" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="9bb43c84-1db3-4492-9543-21be84372021" />
                  <a:a name="__ORIGIN" value="Elektrobit" />
                  <a:da name="DEFAULT" value="176" />
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=176" />
                    <a:tst expr="&gt;=176" />
                  </a:da>
                </v:var>
              </v:ctr>
              <d:ref type="REFINED_MODULE_DEF" value="ASPath:/AUTOSAR/EcucDefs/Port" />
            </v:ctr>
          </d:chc>
          <d:chc name="myEcuParameterDefinition" type="AR-ELEMENT" value="ECU_PARAMETER_DEFINITION">
            <d:ctr type="AR-ELEMENT">
              <a:a name="DEF" value="ASPath:/AR_PACKAGE_SCHEMA/ECU_PARAMETER_DEFINITION" />
              <d:lst name="MODULE_REF">
                <d:ref type="MODULE_REF" value="ASPath:/PortConfig/Port" />
              </d:lst>
            </d:ctr>
          </d:chc>
        </d:lst>
      </d:ctr>
    </d:lst>
  </d:ctr>
</datamodel>