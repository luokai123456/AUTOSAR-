                          <a:a name="DESC" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                            <a:v><![CDATA[
                                      <html>
                                        <p>
                                          Port Pin Level value from Port pin list.
                                        </p>
                                      </html>
                                    ]]></a:v>
