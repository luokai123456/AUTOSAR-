                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:975474f3-97d0-4e77-a24f-891ef220b5b6">
                  <SHORT-NAME>TimeBaseUnit_CH1</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Vendor specific: Configuration of TimeBaseUnit TBU channel 1.</L-2>
                  </DESC>
                  <PARAMETERS>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:3d2febec-8469-4ab3-a21c-4fa4ac0f19a8">
                      <SHORT-NAME>TBU_CH1_Enable</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Vendor specific: TBU channel 1 enable/disable</L-2>
                      </DESC>
                      <ORIGIN>CCFC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:6089d953-ea61-43de-b572-191de95bd804">
                      <SHORT-NAME>TBU_CH1_Channel_mode</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt; Vendor specific:
                                      Channel mode.
                                      &lt;ul&gt;
                                          &lt;li&gt;Unchecked - Free running counter mode. &lt;/li&gt;
                                          &lt;li&gt;Checked -  Forward/backward counter mode. &lt;/li&gt;
                                      &lt;/ul&gt;
                                      In free running counter mode the CMU clock source specified by TBU_CH1_CMU_Channel_Select is used for the counter.
                                      In Forward/Backward counter mode the SUB_INC[1]c clock signal in combination with the DIR[1] input signal is used to determine the counter direction and clock frequency.
                                      &lt;/html&gt;</L-2>
                      </DESC>
                      <ORIGIN>CCFC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                  </PARAMETERS>
                  <REFERENCES>
                    <ECUC-REFERENCE-DEF UUID="ECUC:25b3a860-f350-498c-90ab-ead304ef0f52">
                      <SHORT-NAME>TBU_CH1_CMU_Channel_Select</SHORT-NAME>
