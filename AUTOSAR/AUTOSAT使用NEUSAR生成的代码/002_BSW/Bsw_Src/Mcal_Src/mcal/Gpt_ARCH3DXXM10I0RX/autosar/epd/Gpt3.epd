                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:c917ab42-2aa8-40c0-bc9e-5540214b389e">
                      <SHORT-NAME>ClockDivider</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Vendor specific: Defines count value for the clock divider of clock source. Value between 0 and  and 2^24-1=16,777,215.</L-2>
                      </DESC>
                      <ORIGIN>CCFC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>1</DEFAULT-VALUE>
                      <MAX>16777215</MAX>
                      <MIN>1</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:0142b995-6a94-4171-af91-544ea37ae62e">
                      <SHORT-NAME>CLK6_Sel</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt; Vendor specific:
                                              Clock source selection for CMU_CLK_6.
                                              &lt;ul&gt;
                                                  &lt;li&gt;Unchecked - use Clock Source 6 divider. &lt;/li&gt;
                                                  &lt;li&gt;Checked - use signal SUB_INC2 of submodule DPLL. &lt;/li&gt;
                                              &lt;/ul&gt;
                                              &lt;b&gt;Valid only for CMU_CLK_6.&lt;/b&gt;
                                              &lt;/html&gt;</L-2>
                      </DESC>
                      <ORIGIN>CCFC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:a3f55f1d-4c9b-4f04-b623-02e835351a5a">
                      <SHORT-NAME>CLK7_Sel</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt; Vendor specific:
                                              Clock source selection for CMU_CLK_7.
                                              &lt;ul&gt;
                                                  &lt;li&gt;Unchecked - use Clock Source 7 divider. &lt;/li&gt;
                                                  &lt;li&gt;Checked - use signal SUB_INC1 of submodule DPLL. &lt;/li&gt;
                                              &lt;/ul&gt;
                                              &lt;b&gt;Valid only for CMU_CLK_7.&lt;/b&gt;
                                              &lt;/html&gt;</L-2>
                      </DESC>
                      <ORIGIN>CCFC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                  </PARAMETERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:9fa9c4f6-9697-4a64-a3df-9dbf721b4290">
                  <SHORT-NAME>TimeBaseUnit_CH0</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Vendor specific: Configuration of TimeBaseUnit TBU channel 0.</L-2>
                  </DESC>
                  <PARAMETERS>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:d4fe66e2-8880-4b17-add4-c7f772ea3e42">
                      <SHORT-NAME>TBU_CH0_Enable</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Vendor specific: TBU channel 0 enable/disable</L-2>
                      </DESC>
                      <ORIGIN>CCFC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:0eca43aa-7f75-4cbe-a7a2-33cdb8ab900c">
                      <SHORT-NAME>TBU_CH0_LowRes</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt; Vendor specific:
                                      TBU channel 0 low resolution enable/disable control.
                                      &lt;ul&gt;
                                          &lt;li&gt;Unchecked - TBU channel uses lower counter bits (bit 0 to 23). &lt;/li&gt;
                                          &lt;li&gt;Checked -  TBU channel uses upper counter bits (bit 3 to 26). &lt;/li&gt;
                                      &lt;/ul&gt;
                                      The two resolutions for TBU channel 0 can be used in the TIM channel 0 and the DPLL submodules.
                                      &lt;/html&gt;</L-2>
                      </DESC>
                      <ORIGIN>CCFC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
