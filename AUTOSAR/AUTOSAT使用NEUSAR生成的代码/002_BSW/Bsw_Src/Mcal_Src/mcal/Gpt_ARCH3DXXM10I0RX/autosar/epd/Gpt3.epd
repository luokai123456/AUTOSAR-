                      <SHORT-NAME>TBU_CH0_CMU_Channel_Select</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Vendor specific: Clock source for TBU channel 0 time base counter.</L-2>
                      </DESC>
                      <ORIGIN>CCFC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
