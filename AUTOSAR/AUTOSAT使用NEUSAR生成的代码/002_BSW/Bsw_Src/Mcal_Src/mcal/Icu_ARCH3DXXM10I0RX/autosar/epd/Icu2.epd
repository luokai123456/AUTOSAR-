                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>GTM_TIM1</SHORT-NAME>
                              <ORIGIN>CCFC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>GTM_TIM2</SHORT-NAME>
                              <ORIGIN>CCFC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>GTM_TIM3</SHORT-NAME>
                              <ORIGIN>CCFC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>GTM_TIM4</SHORT-NAME>
                              <ORIGIN>CCFC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>GTM_TIM5</SHORT-NAME>
                              <ORIGIN>CCFC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="453e06e9-9d4e-4352-ba11-c0fd3c34517c">
                          <SHORT-NAME>IcuGtmChannel</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Selects one of the Gtm channels available on the platform.</L-2>
                          </DESC>
                          <ORIGIN>CCFC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
