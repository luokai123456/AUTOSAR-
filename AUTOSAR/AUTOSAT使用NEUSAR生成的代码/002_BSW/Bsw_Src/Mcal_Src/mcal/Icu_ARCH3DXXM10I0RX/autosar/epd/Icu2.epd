                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>GTM_TIM_CH4</SHORT-NAME>
                              <ORIGIN>CCFC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>GTM_TIM_CH5</SHORT-NAME>
                              <ORIGIN>CCFC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>GTM_TIM_CH6</SHORT-NAME>
                              <ORIGIN>CCFC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>GTM_TIM_CH7</SHORT-NAME>
                              <ORIGIN>CCFC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="453e06e9-9d4e-4352-ba11-c0fd3c34517c">
