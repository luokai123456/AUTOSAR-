                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>DIV_2</SHORT-NAME>
                          <ORIGIN>CCFC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>DIV_3</SHORT-NAME>
                          <ORIGIN>CCFC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>DIV_4</SHORT-NAME>
                          <ORIGIN>CCFC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ecmc3f2a-0i23-41os-82db-bf121119c714">
                      <SHORT-NAME>eMIOSChannelfilter</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Input filter, selecting the minimum input pulse width that can pass through the filter.</L-2>
