                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>SDADC_INSTANCE_3</SHORT-NAME>
                          <ORIGIN>CCFC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>SDADC_INSTANCE_4</SHORT-NAME>
                          <ORIGIN>CCFC</ORIGIN>
