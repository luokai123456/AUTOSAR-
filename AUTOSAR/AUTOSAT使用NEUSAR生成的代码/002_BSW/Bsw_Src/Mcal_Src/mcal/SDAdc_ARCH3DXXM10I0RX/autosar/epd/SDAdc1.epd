                        </ECUC-FUNCTION-NAME-DEF-CONDITIONAL>
                      </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                    </ECUC-FUNCTION-NAME-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="202461b7-5ceb-4a20-24db-0eacf030601d">
                      <SHORT-NAME>SDAdcDifferenceEn</SHORT-NAME>
                      <DESC>
