                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>0</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>SDADC_STEP_DETECTION_MODE_LAST_INPUT</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>SDADC_STEP_DETECTION_MODE_LAST_INPUT</SHORT-NAME>
                          <ORIGIN>CCFC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>SDADC_STEP_DETECTION_MODE_SECOND_LAST_INPUT</SHORT-NAME>
                          <ORIGIN>CCFC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="202461b7-5ceb-4a20-24db-0eacf030616d">
                      <SHORT-NAME>SDAdcStepDetectionThreshold</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Step Detection Threshold.Defines the threshold value(magnitude) used for step detection.The threshold value is SDAdcStepDetectionThreshold*32.</L-2>
                      </DESC>
