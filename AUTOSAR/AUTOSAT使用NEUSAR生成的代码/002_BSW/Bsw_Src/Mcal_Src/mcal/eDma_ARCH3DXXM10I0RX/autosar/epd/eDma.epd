                    <ECUC-BOOLEAN-PARAM-DEF UUID="87eae519-05f6-4ec4-82f6-bea47cb71774">
                      <SHORT-NAME>ContinuouTriggerEnble</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Enables the periodic trigger capability for the DMA channel.</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>CCFC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-FUNCTION-NAME-DEF UUID="26f5fb02-3862-48fa-84bd-935e88fe6cdb">
                      <SHORT-NAME>eDmaChCallbaceFunction</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Callback function pointer for the eDMA channel. It will                                               be called at the eDMA channel complete and eDMA channel error.</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
