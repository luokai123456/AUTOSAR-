                      <a:a name="UUID" value="26f5fb02-3862-48fa-84bd-935e88fe6cd1"/>
                      <a:a name="__ORIGIN" value="Elektrobit"/>
                      <a:da name="DEFAULT" value="NULL_PTR"/>
                    </v:var>
                    <v:var name="eDmaChErrCallbackFunction" 
                          type="FUNCTION-NAME">
                      <a:a name="LABEL" value="eDmaChErrCallbackFunction"/>
                      <a:a name="DESC" 
                           value="EN:Callback function pointer for the eDMA channel. It will
                                              be eDMA channel error."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" value="26f5fb02-3862-48fa-84bd-935e88fe6cd1"/>
                      <a:a name="__ORIGIN" value="Elektrobit"/>
                      <a:da name="DEFAULT" value="NULL_PTR"/>
                      <a:da name="INVALID" type="XPath">
                      <a:tst expr="(
                                        (normalize-space(node:fallback(., '')) = 'NULL') or
                                        (normalize-space(node:fallback(., '')) = 'Null') or
                                        (normalize-space(node:fallback(., '')) = 'false') or
                                        (normalize-space(node:fallback(., '')) = 'FALSE') or
                                        (normalize-space(node:fallback(., '')) = 'null') or
                                        (normalize-space(node:fallback(., '')) = 'null_ptr') or
                                        (normalize-space(node:fallback(., '')) = 'Null_Ptr')
                                        )"
                            true="Invalid name of the, it must be a valid C function name."/>
                        <a:tst expr="(normalize-space(node:fallback(., '')) = '&quot;NULL_PTR&quot;') or
                                        (normalize-space(node:fallback(., '')) = '&quot;NULL&quot;') or
                                        (normalize-space(node:fallback(., '')) = 'NULL') or
                                        (text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$'))"
                            false="Invalid name, it must be a valid C function name"/>
                      </a:da>
                    </v:var>
                    <v:var name="eDmaChErrCallbackParam" 
                          type="FUNCTION-NAME">
