                      <a:a name="__ORIGIN" value="Elektrobit"/>
                      <a:da name="DEFAULT" value="false"/>
                    </v:var>
                    <v:var name="eDmaPreemptAbilityDisable" type="BOOLEAN">
                      <a:a name="DESC" 
                           value="EN:Channel n cannot suspend any channel, regardless of channel priority."/>
