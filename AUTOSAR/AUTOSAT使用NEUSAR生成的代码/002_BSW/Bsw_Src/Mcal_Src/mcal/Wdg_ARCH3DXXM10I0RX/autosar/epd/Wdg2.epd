                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:08f44cbd-2787-1439-4609-f43319f35643">
                      <SHORT-NAME>WdgClockValue</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">
                        &lt;html&gt;
                        Calculate ((node:ref(../WdgClkSrcRef)/WdgClockReference)/McuClockReferencePointFrequency)) divided by 1000 to obtain the data from the path.
                        &lt;/html&gt;</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>CCFC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
