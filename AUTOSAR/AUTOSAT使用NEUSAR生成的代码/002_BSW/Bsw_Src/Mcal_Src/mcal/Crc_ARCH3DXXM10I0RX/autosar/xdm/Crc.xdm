              <v:lst name="CrcSettingsConfig" type="MAP">
                <a:da name="MIN" value="0" />
                <v:ctr name="CrcSettingsConfig" type="IDENTIFIABLE">
                  <a:a name="DESC"
                    value="EN: CRC asynchronous control list configuration." />
                  <a:a name="UUID" value="d5360c68-8a3c-46aa-8bad-7e3361b583cb" />
                  <v:var name="CRCPolyomial" type="ENUMERATION">
                    <a:a name="DESC"
                      value="
                      EN: CRC polynomial configuration
                      CRC_POLYNOMIAL_8 Representative polynomial X^8+X^4+X^3+X^2+1 
                      CRC_POLYNOMIAL_16 Representative polynomial X^16+X^12+X^5+1 
                      CRC_POLYNOMIAL_32 Representative polynomial X^32+X^26+X^23+X^22+X^16+X^12+X^11+X^10+X^8+X^7+X^5+X^4+X^2+X+1." />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                      type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="7c65dbf1-97e1-45f4-a7a2-0cecf768c732" />
                    <a:da name="DEFAULT" value="CRC_POLYNOMIAL_16" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="RANGE">
                      <a:v>CRC_POLYNOMIAL_8</a:v>
                      <a:v>CRC_POLYNOMIAL_16</a:v>
                      <a:v>CRC_POLYNOMIAL_32</a:v>
                    </a:da>
                  </v:var>
                  <v:var name="crcID" type="ENUMERATION">
                    <a:a name="DESC">
                      <a:v>EN: Vendor specific:
                        Crc Default Mode
                        Default mode for watchdog driver initialization.</a:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="84b8d6e8-b59d-432c-9e27-4157e45b2cb9" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="CRC0" />
                    <a:da name="RANGE">
                      <a:v>CRC0</a:v>
                      <a:v>CRC1</a:v>
                    </a:da>
                  </v:var>
                  <v:ref name="DMAernalTriggerCounterRef" type="CHOICE-REFERENCE">
                    <a:a name="DESC">
                      <a:v>
                          <![CDATA[EN:
                          <html>
                          Vendor specific:
                          <h1>Crc External Trigger Counter</h1><p>
                          Reference to the GptChannel configuration .
                          </p></html>
                          ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                      type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>

                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="UUID" value="ECUC:9a8cd5a4-e355-d6fa-53fe-19af47067c63" />
                    <a:da name="REF">
                      <a:v>
                        ASPathDataOfSchema:/AUTOSAR/EcucDefs/eDma/eDmaConfigSet/eDmaChannelConfig</a:v>
                    </a:da>
                  </v:ref>
                   <v:var name="CrcNotification" type="FUNCTION-NAME">
                    <a:da name="TOOLTIP" value="Function pointer to callback function. The field is editable only if the switch GptEnableDisableNotificationApi is true."/>
                      <a:a name="DESC">
                          <a:v><![CDATA[EN:
                          <html>
                            Function pointer to callback function(for non-wakeup notification). The field is editable only if the switch GptEnableDisableNotificationApi is true.
                          </html>
                          ]]></a:v>
                      </a:a>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="CCFC"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" value="ECUC:2ee9c8f7-be50-43e6-ba2d-52a93e6d1439"/>
                      <a:da name="DEFAULT" value="NULL_PTR"/>
                      <a:da name="INVALID" type="XPath">
                        <a:tst expr="((.='NULL') or (.='Null') or (.='false') or (.='FALSE') or (.='null') or
                                      (.='null_ptr') or (.='Null_Ptr'))"
                                      true="Invalid name of the CrcNotification. Must be valid C function name, NULL_PTR.
                        "/>
                        <a:tst expr="normalize-space(.) = '&quot;NULL_PTR&quot;' or normalize-space(.) = 'NULL_PTR' or
                                      normalize-space(.) = '&quot;NULL&quot;' or normalize-space(.) = 'NULL' or
                                      text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$')"
                                false="Invalid name of the CrcNotification. Must be valid C function name, NULL_PTR,
                        ."/>
                      </a:da>
                    </v:var>
                </v:ctr>
              </v:lst>
              <d:ref type="REFINED_MODULE_DEF" 
                     value="ASPath:/AUTOSAR/EcucDefs/Crc"/>
            </v:ctr>
