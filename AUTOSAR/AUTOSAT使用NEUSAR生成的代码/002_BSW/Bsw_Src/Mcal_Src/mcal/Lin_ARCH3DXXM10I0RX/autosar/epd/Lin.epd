                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:dcc46433-9de4-4883-9bd4-84274be6e67e">
                      <SHORT-NAME>BreakLengthSlave</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">
                                    &lt;html&gt;
                                        Defines the break length in bits which can detect by Slave node.
                                        &lt;h1&gt;Note:&lt;/h1&gt; 
                                        This Parameter is an Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>CCFC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>BL_10</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>BL_10</SHORT-NAME>
                          <ORIGIN>CCFC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>BL_11</SHORT-NAME>
                          <ORIGIN>CCFC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:f390b04d-2cfb-42d2-9de3-feb89555fb4e">
                      <SHORT-NAME>LinResponseTimeout</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">
                                    &lt;html&gt;
                                        Response timeout value.
                                        LINTOCR[RTO] will be configured by this node.
                                        This is the response timeout duration (in bit time) for 1 byte.
                                        The reset value is 0Eh = 14, corresponding to T_Response_Maximum = 1.4 x T_Response_Nominal.
                                        &lt;h1&gt;Note:&lt;/h1&gt; 
                                        This Parameter is an Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>CCFC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>14</DEFAULT-VALUE>
                      <MAX>15</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:087f3523-f919-4b2d-841a-d18573929390">
                      <SHORT-NAME>LinHeaderTimeout</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">
                                    &lt;html&gt;
                                        Header timeout value
                                        LINTOCR[HTO] will be configured by this node.
                                        This field contains the header timeout duration (in bit time).
                                        For slave, these bits should be programmed without considering 11 bits of break.
                                        Please see sub-chapter &quot;Timeout error&quot; in Reference Manual to know how to calculate this value.
                                        &lt;h1&gt;Note:&lt;/h1&gt; 
                                        This Parameter is an Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>CCFC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>44</DEFAULT-VALUE>
                      <MAX>127</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
