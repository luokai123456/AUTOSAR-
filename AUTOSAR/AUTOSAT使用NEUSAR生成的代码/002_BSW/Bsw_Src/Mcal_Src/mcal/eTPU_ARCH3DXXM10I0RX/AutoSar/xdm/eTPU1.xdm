                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="ETPU_FILTER_CLOCK_DIV8" />
                    <a:da name="RANGE">
                      <a:v>ETPU_FILTER_CLOCK_DIV2</a:v>
                      <a:v>ETPU_FILTER_CLOCK_DIV4</a:v>
                      <a:v>ETPU_FILTER_CLOCK_DIV8</a:v>
                      <a:v>ETPU_FILTER_CLOCK_DIV16</a:v>
                      <a:v>ETPU_FILTER_CLOCK_DIV32</a:v>
                      <a:v>ETPU_FILTER_CLOCK_DIV64</a:v>
                      <a:v>ETPU_FILTER_CLOCK_DIV128</a:v>
                      <a:v>ETPU_FILTER_CLOCK_DIV256</a:v>
                    </a:da>
                  </v:var>

                  <v:var name="ETPU_CHAN_FILTER_A" type="ENUMERATION">
                    <a:a name="DESC" value="EN: Channel filter mode." />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="ETPU_CHAN_FILTER_3SAMPLE" />
                    <a:da name="RANGE">
                      <a:v>ETPU_CHAN_FILTER_2SAMPLE</a:v>
                      <a:v>ETPU_CHAN_FILTER_3SAMPLE</a:v>
                    </a:da>
                  </v:var>
                </v:ctr>
                
                <v:ctr name="engine_A_timebases" type="IDENTIFIABLE">
                  <a:a name="DESC" value="EN: Configure eTPU engine A timebases." />
                  <a:a name="UUID" value="e4a13be6-e686-4996-838a-251635c72817" />

                  <v:var name="TCR2_Clock_A" type="ENUMERATION">
                    <a:a name="DESC" value="EN: TCR2 Clock/Gate Control." />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="ETPU_TCR2CTL_DIV8" />
                    <a:da name="RANGE">
                      <a:v>ETPU_TCR2CTL_GATEDDIV8</a:v>
                      <a:v>ETPU_TCR2CTL_RISE</a:v>
                      <a:v>ETPU_TCR2CTL_FALL</a:v>
                      <a:v>ETPU_TCR2CTL_RISEFALL</a:v>
                      <a:v>ETPU_TCR2CTL_DIV8</a:v>
                    </a:da>
                  </v:var>

                  <v:var name="TCR2_Prescaler_A" type="INTEGER">
                    <a:a name="DESC" value="EN: ." />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="19" />
                    <a:tst expr="&lt;=255"/>
                    <a:tst expr="&gt;=0"/>
                  </v:var>

                  <v:var name="TCR1_Clock_A" type="ENUMERATION">
                    <a:a name="DESC" value="EN: TCR1 Clock/Gate Control." />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
