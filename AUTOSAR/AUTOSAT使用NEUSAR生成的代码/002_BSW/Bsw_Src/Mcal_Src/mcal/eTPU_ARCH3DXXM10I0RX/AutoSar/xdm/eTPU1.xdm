                          </a:a>
                          <a:a name="UUID" value="ECUC:456d6d1f-3e59-4e2c-8c84-03f647a5db62"/>
               <a:da name="INVALID" type="XPath">
                  <a:tst expr="(../../../Ebppa_Config/*/@name = @name) and (../../../ModuleList/EbppaModuleEnable = 'true') and (../../../ModuleList/QomModuleEnable = 'true')" true="QOM: QOM channel name must be unique from EBPPA channel name."/>
                  <a:tst expr="(../../../sPwm_master/*/@name = @name) and (../../../ModuleList/SpwmModuleEnable = 'true') and (../../../ModuleList/QomModuleEnable = 'true')" true="QOM: QOM channel name must be unique from SPWM_master channel name."/>
                  <a:tst expr="(../../../sPwm_master/*/sPwm_Config/*/@name = @name) and (../../../ModuleList/SpwmModuleEnable = 'true') and (../../../ModuleList/QomModuleEnable = 'true')" true="QOM: QOM channel name must be unique from SPWM_Config channel name."/>
                </a:da> 
                          <v:var name="etpuGroup" type="ENUMERATION">
