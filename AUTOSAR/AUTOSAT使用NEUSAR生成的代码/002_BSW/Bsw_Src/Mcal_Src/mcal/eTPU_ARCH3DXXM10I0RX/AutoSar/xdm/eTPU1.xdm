                              <a:v>ETPU_INSTANCE_C</a:v>
                            </a:da>
                          </v:var>

                        <v:var name="channel" type="INTEGER">
                          <a:a name="DESC" value="EN: Code RAM MISC Enable." />
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="CCFC" />
                          <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                          <a:a name="SCOPE" value="LOCAL" />
                          <a:a name="SYMBOLICNAMEVALUE" value="false" />
                          <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                          <a:a name="__ORIGIN" value="Elektrobit" />
                          <a:da name="DEFAULT" value="2" />
                          <a:da name="INVALID" type="XPath">
                                <a:tst expr="(../../../../Ebppa_Config/*[etpuGroup = node:current()/../etpuGroup and channel = node:current()]) and (../../../../ModuleList/EbppaModuleEnable = 'true') and (../../../../ModuleList/QomModuleEnable = 'true')" true="QOM: The channel configuration of QOM and EBPPA is the same"/>
                                <a:tst expr="(../../../../sPwm_master/*[etpuInstanceId = node:current()/../etpuGroup and channel = node:current()]) and (../../../../ModuleList/SpwmModuleEnable = 'true') and (../../../../ModuleList/QomModuleEnable = 'true')" true="QOM: The channel configuration of QOM and SPWM_master is the same"/>
                                <a:tst expr="(../../../../sPwm_master/*/sPwm_Config/*[etpuInstanceId = node:current()/../etpuGroup and channel = node:current()]) and (../../../../ModuleList/SpwmModuleEnable = 'true') and (../../../../ModuleList/QomModuleEnable = 'true')" true="QOM: The channel configuration of QOM and SPWM_Config is the same"/>
                                <a:tst expr="( (num:i(.)  > num:i(31) ) and (num:i(64) > num:i(.)) )" true="qom channel id must be 0-31 for ETPU_A and 64-95 for ETPU_B"/> 
                                <a:tst expr="(node:current()/../../*[etpuGroup = node:current()/../etpuGroup and channel = node:current() and @index != node:current()/../@index]) and (../../../../ModuleList/QomModuleEnable = 'true') " true="QOM: Channel id is duplicated in this configuration"/>
                          </a:da>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=95"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                        </v:var>
