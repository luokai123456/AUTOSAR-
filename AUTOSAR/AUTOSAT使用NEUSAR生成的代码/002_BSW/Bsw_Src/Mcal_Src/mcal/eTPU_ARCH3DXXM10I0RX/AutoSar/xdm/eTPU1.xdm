                <a:a name="UUID" value="e4a13be6-e686-4996-838a-251635c72817" />
               <a:da name="INVALID" type="XPath">
                  <a:tst expr="(../../QOM_Config/eTPU_QOM_Config/*/@name = @name) and (../../ModuleList/QomModuleEnable = 'true') and (../../ModuleList/EbppaModuleEnable = 'true')" true="EBPPA: Ebppa channel name must be unique from QOM channel name."/>
                  <a:tst expr="(../../sPwm_master/*/@name = @name) and (../../ModuleList/SpwmModuleEnable = 'true') and (../../ModuleList/EbppaModuleEnable = 'true')" true="EBPPA: Ebppa channel name must be unique from SPWM_master channel name."/>
                  <a:tst expr="(../../sPwm_master/*/sPwm_Config/*/@name = @name) and (../../ModuleList/SpwmModuleEnable = 'true') and (../../ModuleList/EbppaModuleEnable = 'true')" true="EBPPA: Ebppa channel name must be unique from SPWM_Config channel name."/>
                </a:da> 
                <v:var name="EbppaChannelId" type="INTEGER">
                      <a:a name="DESC" 
                           value="EN: Channel Id of the Ebppa channel. This value will be assigned to the symbolic name derived of the EbppaChannel container short name."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="CCFC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="true"/>
                      <a:a name="UUID" 
                           value="52d1bb5b-60bf-47f2-80b0-56d0427bc0a2"/>
                      <a:a name="__ORIGIN" value="Elektrobit"/>
                      <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../@index, '0')"/>
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=63"/>
                        <a:tst expr="&gt;=0"/>
                      </a:da>
                      <a:da name="RANGE" type="XPath">
                        <a:tst expr="text:uniq(node:fallback(../../*/EbppaChannelId, text:split('1 2 3')), node:fallback(., 0))" false="Channel id is duplicated in this configuration"/>
                            <a:tst expr="node:fallback(., 0) &lt; count(node:fallback(../../*, text:split('1 2 3')))" false="It can't be assigned an id higher than the number of defined channels"/>
                    </a:da>
                    </v:var>
  
                <v:var name="etpuGroup" type="ENUMERATION">
                    <a:a name="DESC" value="EN: Code RAM MISC Enable." />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="ETPU_INSTANCE_A_B" />
                    <a:da name="RANGE">
                      <a:v>ETPU_INSTANCE_A_B</a:v>
                      <a:v>ETPU_INSTANCE_C</a:v>
                    </a:da>
                  </v:var>
                
                <v:var name="channel" type="INTEGER">
                  <a:a name="DESC" value="EN: Code RAM MISC Enable." />
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="CCFC" />
                  <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                  <a:a name="SCOPE" value="LOCAL" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                  <a:a name="__ORIGIN" value="Elektrobit" />
                  <a:da name="DEFAULT" value="2" />
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=95"/>
                    <a:tst expr="&gt;=0"/>
                  </a:da>
                </v:var>

                <v:var name="priority" type="ENUMERATION">
                    <a:a name="DESC" value="EN: Filter Prescaler Clock." />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="ETPU_PRIORITY_MIDDLE" />
                    <a:da name="RANGE">
                      <a:v>ETPU_PRIORITY_MIDDLE</a:v>
                      <a:v>ETPU_PRIORITY_HIGH</a:v>
                      <a:v>ETPU_PRIORITY_LOW</a:v>
                      <a:v>ETPU_PRIORITY_DISABLE</a:v>
                      </a:da>
                  </v:var>

                  <v:var name="timebase" type="ENUMERATION">
                    <a:a name="DESC" value="EN: Filter Prescaler Clock." />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="ETPU_EBPPA_INIT_TCR1" />
                    <a:da name="RANGE">
                      <a:v>ETPU_EBPPA_INIT_TCR1</a:v>
                      <a:v>ETPU_EBPPA_INIT_TCR2</a:v>
                    </a:da>
                  </v:var>

                  <v:var name="mode" type="ENUMERATION">
                    <a:a name="DESC" value="EN: Filter Prescaler Clock." />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="ETPU_EBPPA_HIGH_PULSE" />
                    <a:da name="RANGE">
                      <a:v>ETPU_EBPPA_LOW_PULSE</a:v>
                      <a:v>ETPU_EBPPA_HIGH_PULSE</a:v>
                    </a:da>
                  </v:var>

                  <v:var name="max_count" type="INTEGER">
                    <a:a name="DESC" value="EN: Filter Prescaler Clock." />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="1" />
                    <a:tst expr="&lt;=63"/>
                    <a:tst expr="&gt;=0"/>
                  </v:var>

                  <v:var name="sample_time" type="INTEGER">
                    <a:a name="DESC" value="EN: Filter Prescaler Clock." />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="65535" />
                  </v:var>
                  <v:lst name="EbppaChannelEcucPartitionRef">
                      <v:ref name="EbppaChannelEcucPartitionRef" type="REFERENCE">
                        <a:a name="DESC">
                          <a:v>EN: Maps an Ebppa channel to zero or multiple ECUC partitions to limit the access to this channel. The ECUC partitions referenced are a subset of the ECUC partitions where the ICU driver is mapped to.</a:v>
                          <a:v>EN: Tags: atp.Status=draft</a:v>
                        </a:a>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="CCFC"/>
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="UUID" 
                             value="a235f850-b525-4634-b557-d2ca3c98271a"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="REF" 
                              value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                        <a:da name="INVALID" type="XPath">
                        <a:tst expr="node:containsValue(../../EbppaChannelEcucPartitionRef/*, node:value(.))"
                                    false="The ECUC partition referenced by EbppaChannelEcucPartitionRef shall be a subset of the ECUC partitions referenced by EbppaChannelEcucPartitionRef."/>
                        </a:da>
                      </v:ref>
                    </v:lst>
              </v:ctr>
            </v:lst>

        <!-- @implements sPwm_Config -->
            <v:lst name="sPwm_master" type="MAP">
                                  <a:da name="EDITABLE" type="XPath">
                            <a:tst expr="(../ModuleList/SpwmModuleEnable='true')"/>
                        </a:da>
              <v:ctr name="sPwm_master" type="IDENTIFIABLE">
                <a:a name="DESC" value="EN: Configure SPWM master." />
                <a:a name="UUID" value="e4a13be6-e686-4996-838a-251635c72817" />
                <a:da name="INVALID" type="XPath">
                  <a:tst expr="(../../QOM_Config/eTPU_QOM_Config/*/@name = @name) and (../../ModuleList/QomModuleEnable = 'true') and (../../ModuleList/SpwmModuleEnable = 'true')" true="SPWM_master:SPWM_master channel name must be unique from QOM channel name."/>
                  <a:tst expr="(../../Ebppa_Config/*/@name = @name) and (../../ModuleList/SpwmModuleEnable = 'true') and (../../ModuleList/EbppaModuleEnable = 'true')" true="SPWM_master: SPWM_master channel name must be unique from EBPPA channel name."/>
                  <a:tst expr="(../../sPwm_master/*/sPwm_Config/*/@name = @name) and (../../ModuleList/SpwmModuleEnable = 'true')" true="SPWM_master: SPWM_master channel name must be unique from SPWM_Config channel name."/>
                </a:da> 

                <v:var name="etpuInstanceId" type="ENUMERATION">
                    <a:a name="DESC" value="EN: Configure SPWM instanceid." />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="ETPU_INSTANCE_A_B" />
                    <a:da name="RANGE">
                      <a:v>ETPU_INSTANCE_A_B</a:v>
                      <a:v>ETPU_INSTANCE_C</a:v>
                    </a:da>
                  </v:var>
                
                <v:var name="channel" type="INTEGER">
                  <a:a name="DESC" value="EN: spwm channel." />
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="CCFC" />
                  <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                  <a:a name="SCOPE" value="LOCAL" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                  <a:a name="__ORIGIN" value="Elektrobit" />
                  <a:da name="DEFAULT" value="0" />
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=95"/>
                    <a:tst expr="&gt;=0"/>
                  </a:da>
                  <a:da name="INVALID" type="XPath">                  
                                <a:tst expr="(node:current()/../../*[etpuInstanceId = node:current()/../etpuInstanceId and channel = node:current() and @index != node:current()/../@index]) and (../../../ModuleList/SpwmModuleEnable = 'true') " true="SPWM_master: Channel id is duplicated in this configuration"/>
                        
                                <a:tst expr="(../../../QOM_Config/eTPU_QOM_Config/*[etpuGroup = node:current()/../etpuInstanceId and channel = node:current()]) and (../../../ModuleList/QomModuleEnable = 'true') and (../../../ModuleList/SpwmModuleEnable = 'true')" true="SPWM_master:The channel configuration of SPWM_master and QOM is the same"/>
                                <a:tst expr="(../../../Ebppa_Config/*[etpuGroup = node:current()/../etpuInstanceId and channel = node:current()]) and (../../../ModuleList/EbppaModuleEnable = 'true') and (../../../ModuleList/SpwmModuleEnable = 'true')" true="SPWM_master:The channel configuration of SPWM_master and EBPPA is the same"/>
                                <a:tst expr="(../../../sPwm_master/*/sPwm_Config/*[etpuInstanceId = node:current()/../etpuInstanceId and channel = node:current()]) and (../../../ModuleList/SpwmModuleEnable = 'true') " true="SPWM_master:The channel configuration of SPWM_master and SPWM_Config is the same"/>
                                </a:da>
                </v:var>
                <v:var name="freq" type="INTEGER">
                    <a:a name="DESC" value="EN: spwm The cycle range is 1Hz-100kHz, and filling in the numerical 
                    value corresponds to the corresponding cycle, without the need for conversion" />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="1000" />
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=100000" />
                      <a:tst expr="&gt;=1" />
                    </a:da>
                  </v:var>

                  <v:var name="duty" type="INTEGER">
                    <a:a name="DESC" value="EN: SPWM Duty cycle 0-10000 represents 0% -100%" />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="5000" />
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=4294967295" />
                      <a:tst expr="&gt;=0" />
                    </a:da>
                  </v:var>

                  <v:var name="timebase" type="ENUMERATION">
                    <a:a name="DESC" value="EN: spwm timebase" />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="ETPU_TCR1" />
                    <a:da name="RANGE">
                      <a:v>ETPU_TCR1</a:v>
                      <a:v>ETPU_TCR2</a:v>
                    </a:da>
                  </v:var>

                  <v:var name="timebase_freq" type="INTEGER">
                    <a:a name="DESC" value="EN: spwm timebase_freq" />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="10000000" />
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=4294967295" />
                      <a:tst expr="&gt;=0" />
                    </a:da>
                  </v:var>

                  <v:var name="reference_mode" type="ENUMERATION">
                    <a:a name="DESC" value="EN: spwm reference_mode" />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="ETPU_SPWM_IMMEDIATE" />
                    <a:da name="RANGE">
                      <a:v>ETPU_SPWM_IMMEDIATE</a:v>
                      <a:v>ETPU_SPWM_REF_IN_PRAM</a:v>
                    </a:da>
                  </v:var>

                  <v:var name="reference_ptr" type="FUNCTION-NAME">
                    <a:a name="DESC" value="EN:spwm reference_ptr" />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="NULL_PTR" />
                  </v:var>

                  <v:var name="DMA_on_falling_edge" type="ENUMERATION">
                    <a:a name="DESC" value="EN: spwm DMA_on_falling_edge" />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="ETPU_SPWM_NO_FALL_EDGE_INT_DMA" />
                    <a:da name="RANGE">
                      <a:v>ETPU_SPWM_NO_FALL_EDGE_INT_DMA</a:v>
                      <a:v>ETPU_SPWM_FALLING_EDGE_INT_DMA</a:v>
                    </a:da>
                  </v:var>
                <v:lst name="sPwmMasterChannelEcucPartitionRef">
                  <v:ref name="sPwmMasterChannelEcucPartitionRef" type="REFERENCE">
                    <a:a name="DESC">
                      <a:v>EN: Maps a sPWM channel to zero or multiple ECUC partitions to limit the access to this channe. The ECUC partitions referenced are a subset of the ECUC partitions where the sPWM driver is mapped to.</a:v>
                      <a:v>EN: Tags: atp.Status=draft</a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="ECU" />
                    <a:a name="UUID" value="8c7afa1d-6af4-4b7f-a893-02f222d7b51f" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition" />
                  </v:ref>
                </v:lst>
        
                <v:lst name="sPwm_Config" type="MAP">
                    <a:da name="MIN" value="1"/>
                    <a:da name="MAX" value="8"/>
                    <v:ctr name="sPwm_Config" type="IDENTIFIABLE">
                      <a:a name="DESC" value="EN: Configure SPWM master." />
                      <a:a name="UUID" value="e4a13be6-e686-4996-838a-251635c72817" />
                  <a:da name="INVALID" type="XPath">
                  <a:tst expr="(../../../../QOM_Config/eTPU_QOM_Config/*/@name = @name) and (../../../../ModuleList/QomModuleEnable = 'true') and (../../../../ModuleList/SpwmModuleEnable = 'true')" true="SPWM_Config: SPWM_Config channel name must be unique from QOM channel name."/>
                  <a:tst expr="(../../../../Ebppa_Config/*/@name = @name) and (../../../../ModuleList/EbppaModuleEnable = 'true') and (../../../../ModuleList/SpwmModuleEnable = 'true')" true="SPWM_Config: SPWM_Config channel name must be unique from EBPPA channel name."/>
                  <a:tst expr="(../../../../sPwm_master/*/@name = @name) and (../../../../ModuleList/SpwmModuleEnable = 'true')" true="SPWM_Config: SPWM_Config channel name must be unique from sPwm_master channel name."/>
                </a:da>      

                    <v:var name="etpuInstanceId" type="ENUMERATION">
                    <a:a name="DESC" value="EN: spwm channel etpuInstanceId" />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="ETPU_INSTANCE_A_B" />
                    <a:da name="RANGE">
                      <a:v>ETPU_INSTANCE_A_B</a:v>
                      <a:v>ETPU_INSTANCE_C</a:v>
                    </a:da>
                    <a:da name="INVALID" type="XPath">
                    <a:tst expr="(node:current() != node:current()/../../../etpuInstanceId)" true="SPWM_Config: The etpuInstanceId of sPwm_Config is inconsistent with the etpuInstanceId of sPwm_master." />
                    </a:da>
                </v:var>

                  <v:var name="channel" type="INTEGER">
                    <a:a name="DESC" value="EN:spwm channel" />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="1" />
                    <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=95"/>
                    <a:tst expr="&gt;=0"/>
                    </a:da>
                    <a:da name="INVALID" type="XPath">
                                <a:tst expr="(../../../../../QOM_Config/eTPU_QOM_Config/*[etpuGroup = node:current()/../etpuInstanceId and channel = node:current()]) and (../../../../../ModuleList/QomModuleEnable = 'true') and (../../../../../ModuleList/SpwmModuleEnable = 'true')" true="SPWM_Config: The channel configuration of SPWM_Config and QOM is the same"/>
                                <a:tst expr="(../../../../../Ebppa_Config/*[etpuGroup = node:current()/../etpuInstanceId and channel = node:current()]) and (../../../../../ModuleList/EbppaModuleEnable = 'true') and (../../../../../ModuleList/SpwmModuleEnable = 'true')" true="SPWM_Config: The channel configuration of SPWM_Config and EBPPA is the same"/>
                                <a:tst expr="(../../../../../sPwm_master/*[etpuInstanceId = node:current()/../etpuInstanceId and channel = node:current()]) and (../../../../../ModuleList/SpwmModuleEnable = 'true') " true="SPWM_Config: The channel configuration of SPWM_Config and sPwm_master is the same"/>
                                <a:tst expr="(node:current() &lt;= node:current()/../../../channel) and (../../../../../ModuleList/SpwmModuleEnable = 'true')" true="SPWM_Config: The channel number of sPwm_Config must be greater than sPwm_master's channel number." />
                                <a:tst expr="(../../../../../sPwm_master/*[etpuInstanceId = node:current()/../../../etpuInstanceId and sPwm_Config/*/channel = node:current() and channel != node:current()/../../../channel]) and (../../../../../ModuleList/SpwmModuleEnable = 'true') " true="SPWM_Config: The channel number in SPWM_Config is duplicated with another SPWM_Config under a different sPwm_master."/>
                                <a:tst expr="(node:current()/../../*[etpuInstanceId = node:current()/../etpuInstanceId and channel = node:current() and @index != node:current()/../@index]) and (../../../../../ModuleList/SpwmModuleEnable = 'true') " true="SPWM_Config: Channel id is duplicated in this configuration"/>
                    </a:da>
                  </v:var>
                  <v:var name="priority" type="ENUMERATION">
                    <a:a name="DESC" value="EN:spwm channel priority" />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="ETPU_PRIORITY_MIDDLE" />
                    <a:da name="RANGE">
                      <a:v>ETPU_PRIORITY_DISABLE</a:v>
                      <a:v>ETPU_PRIORITY_LOW</a:v>
                      <a:v>ETPU_PRIORITY_MIDDLE</a:v>
                      <a:v>ETPU_PRIORITY_HIGH</a:v>
                    </a:da>
                  </v:var>
                  <v:var name="freq" type="INTEGER">
                    <a:a name="DESC" value="EN: spwm The cycle range is 1Hz-100kHz, and filling in the numerical 
                    value corresponds to the corresponding cycle, without the need for conversion" />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="1000" />
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;100000"/>
                      <a:tst expr="&gt;1"/>
                    </a:da>
                  </v:var>

                  <v:var name="duty" type="INTEGER">
                    <a:a name="DESC" value="EN:SPWM Duty cycle 0-10000 represents 0% -100%" />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="2000" />
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=4294967295" />
                      <a:tst expr="&gt;=0" />
                    </a:da>
                  </v:var>

                  <v:var name="delay" type="INTEGER">
                    <a:a name="DESC" value="EN: spwm channel delay" />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="100" />
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=4294967295" />
                      <a:tst expr="&gt;=0" />
                    </a:da>
                  </v:var>

                  <v:var name="timebase" type="ENUMERATION">
                    <a:a name="DESC" value="EN: spwm channel timebase" />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="ETPU_TCR1" />
                    <a:da name="RANGE">
                      <a:v>ETPU_TCR1</a:v>
                      <a:v>ETPU_TCR2</a:v>
                    </a:da>
                  </v:var>

                  <v:var name="timebase_freq" type="INTEGER">
                    <a:a name="DESC" value="EN: spwm channel timebase_freq" />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="CCFC" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="53eb3161-324a-448a-97a8-f8c9d3125a4b" />
                    <a:a name="__ORIGIN" value="Elektrobit" />
                    <a:da name="DEFAULT" value="10000000" />
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=4294967295" />
                      <a:tst expr="&gt;=0" />
                    </a:da>
                  </v:var>

                  <v:lst name="sPwmSlaveChannelEcucPartitionRef">
                    <v:ref name="sPwmSlaveChannelEcucPartitionRef" type="REFERENCE">
                      <a:a name="DESC">
                        <a:v>EN: Maps a sPWM channel to zero or multiple ECUC partitions to limit the access to this channe. The ECUC partitions referenced are a subset of the ECUC partitions where the sPWM driver is mapped to.</a:v>
                        <a:v>EN: Tags: atp.Status=draft</a:v>
                      </a:a>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="CCFC" />
                      <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                      <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                      <a:a name="SCOPE" value="ECU" />
                      <a:a name="UUID" value="8c7afa1d-6af4-4b7f-a893-02f222d7b51f" />
                      <a:a name="__ORIGIN" value="Elektrobit" />
                      <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition" />
                    </v:ref>
                  </v:lst>
                  </v:ctr>
                </v:lst>
              </v:ctr>
            </v:lst>

            <v:ctr name="eTPUGeneral" type="IDENTIFIABLE">
              <a:a name="DESC" 
                  value="EN: This container contains the parameters related each sPwm Driver Unit."/>
              <a:a name="UUID" value="f72b1d09-01fa-4c63-9e70-e9908d6b7cf0"/>

              <v:var name="eTpuDevErrorDetect" type="BOOLEAN">
                <a:a name="DESC" 
                    value="EN: Switches the development error detection and notification on or off."/>
                <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                    type="IMPLEMENTATIONCONFIGCLASS">
                  <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                </a:a>
                <a:a name="ORIGIN" value="CCFC"/>
                <a:a name="SCOPE" value="LOCAL"/>
                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                <a:a name="UUID" value="07d5850d-23ed-42c3760f-5310b8f0816e"/>
                <a:a name="__ORIGIN" value="Elektrobit"/>
                <a:da name="DEFAULT" value="true"/>
              </v:var>

              <v:var name="sPwmDevErrorDetect" type="BOOLEAN">
                <a:a name="DESC" 
                    value="EN: Switches the development error detection and notification on or off."/>
                <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                    type="IMPLEMENTATIONCONFIGCLASS">
                  <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                </a:a>
                <a:a name="ORIGIN" value="CCFC"/>
                <a:a name="SCOPE" value="LOCAL"/>
                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                <a:a name="UUID" value="07d5850d-23ed-42c3-880f-5321b8f9916e"/>
                <a:a name="__ORIGIN" value="Elektrobit"/>
                <a:da name="DEFAULT" value="false"/>
              </v:var>

            <v:var name="EBPPADevErrorDetect" type="BOOLEAN">
              <a:a name="DESC" 
                   value="EN: Switches the development error detection and notification on or off."/>
              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                   type="IMPLEMENTATIONCONFIGCLASS">
                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
              </a:a>
              <a:a name="ORIGIN" value="CCFC"/>
              <a:a name="SCOPE" value="LOCAL"/>
              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
              <a:a name="UUID" value="6cf86670-38f1-4cfe-986a-a351fc59d004"/>
              <a:a name="__ORIGIN" value="Elektrobit"/>
              <a:da name="DEFAULT" value="false"/>
            </v:var>
            <v:var name="QomDevErrorDetect" type="BOOLEAN">
              <a:a name="DESC" 
                   value="EN: Switches the development error detection and notification on or off."/>
              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                   type="IMPLEMENTATIONCONFIGCLASS">
                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
              </a:a>
              <a:a name="ORIGIN" value="CCFC"/>
              <a:a name="SCOPE" value="LOCAL"/>
              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
              <a:a name="UUID" value="6cf86670-38f1-4cfe-986a-a351fc59d384"/>
              <a:a name="__ORIGIN" value="Elektrobit"/>
              <a:da name="DEFAULT" value="false"/>
            </v:var>
            
            <v:var name="EbppaMulticoreSupport" type="BOOLEAN">
                <a:a name="DESC">
                    <a:v><![CDATA[EN:
                    <html>
                        Enables/Disables Multicore Support.
                    </html>
                    ]]></a:v>
                </a:a>
                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                </a:a>
                <a:a name="ORIGIN" value="CCFC"/>
                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                <a:a name="UUID" value="ECUC:dde63254-fdc0-4af6-a0ae-3963c88e9c98"/>
                <a:da name="DEFAULT" value="false"/>
                <a:da name="INVALID" type="XPath">
                    <a:tst expr="(num:i(count(EbppaEcucPartitionRef/*)) &gt;0) and
                                 node:current()='false' "
                           true="EbppaMulticoreSupport should be enabled." />
                </a:da>
            </v:var>
              <v:var name="ETPUInlineSupport" type="BOOLEAN">
              <a:a name="DESC" 
                   value="EN: Enable or disable inline functions."/>
              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                   type="IMPLEMENTATIONCONFIGCLASS">
                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
              </a:a>
              <a:a name="ORIGIN" value="CCFC"/>
              <a:a name="SCOPE" value="LOCAL"/>
              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
              <a:a name="UUID" value="6cf86670-45f1-4cfe-916a-a351fc93d004"/>
              <a:a name="__ORIGIN" value="Elektrobit"/>
              <a:da name="DEFAULT" value="true"/>
            </v:var>

          </v:ctr>

          
            </v:ctr>
          </d:chc>
          <d:chc name="myEcuParameterDefinition" type="AR-ELEMENT" 
                 value="ECU_PARAMETER_DEFINITION">
            <d:ctr type="AR-ELEMENT">
              <a:a name="DEF" 
                   value="ASPath:/AR_PACKAGE_SCHEMA/ECU_PARAMETER_DEFINITION"/>
              <d:lst name="MODULE_REF">
                <d:ref type="MODULE_REF" value="ASPath:/eTPUConfig/ETPU"/>
              </d:lst>
            </d:ctr>
          </d:chc>
        </d:lst>
      </d:ctr>
    </d:lst>
  </d:ctr>

</datamodel>
