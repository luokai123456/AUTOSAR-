<?xml version='1.0'?>
<datamodel version="7.0" 
           xmlns="http://www.tresos.de/_projects/DataModel2/16/root.xsd" 
           xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd" 
           xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd" 
           xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">

  <d:ctr type="AUTOSAR" factory="autosar" 
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd" 
         xmlns:ce="http://www.tresos.de/_projects/DataModel2/18/childenable.xsd" 
         xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd" 
         xmlns:f="http://www.tresos.de/_projects/DataModel2/14/formulaexpr.xsd" 
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd" 
         xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd"  
         xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="DSpiConfig" type="AR-PACKAGE">
        <d:lst type="ELEMENTS">
          <d:chc name="CDD_DSpi" type="AR-ELEMENT" value="MODULE-DEF">
            <v:ctr type="MODULE-DEF">
              <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                <ad:ADMIN-DATA>
                  <ad:DOC-REVISIONS>
                    <ad:DOC-REVISION>
                      <ad:REVISION-LABEL>4.4.0</ad:REVISION-LABEL>
                      <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                    </ad:DOC-REVISION>
                  </ad:DOC-REVISIONS>
                </ad:ADMIN-DATA>
              </a:a>
              <a:a name="DESC" 
                   value="EN: This container holds the configuration of a single CDD_DSpi Driver."/>
              <a:a name="LOWER-MULTIPLICITY" value="1"/>
              <a:a name="POSTBUILDVARIANTSUPPORT" value="true"/>
              <a:a name="RELEASE" value="asc:4.4.0"/>
              <a:a name="UPPER-MULTIPLICITY" value="*"/>
              <a:a name="UUID" value="3db3850a-dd22-4180-a582-ab48f9cd3f0d"/>
              <v:var name="POST_BUILD_VARIANT_USED" type="BOOLEAN">
                <a:a name="DESC" 
                     value="Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points."/>
                <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                     type="IMPLEMENTATIONCONFIGCLASS">
                  <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                </a:a>
                <a:a name="LABEL" value="Post Build Variant Used"/>
                <a:a name="ORIGIN" value="EB"/>
                <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                <a:a name="UUID" value="d542189e-cd06-474d-891d-c1e7987132a1"/>
                <a:a name="__ORIGIN" value="Elektrobit"/>
                <a:da name="DEFAULT" value="false"/>
                <a:da name="READONLY" value="FALSE"/>
                <a:da name="TOOLTIP" 
                      value="Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points."/>
              </v:var>
              <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                     type="IMPLEMENTATIONCONFIGCLASS">
                  <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                </a:a>
                <a:a name="LABEL" value="Config Variant"/>
                <a:a name="UUID" value="cc2ff55c-7bd3-44b3-9425-c344af4abdf7"/>
                <a:a name="__ORIGIN" value="Elektrobit"/>
                <a:da name="DEFAULT" value="VariantPostBuild"/>
                <a:da name="RANGE">
                  <a:v>VariantPostBuild</a:v>
                  <a:v>VariantPreCompile</a:v>
                </a:da>
              </v:var>
              <v:ctr name="DSpiDriver" type="IDENTIFIABLE">
                <a:a name="DESC" 
                     value="EN: This container contains the configuration parameters and sub containers of the AUTOSAR CDD_DSpi module."/>
                <a:a name="UUID" value="04ba7a28-3744-4d70-b6a6-e46d960cd9d3"/>
                <v:lst name="CDD_DSpiDriver" type="MAP">
                  <a:da name="MIN" value="1"/>
                  <a:da name="INVALID" type="XPath">
                      <a:tst expr="num:i(count(node:current()/*)) &gt; ecu:get('DSpi.DriverNumMax')" 
                          true="Maximum CDD_DSpi Driver available for the selected derivative was exceeded."/>
                  </a:da>
                   <v:ctr name="CDD_DSpiDriver" type="IDENTIFIABLE">
                      <a:a name="DESC" 
                           value="EN: This container contains the configuration parameters of the CDD_DSpi controller(s)."/>
                      <a:a name="UUID" 
                           value="563bc564-a3f3-4fc8-ac4d-f042718cc65b"/>
  
  
                      <v:var name="DSpiDriverId" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: This parameter provides the controller ID which is unique in a given CDD_DSpi Driver. The value for this parameter starts with 0 and continue without any gaps."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="CCFC"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="true"/>
                        <a:a name="UUID" 
                             value="263be517-2994-4b70-b359-4ee3546081e7"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../@index,'0')"/>
                        <a:da name="INVALID" type="XPath">
                              <a:tst expr="num:i(node:current()/../@index) = num:i(.)" false="Plase enter a valid CDD_DSpiDriverId"/>
                        </a:da>
                      </v:var>
  
                      <v:var name="DSpiHwDriver" type="ENUMERATION">
                          <a:a name="DESC">
                              <a:v>
                                  <![CDATA[EN:<html>
                                      <p>Specifies which one of the on-chip spi driver interfaces is associated with this driver ID.</p>
                                      <p><h1>Note</h1>Implementation Specific parameter. Not AutoSar Required.</p>
                                  </html>]]>
                              </a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                              <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="CCFC"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:da name="DEFAULT" value="DSPI0"/>
                          <a:a name="UUID" value="ECUC:e4472b90-209f-4bbb-bd65-a7ca3b21a48d"/>
                          <a:da name="RANGE" type="XPath" expr="ecu:list('DSpi.DriverList')"/>
                          <a:da name="INVALID" type="XPath">
                            <a:tst expr="text:uniq(../../*/DSpiHwDriver,node:fallback(., 0))" false="This spi driver is already in use."/>
                          </a:da>
                      </v:var>

                      <v:var name="DSpibitsPerSec" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: Baud rate in bits per second."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="CCFC"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="263be517-2994-4b70-b359-4ee3546081e7"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="5000000"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=9223372036854775807"/>
                          <a:tst expr="&gt;=0"/>
                        </a:da>
                      </v:var>
    
                      <v:var name="dspiMode" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: SPI driver is master or slave."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="CCFC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="278cf31d-dd48-412f-b2df-50ae8c76e411"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="SPI_MASTER"/>
                        <a:da name="RANGE">
                          <a:v>SPI_MASTER</a:v>
                          <a:v>SPI_SLAVE</a:v>
                        </a:da>
                      </v:var>


                      <v:var name="pcsPolarity" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: PCS polarity in inactive state for all available PCS."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="CCFC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="278cf31d-dd48-412f-b2df-50ae8c76e413"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="SPI_INACTIVE_HIGH"/>
                        <a:da name="RANGE">
                          <a:v>SPI_INACTIVE_LOW</a:v>
                          <a:v>SPI_INACTIVE_HIGH</a:v>
                        </a:da>
                      </v:var>
    
                      <v:var name="bitcount" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: Number of bits/frame, minimum is 4 - bits , maximum = 16 - bits."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="CCFC"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="263be517-2994-4b70-b359-4ee3546081e8"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="8"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=16"/>
                          <a:tst expr="&gt;=4"/>
                        </a:da>
                      </v:var>
    
                      <v:var name="clkPhase" type="ENUMERATION">
                        <a:a name="DESC">
                             <a:v>
                                 <![CDATA[EN:<html>
                                     <p>Selects which phase of clock to capture data.</p>
                                     <p>SPI_CLOCK_PHASE_1ST_EDGE = 0U, /*! < Data captured on SCK 1st edge, changed on 2nd. */.</p>
                                     <p>SPI_CLOCK_PHASE_2ND_EDGE = 1U  /*! < Data changed on SCK 1st edge, captured on 2nd. */.</p>
                                 </html>]]>
                             </a:v>
                        </a:a>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="CCFC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="278cf31d-dd48-412f-b2df-50ae8c76e414"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="SPI_CLOCK_PHASE_2ND_EDGE"/>
                        <a:da name="RANGE">
                          <a:v>SPI_CLOCK_PHASE_1ST_EDGE</a:v>
                          <a:v>SPI_CLOCK_PHASE_2ND_EDGE</a:v>
                        </a:da>
                      </v:var>
  
                      <v:var name="clkPolarity" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: Selects clock polarity"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="CCFC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="278cf31d-dd48-412f-b2df-50ae8c76e415"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="SPI_ACTIVE_HIGH"/>
                        <a:da name="RANGE">
                          <a:v>SPI_ACTIVE_LOW</a:v>
                          <a:v>SPI_ACTIVE_HIGH</a:v>
                        </a:da>
                      </v:var>
    
                      <v:var name="isClkContinuous" type="BOOLEAN">
                        <a:a name="DESC" 
                             value="EN: Enable/disable continuous clock."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="07d5850d-23ed-42c3-880f-5310b8f9916f"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="false"/>
                      </v:var>
    
                      <v:var name="lsbFirst" type="BOOLEAN">
                        <a:a name="DESC" 
                             value="EN: Option to transmit LSB first."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="07d5850d-23ed-42c3-880f-5310b8f9916a"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="false"/>
                      </v:var>
    
                      <v:var name="transferType" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: Type of DSPI transfer"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="CCFC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="278cf31d-dd48-412f-b2df-50ae8c76e416"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="SPI_USING_INTERRUPTS"/>
                        <a:da name="RANGE">
                          <a:v>SPI_USING_POLLING</a:v>
                          <a:v>SPI_USING_INTERRUPTS</a:v>
                        </a:da>
                      </v:var>
    
                      <v:var name="dmaType" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: Type of handing DSPI TX/RX data"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="CCFC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="278cf31d-dd48-412f-b2df-50ae8c76e417"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="DSPI_DMA_NONE"/>
                        <a:da name="RANGE">
                          <a:v>DSPI_DMA_NONE</a:v>
                          <a:v>DSPI_DMA_RX_ONLY</a:v>
                          <a:v>DSPI_DMA_RX_AND_TX</a:v>
                        </a:da>
                      </v:var>
    
                      <v:var name="callback" type="FUNCTION-NAME">
                          <a:a name="DESC" 
                             value="EN: User callback function."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="CCFC"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:8051abe2-2e8d-472f-badb-b5a460f53af9"/>
                          <a:da name="DEFAULT" value="NULL_PTR"/>
                          <a:da name="INVALID" type="XPath">
                              <a:tst expr="((normalize-space(.)='NULL') or (normalize-space(.)='Null') or (normalize-space(.)='false') or (normalize-space(.)='FALSE') or (normalize-space(.)='null') or (normalize-space(.)='null_ptr') or (normalize-space(.)='Null_Ptr'))" 
                                  true="Invalid name of the callback. Must be valid C function name or NULL_PTR."/>
                              <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$')" 
                                  false="Invalid name of the callback. Must be valid C function name or NULL_PTR."/>
                          </a:da>
                      </v:var>
  
                      <v:var name="continuousPCS" type="BOOLEAN">
                        <a:a name="DESC" 
                             value="EN: Enable/disable continuous CS."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="07d5850d-23ed-42c3-880f-5310b8f9916b"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="true"/>
                      </v:var>
    
                      <v:var name="whichPCS" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: Select which CS(PCSIS0~PCSIS5) is used."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="CCFC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="278cf31d-dd48-412f-b2df-50ae8c76e418"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="PCSIS0"/>
                        <a:da name="RANGE">
                          <a:v>PCSIS0</a:v>
                          <a:v>PCSIS1</a:v>
                          <a:v>PCSIS2</a:v>
                          <a:v>PCSIS3</a:v>
                          <a:v>PCSIS4</a:v>
                          <a:v>PCSIS5</a:v>
                        </a:da>
                      </v:var>
    
                      <v:var name="Dconf" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: DSPI Configuration: 0b00 - SPI, 0b01 - DSI, 0b10 - CSI."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="CCFC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="278cf31d-dd48-412f-b2df-50ae8c76e419"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="DSPI_DSI_MODE"/>
                        <a:da name="RANGE">
                          <a:v>DSPI_DSI_MODE</a:v>
                          <a:v>DSPI_CSI_MODE</a:v>
                        </a:da>
                      </v:var>
    
                      <v:var name="TSBC" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: Timed Serial Bus Configuration 0 - disable, 1 - enable."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="CCFC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="278cf31d-dd48-412f-b2df-50ae8c76e419"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="DSPI_TSBC_DISABLE"/>
                        <a:da name="RANGE">
                          <a:v>DSPI_TSBC_DISABLE</a:v>
                          <a:v>DSPI_TSBC_ENABLE</a:v>
                        </a:da>
                      </v:var>
    
                      <v:var name="ITSBC" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: ITSBC Configuration 0 - disable, 1 - enable."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="CCFC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="278cf31d-dd48-412f-b2df-50ae8c76e41a"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="DSPI_ITSBC_DISABLE"/>
                        <a:da name="RANGE">
                          <a:v>DSPI_ITSBC_DISABLE</a:v>
                          <a:v>DSPI_ITSBC_ENABLE</a:v>
                        </a:da>
                      </v:var>
    
                      <v:var name="DsiDataSource" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: 0 - DSPI_SDR, 1 - DSPI_ASDR."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="CCFC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="278cf31d-dd48-412f-b2df-50ae8c76e41b"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="DSPI_ASDR"/>
                        <a:da name="RANGE">
                          <a:v>DSPI_ASDR</a:v>
                          <a:v>DSPI_SDR</a:v>
                        </a:da>
                      </v:var>
  
                      <v:var name="tpol" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: DSI TPOL 0 - Falling edge, 1 - Rising edge."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="CCFC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="278cf31d-dd48-412f-b2df-50ae8c76e41c"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="FALLING_EDGE"/>
                        <a:da name="RANGE">
                          <a:v>RISING_EDGE</a:v>
                          <a:v>FALLING_EDGE</a:v>
                        </a:da>
                      </v:var>
    
                      <v:var name="DSICTAx" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: Select which DSICTARs(0~7) is used."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="CCFC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="278cf31d-dd48-412f-b2df-50ae8c76e41d"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="DSICTAR0"/>
                        <a:da name="RANGE">
                          <a:v>DSICTAR0</a:v>
                          <a:v>DSICTAR1</a:v>
                          <a:v>DSICTAR2</a:v>
                          <a:v>DSICTAR3</a:v>
                          <a:v>DSICTAR4</a:v>
                          <a:v>DSICTAR5</a:v>
                          <a:v>DSICTAR6</a:v>
                          <a:v>DSICTAR7</a:v>
                        </a:da>
                      </v:var>
    
                      <v:var name="whichDSIPCS" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: Select which DSI CS(DPCS0~DPCS5) is used."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="CCFC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="278cf31d-dd48-412f-b2df-50ae8c76e41e"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="DPCS0"/>
                        <a:da name="RANGE">
                          <a:v>DPCS0</a:v>
                          <a:v>DPCS1</a:v>
                          <a:v>DPCS2</a:v>
                          <a:v>DPCS3</a:v>
                          <a:v>DPCS4</a:v>
                          <a:v>DPCS5</a:v>
                        </a:da>
                      </v:var>
    
                      <v:var name="TSBCNT" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: Timed Serial Bus operation Count. Common range 8 or 16."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="CCFC"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="263be517-2994-4b70-b359-4ee3546081e9"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="8"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=32"/>
                          <a:tst expr="&gt;=4"/>
                        </a:da>
                      </v:var>
    
                      <v:var name="SDR1En" type="BOOLEAN">
                        <a:a name="DESC" 
                             value="EN: SDR1 1 - enable 0 - disnable."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="07d5850d-23ed-42c3-880f-5310b8f9916c"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="true"/>
                      </v:var>
  
                      <v:var name="DataSelect0En" type="BOOLEAN">
                        <a:a name="DESC" 
                             value="EN: Zero bit is inserted at the middle of the data frame."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="07d5850d-23ed-42c3-880f-5310b8f9916d"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="false"/>
                      </v:var>
  
                      <v:var name="DataSelect1En" type="BOOLEAN">
                        <a:a name="DESC" 
                             value="EN: Zero bit is inserted at the beginning of the data frame."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="07d5850d-23ed-42a3-880f-531ab8f9916e"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="false"/>
                      </v:var>
  
                      <v:var name="whichTSBPCS" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: Select which the Second receiver CS(DPCS1_0~DPCS1_7) is used."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="CCFC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="278cf31d-dd48-412f-b2df-50ae8c76e41e"/>
                        <a:a name="__ORIGIN" value="Elektrobit"/>
                        <a:da name="DEFAULT" value="DPCS1_0"/>
                        <a:da name="RANGE">
                          <a:v>DPCS1_0</a:v>
                          <a:v>DPCS1_1</a:v>
                          <a:v>DPCS1_2</a:v>
                          <a:v>DPCS1_3</a:v>
                          <a:v>DPCS1_4</a:v>
                          <a:v>DPCS1_5</a:v>
                          <a:v>DPCS1_6</a:v>
                          <a:v>DPCS1_7</a:v>
                        </a:da>
                      </v:var>

                      <v:ref name="DSpiCpuClockRef" type="REFERENCE">
                      <a:a name="DESC" 
                           value="EN: Reference to the CPU clock configuration, which is set in the MCU driver configuration"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="CCFC"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="UUID" 
                           value="3f938763-90bf-4b25-b756-88de9sdac378a"/>
                      <a:a name="__ORIGIN" value="Elektrobit"/>
                      <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Mcu/McuModuleConfiguration/McuClockSettingConfig/McuClockReferencePoint"/>
                      <a:da name="INVALID" type="XPath">
                        <a:tst expr="node:refvalid(.)" false="Invalid or empty reference."/>
                      </a:da>
                    </v:ref>

                      <v:ref name="DspiControllerEcucPartitionRef"
                           type="REFERENCE">
                      <a:a name="DESC">
                        <a:v>EN: Maps the DSPI controller to zero or one ECUC partitions. The ECUC partition referenced is a subset of the ECUC partitions where the DSPI driver is mapped to.</a:v>
                        <a:v>EN: Tags: atp.Status=draft</a:v>
                      </a:a>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="UUID"
                           value="98d81f6c-3cd4-4662-bc3b-52c9d6b3508a"/>
                      <a:a name="__ORIGIN" value="Elektrobit"/>
                      <a:da name="REF"
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                    </v:ref>

                  </v:ctr>
                </v:lst>
              </v:ctr>
              <v:ctr name="DSpiGeneral" type="IDENTIFIABLE">
                <a:a name="DESC" 
                     value="EN: This container contains the parameters related each CDD_DSpi Driver Unit."/>
                <a:a name="UUID" value="f72b1d09-01fa-4c63-9e70-e9908d6b7cf0"/>
                <v:var name="CDDDSpiDevErrorDetect" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: Switches the development error detection and notification on or off."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="07d5850d-23ed-42c2-880f-5311b8f9906e"/>
                  <a:a name="__ORIGIN" value="Elektrobit"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>
                <v:var name="DSpiInlineSupport" type="BOOLEAN">
                  <a:a name="LABEL" value="DSpiInlineSupport"/>
                  <a:a name="DESC"
                        value="EN: Whether on or off INLINE Dspi be configured."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                  <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="CCFC"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:94cb0b73-61e0-a5ec-c12b-1e14bf1d4c83"/>
                  <a:da name="DEFAULT" value="true"/>
              </v:var>
              </v:ctr>
            </v:ctr>
          </d:chc>
          <d:chc name="myEcuParameterDefinition" type="AR-ELEMENT" 
                 value="ECU_PARAMETER_DEFINITION">
            <d:ctr type="AR-ELEMENT">
              <a:a name="DEF" 
                   value="ASPath:/AR_PACKAGE_SCHEMA/ECU_PARAMETER_DEFINITION"/>
              <d:lst name="MODULE_REF">
                <d:ref type="MODULE_REF" value="ASPath:/DSpiConfig/CDD_DSpi"/>
              </d:lst>
            </d:ctr>
          </d:chc>
        </d:lst>
      </d:ctr>
    </d:lst>
  </d:ctr>

</datamodel>
