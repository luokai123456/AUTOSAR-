                              <MIN>0.0</MIN>
                            </ECUC-FLOAT-PARAM-DEF>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:1f92bd14-0447-4b93-be09-9a2fa6efdeab">
                              <SHORT-NAME>McuAuxClk12Div2_En</SHORT-NAME>
