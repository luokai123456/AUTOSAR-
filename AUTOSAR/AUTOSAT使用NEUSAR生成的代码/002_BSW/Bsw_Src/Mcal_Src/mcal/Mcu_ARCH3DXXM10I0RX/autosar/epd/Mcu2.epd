                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:1a85cc4c-9f56-4366-aa18-7cceafebcf85">
                  <SHORT-NAME>McuResetConfig</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">&lt;html&gt;
                                The reset generation module (MC_RGM) centralizes the different reset sources and manages the reset sequence of the device.&lt;p/&gt;
                                Note: Implementation Specific Parameter.
                            &lt;/html&gt;</L-2>
                  </DESC>
                  <PARAMETERS>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:dff81333-5b96-44b1-bf00-01efcdebdc9a">
                      <SHORT-NAME>McuResetType</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                    This parameter selects the type of the reset to be performed through the McuPerformReset API.
                                    A &quot;destructive&quot; reset source is associated with an event related to a critical - usually hardware -
                                    error or dysfunction. When a &quot;destructive&quot; reset event occurs, the full reset sequence is applied to
                                    the device starting from PHASE0. This resets the full device ensuring a safe start-up state for both
                                    digital and analog modules.&lt;p/&gt;
                                    A &quot;functional&quot; reset source is associated with an event related to a less-critical - usually
                                    non-hardware - error or dysfunction. When a &quot;functional&quot; reset event occurs, a partial reset
                                    sequence is applied to the device starting from PHASE1. In this case, most digital modules are
                                    reset normally, while analog modules or specific digital modules (e.g. debug modules, flash
                                    modules) state is preserved.&lt;p/&gt;
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <DEFAULT-VALUE>FunctionalReset</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FunctionalReset</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>DestructiveReset</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:e7acb434-872c-43f6-a58e-d2465eda3ede">
                      <SHORT-NAME>McuFuncResetEscThreshold</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                    RGM_FRET[FRET] field configuration.&lt;p/&gt;
                                    If the value of this field is 0, the functional reset escalation function is disabled.&lt;p/&gt;
                                    Note: Implementation Specific Parameter.
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>0</DEFAULT-VALUE>
                      <MAX>15</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:bbf2146b-3926-4587-bcba-a6387e8992e2">
                      <SHORT-NAME>McuDestResetEscThreshold</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                    RGM_DRET[DRET] field configuration.&lt;p/&gt;
                                    If the value of this field is 0, the destructive reset escalation function is disabled.&lt;p/&gt;
                                    Note: Implementation Specific Parameter.
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>0</DEFAULT-VALUE>
                      <MAX>15</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                  </PARAMETERS>
                  <SUB-CONTAINERS>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:181b096f-2b1e-4e47-a084-82c91f04c36c">
                      <SHORT-NAME>McuPORST_ResetSource</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                    External Power-On Reset source configuration.&lt;p/&gt;
                                    Note: Implementation Specific Parameter.
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <PARAMETERS>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:644f1eba-0155-44ab-ba1c-97897c6465db">
                          <SHORT-NAME>McuDisableReset</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RGM_DERD[D_PORST] field configuration.&lt;p/&gt;
                                        0 - A External Power-On event triggers a reset sequence.&lt;p/&gt;
                                        1 - An external power-on reset event generates either a SAFE mode or an interrupt request
                                            depending on the values in RGM_DEAR.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:be73af9a-746c-47f2-888b-8cca321d83da">
                          <SHORT-NAME>McuEnableInterruptSafe</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RGM_DEAR[AR_PORST] field configuration.&lt;p/&gt;
                                        Alternate Request for external power-on reset.&lt;p/&gt;
                                        0 - Generate a SAFE mode request on an external power-on reset event if the reset is disabled.&lt;p/&gt;
                                        1 - Generate an interrupt request on an external power-on reset event if the reset is disabled.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:60d08bda-a444-4c33-8adc-bc823071c281">
                          <SHORT-NAME>McuResetPin</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RGM_DBRE[BE_PORST] field configuration.&lt;p/&gt;
                                        0 - ESR0 is asserted on an external power-on reset event if the reset is enabled.&lt;p/&gt;
                                        1 - Not possible to set.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:5df31479-96bc-473c-8d50-1f865ee2f946">
                      <SHORT-NAME>McuVOR_FUNC_ResetSource</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                    Voltage out of range functional Reset source configuration.&lt;p/&gt;
                                    Note: Implementation Specific Parameter.
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <PARAMETERS>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:cc9caafc-5b9a-47fd-86fc-c9afd6b73067">
                          <SHORT-NAME>McuDisableReset</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RGM_FERD[D_VOR_FUNC] field configuration.&lt;p/&gt;
                                        Disable voltage out of range functional reset.&lt;p/&gt;
                                        0 - A voltage out of range functional reset event triggers a reset sequence.&lt;p/&gt;
                                        1 - A voltage out of range functional reset event generates either a SAFE mode or an interrupt request depending on the value of RGM_FEAR.AR_VOR_FUNC.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:5127c4ed-83bd-41bf-83ac-b92165361a4d">
                          <SHORT-NAME>McuEnableInterruptSafe</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RGM_FEAR[AR_VOR_FUNC] field configuration.&lt;p/&gt;
                                        Alternate Request for voltage out of range functional reset.&lt;p/&gt;
                                        0 - Generate a SAFE mode request on a voltage out of range functional reset event if the reset is disabled.&lt;p/&gt;
                                        1 - Generate an interrupt request on a voltage out of range functional reset event if the reset is disabled.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:e8df7bf9-8af1-4421-b8bc-5edef99543f9">
                          <SHORT-NAME>McuResetPhase</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RGM_FESS[SS_VOR_FUNC] field configuration.&lt;p/&gt;
                                        Short Sequence for voltage out of range functional reset.&lt;p/&gt;
                                        0 - The reset sequence triggered by a voltage out of range functional reset event will start from PHASE1.&lt;p/&gt;
                                        1 - The reset sequence triggered by a voltage out of range functional reset event will start from PHASE3, skipping PHASE1 and PHASE2.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>PHASE_1</DEFAULT-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>PHASE_1</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>PHASE_3</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:395fc470-bb77-4879-b505-a3770ccfac62">
                          <SHORT-NAME>McuResetPin</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RGM_FBRE[BE_VOR_FUNC] field configuration.&lt;p/&gt;
                                        Bidirectional Reset Enable for voltage out of range functional reset.&lt;p/&gt;
                                        0 - ESR0 is asserted on a voltage out of range functional reset event if the reset is enabled.&lt;p/&gt;
                                        1 - ESR0 is not asserted on a voltage out of range functional reset event.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:773a2e24-c93a-4bb6-b21a-cf584bbe78f3">
                      <SHORT-NAME>McuTSR_FUNC_ResetSource</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                    Temperature sensor functional reset.&lt;p/&gt;
                                    Note: Implementation Specific Parameter.
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <PARAMETERS>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:27a2b459-0807-4c5c-a188-7ebb2d4bd52c">
                          <SHORT-NAME>McuDisableReset</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RGM_FERD[D_TSR_FUNC] field register value. &lt;p/&gt;
                                        Disable temperature sensor functional reset.&lt;p/&gt;
                                        0 - A temperature sensor functional reset event triggers a reset sequence.&lt;p/&gt;
                                        1 - A temperature sensor functional reset event generates either a SAFE mode or an interrupt request depending on the value of RGM_FEAR.AR_JTAG_FUNC.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:e7ab7606-c325-4a3c-9269-fac8e558fbf4">
                          <SHORT-NAME>McuEnableInterruptSafe</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RGM_FEAR[AR_TSR_FUNC] field register value.&lt;p/&gt;
                                        Alternate Request for temperature sensor functional reset.&lt;p/&gt;
                                        0 - Generate a SAFE mode request on a temperature sensor functional reset event if the reset is disabled.&lt;p/&gt;
                                        1 - Generate an interrupt request on a temperature sensor functional reset event if the reset is disabled.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:fabd5811-2401-41ce-862d-808b7d39c5a6">
                          <SHORT-NAME>McuResetPhase</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RGM_FESS[SS_TSR_FUNC] field register value.&lt;p/&gt;
                                        Short Sequence for temperature sensor functional reset.&lt;p/&gt;
                                        0 - The reset sequence triggered by a temperature sensor functional reset event will start from PHASE1.&lt;p/&gt;
                                        1 - The reset sequence triggered by a temperature sensor functional reset event will start from PHASE3, skipping PHASE1 and PHASE2.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>PHASE_1</DEFAULT-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>PHASE_1</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>PHASE_3</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:99d57273-7a20-4365-b08b-39b988ea094b">
                          <SHORT-NAME>McuResetPin</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RGM_FBRE[BE_TSR_FUNC] field register value.&lt;p/&gt;
                                        Bidirectional Reset Enable for temperature sensor functional reset.&lt;p/&gt;
                                        0 - ESR0 is asserted on a temperature sensor functional reset event if the reset is enabled.&lt;p/&gt;
                                        1 - ESR0 is not asserted on a temperature sensor functional reset event.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
