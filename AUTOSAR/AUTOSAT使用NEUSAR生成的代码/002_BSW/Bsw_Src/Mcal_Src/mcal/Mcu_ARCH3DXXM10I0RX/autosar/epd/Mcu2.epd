                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:8b2c2db5-9628-4922-b656-178ef63ffb6d">
                              <SHORT-NAME>McuFEE9_PMC_H</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            FEE_VD9[PMC_H] field register value.&lt;p/&gt;
                                            This bit defines whether an HVD assertion on the supply of the PMC generates an FCCU event.&lt;p/&gt;
                                            0 - Disabled. HVD assertion on the supply of the PMC does not cause an FCCU event.&lt;p/&gt;
                                            1 - Enabled. HVD assertion on the supply of the PMC causes an FCCU event.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
