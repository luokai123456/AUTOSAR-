                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:1e7fb351-a25a-4169-a1f1-c30a391777f8">
                          <SHORT-NAME>FaultDisabled</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                    Fault source disabled
                                    &lt;ul&gt;
                                    &lt;li&gt;Unchecked: Specified non-critical fault source is enabled (default).&lt;/li&gt;
                                    &lt;li&gt;Checked: Specified non-critical fault source is disabled.&lt;/li&gt;
                                    &lt;/ul&gt;
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:51dce42e-156c-4baa-9f55-6b8bf350eff5">
                          <SHORT-NAME>RecoveryType</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                    Non-critical fault configuration
                                    &lt;ul&gt;
                                    &lt;li&gt;HW recoverable fault&lt;/li&gt;
                                    &lt;li&gt;SW recoverable fault&lt;/li&gt;
                                    &lt;/ul&gt;
                                    &lt;p&gt;&lt;/p&gt;The non-critical fault configuration defines the fault recovery mode.
                                    &lt;p&gt;&lt;/p&gt;HW recoverable faults are self recovered (status flag clearing and related) if the root cause (input fault)has been removed.
                                    &lt;p&gt;&lt;/p&gt;SW recoverable faults are recovered (status flag clearing) by SW clearing of the related status flag.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>SwRecoverableFault</DEFAULT-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>SwRecoverableFault</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>HwRecoverableFault</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:d1fec224-156c-481d-8fc1-ac559f77edc6">
                          <SHORT-NAME>ReactionType</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                    Non-critical fault state configuration
                                    &lt;ul&gt;
                                    &lt;li&gt; Short functional reset request pulse (FAULT state Mcu_FccuRfReactionEnCfg)&lt;/li&gt;
                                    &lt;li&gt; Long functional reset request pulse (FAULT state Mcu_FccuRfReactionEnCfg)&lt;/li&gt;
                                    &lt;li&gt; No reset Mcu_FccuRfReactionEnCfg &lt;/li&gt;
                                    &lt;/ul&gt;
                                    &lt;!--/** Workaround Errata e7429 */ --!&gt;
                                    &lt;p&gt;Note:&lt;/p&gt;
                                    Due to hardware limitations then:
                                    &lt;ul&gt;
                                    &lt;li&gt;Reset Reaction of all Faults default is No Reset Reaction. &lt;/li&gt;
                                    &lt;li&gt;User can change this configuration for each Fault in Fault tab. &lt;/li&gt;
                                    &lt;li&gt;With Fault Fccu_FCCU_FLASH_INIT allways configured is No Reset Reaction.&lt;/li&gt;
                                    &lt;/ul&gt;
                                    &lt;!--/** End Workaround Errata e7429 */ --!&gt;
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>NoResetReaction</DEFAULT-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>ShortResetReaction</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>LongResetReaction</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>NoResetReaction</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:789e1d41-156c-458f-b9cc-2f433d73c11e">
                          <SHORT-NAME>RecoveryTimeOutEnabled</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                    Fault time-out enable
                                    &lt;ul&gt;
                                    &lt;li&gt;Unchecked: FCCU moves into the FAULT state if the respective fault is enabled&lt;/li&gt;
                                    &lt;li&gt;Checked: FCCU moves into the ALARM state if the respective fault is enabled&lt;/li&gt;
                                    &lt;/ul&gt;
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:61000e3f-156c-4bb1-9a1d-4549f0c93299">
                          <SHORT-NAME>AlarmIrqEnabled</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                    IRQ alarm enable
                                    &lt;ul&gt;
                                    &lt;li&gt;Unchecked: Alarm is disabled for the configured error source.&lt;/li&gt;
                                    &lt;li&gt;Checked: Alarm is enabled for the configured error source. &lt;/li&gt;
                                    &lt;/ul&gt;
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:9a901a2f-156c-4366-9720-ed4596ca730a">
                          <SHORT-NAME>FaultNmiEnabled</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                    NMI enable
                                    &lt;ul&gt;
                                    &lt;li&gt;Unchecked: NMI is disabled for error (NCF/) source x.&lt;/li&gt;
                                    &lt;li&gt;Checked: NMI is enabled for error (NCF/) source x. &lt;/li&gt;
                                    &lt;/ul&gt;
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:573d22a8-156c-455c-bff4-b6cca35ac3d9">
                          <SHORT-NAME>ActivateOutputPins</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                    EOUT signaling enable
                                    &lt;ul&gt;
                                    &lt;li&gt;Unchecked:EOUT signaling is disabled for error (NCF/) source x. Error pins are as if in non-faulty state.&lt;/li&gt;
                                    &lt;li&gt;Checked: EOUT signaling is enabled for error (NCF/) source x. &lt;/li&gt;
                                    &lt;/ul&gt;
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                  </SUB-CONTAINERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
              </SUB-CONTAINERS>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="6f6e0741-7882-4584-8db2-ac77ee8979f4">
              <SHORT-NAME>McuPublishedInformation</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Container holding all MCU specific published information parameters</L-2>
              </DESC>
              <SUB-CONTAINERS>
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:81f293a4-5620-4b5e-a67c-83a2b884f521">
                  <SHORT-NAME>McuResetReasonConf</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">&lt;html&gt;
                                    This container contains the configuration for the different type of reset reason that can be retrieved from Mcu_GetResetReason Api. &lt;p/&gt;
                                &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>255</UPPER-MULTIPLICITY>
                  <PARAMETERS>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:20558435-58b9-4050-8eba-6da5fa016a34">
                      <SHORT-NAME>McuResetReason</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">
                                &lt;html&gt;
                                The parameter represents the different type of reset that a Micro supports. This parameter is referenced by the parameter EcuMResetReason in the ECU State manager module.
                                &lt;p/&gt; &lt;/html&gt;</L-2>
                      </DESC>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PUBLISHED-INFORMATION</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PUBLISHED-INFORMATION</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>true</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>0</DEFAULT-VALUE>
                      <MAX>255</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                  </PARAMETERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
              </SUB-CONTAINERS>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
