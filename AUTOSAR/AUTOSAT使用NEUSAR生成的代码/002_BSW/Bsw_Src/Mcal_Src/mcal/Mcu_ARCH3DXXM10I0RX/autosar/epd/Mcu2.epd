                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:15a219b0-23f8-4781-b935-6264e45f1acc">
                              <SHORT-NAME>McuAuxClk12Div2_Divisor</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            Set Aux12 Divider 2 Division value.&lt;p/&gt;
                                            Set the CGM_AC12_DC2[DIV] field register with value (McuAuxClk12Div2_Divisor - 1).&lt;p/&gt;
                                            The resultant motor control clock will have a period (CGM_AC12_DC2[DIV] + 1) times that of auxiliary clock 0.&lt;p/&gt;
