                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="81bd839b-08db-45c1-adc1-e604c1994a8e">
                  <SHORT-NAME>McuClockSettingConfig</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">This container contains the configuration (parameters) for the Clock settings of the MCU.  Please see MCU031 for more information on the MCU clock settings.</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY-INFINITE>1</UPPER-MULTIPLICITY-INFINITE>
                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                  <PARAMETERS>
                    <ECUC-INTEGER-PARAM-DEF UUID="48fc8c95-e774-406c-b003-68ce22bad96e">
                      <SHORT-NAME>McuClockSettingId</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">The Id of this McuClockSettingConfig to be used as argument for the API call &quot;Mcu_InitClock&quot;.</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>true</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>0</DEFAULT-VALUE>
                      <MAX>255</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:ff72d8f6-503d-4501-b816-f9e41467ae74">
                      <SHORT-NAME>McuClkSetIRC_En</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                  0 - IRC is disabled in this mode.&lt;p/&gt;
                                  1 - IRC is enabled in this mode and can be used as a clock source.&lt;p/&gt;
                                  Note: Implementation Specific Parameter.
                              &lt;/html&gt;</L-2>
                      </DESC>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>true</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:ff72d8f6-503d-4501-b816-f9e41467ae74">
                      <SHORT-NAME>McuClkSetXOSC_En</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                  0 - XOSC is disabled in this mode.&lt;p/&gt;
                                  1 - XOSC is enabled in this mode and can be used as a clock source.&lt;p/&gt;
                                  Note: Implementation Specific Parameter.
                              &lt;/html&gt;</L-2>
                      </DESC>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>true</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:a7966e6b-56e0-4d45-a177-15d6e91234df">
                      <SHORT-NAME>McuClkSetPLL0_En</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                  0 - PLL0 is disabled in this mode.&lt;p/&gt;
                                  1 - PLL0 is enabled in this mode and can be used as a clock source.&lt;p/&gt;
                                  Note: Implementation Specific Parameter.
                              &lt;/html&gt;</L-2>
                      </DESC>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>true</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:9b1009b6-b73e-412f-b44c-fdb9013142cc">
                      <SHORT-NAME>McuClkSetPLL1_En</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                  0 - PLL1 is disabled in this mode.&lt;p/&gt;
                                  1 - PLL1 is enabled in this mode and can be used as a clock source.&lt;p/&gt;
                                  Note: Implementation Specific Parameter.
                              &lt;/html&gt;</L-2>
                      </DESC>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:3e46df92-9255-4a0d-8f08-3ae52ab0cc06">
                      <SHORT-NAME>McuSystemClockSwitch</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                    System Clock Select. Configure the ME_mode_MC[SYSCLK] register field.&lt;p/&gt;
                                    The system clock is either:&lt;p/&gt;
                                    - Internal 16Mhz oscillator IRC (ME_mode_MC[SYSCLK]=0)&lt;p/&gt;
                                    - External oscillator XOSC (ME_mode_MC[SYSCLK]=1)&lt;p/&gt;
                                    - Primary PLL (PHI) (ME_mode_MC[SYSCLK]=2)&lt;p/&gt;
                                    - Secondary PLL (ME_mode_MC[SYSCLK]=4)&lt;p/&gt;
                                    The below extra conditions are set automatically when the clock select is updated (not need to enable these clocks separetelly by the user):&lt;p/&gt;
                                        - If the 4-40 MHz crystal osc. clock is selected as the system clock, XOSC must be on (set by default in the function).&lt;p/&gt;
                                        - If the system PLL clock is selected as the system clock, PLL0 must be on (set by default in the function).&lt;p/&gt;
                                        - If PLL0 is on, XOSC must also be on (set by default in the function).&lt;p/&gt;
                                        - If PLL1 is on, XOSC must also be on (set by default in the function).&lt;p/&gt;
                                    Note: Implementation Specific Parameter.
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>IRC</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>IRC</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>XOSC</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>PLL0_PHI</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>PLL1_PHI</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:4b3c9620-6b92-40a0-8811-d93d1711c93c">
                      <SHORT-NAME>McuSystemClockFrequency</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                  This is the frequency for the specific instance of the &quot;McuClockReferencePoint&quot; container.&lt;p/&gt;
                                  Value calculated for user info. It is given in Hz.&lt;p/&gt;
                                  Note: Implementation Specific Parameter.
                              &lt;/html&gt;</L-2>
                      </DESC>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>6.0E8</DEFAULT-VALUE>
                      <MAX>8.0E8</MAX>
                      <MIN>4000000.0</MIN>
                    </ECUC-FLOAT-PARAM-DEF>
                  </PARAMETERS>
                  <REFERENCES>
                    <ECUC-REFERENCE-DEF UUID="ECUC:080359ed-ba07-4780-ba20-1cb663e4d509">
                      <SHORT-NAME>PeripheralConfig</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                    Select the peripheral configuration at the current clock.
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <REQUIRES-SYMBOLIC-NAME-VALUE>true</REQUIRES-SYMBOLIC-NAME-VALUE>
                      <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/McuConfig/Mcu/McuModuleConfiguration/McuPeripheralConfig</DESTINATION-REF>
                    </ECUC-REFERENCE-DEF>
                  </REFERENCES>
                  <SUB-CONTAINERS>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:65e42bcc-a9f3-4c04-b90c-289575b461bc">
                      <SHORT-NAME>McuIRC</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                  This container contains the specific configuration of the Internal 16MHz Oscillator configuration.&lt;p/&gt;
                                  Note: Implementation specific Container.
                              &lt;/html&gt;</L-2>
                      </DESC>
                      <PARAMETERS>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:71ab5bcf-4977-4914-96ab-7fc166f26e96">
                          <SHORT-NAME>McuFIRC_Frequency</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                    Clock value selected by IRC.&lt;p/&gt;
                                    Note: Implementation Specific Parameter.
                                &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>16000000</DEFAULT-VALUE>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:bca9b6be-e00b-4d93-8ee5-281474926f9f">
                          <SHORT-NAME>McuFIRC_Trim</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                      User trimming bits with respect to nominal factory frequency.&lt;p/&gt;
                                      The MSB of the USER_TRIM bits is used to determine whether the frequency will be increased or decreased.&lt;p/&gt;
                                      If MSB = 0 then a change in USER_TRIM[3:0] will decrease the frequency, and likewise, if MSB = 1 then a change in USER_TRIM[3:0] will increase the frequency.&lt;p/&gt;
                                      Frequency trimming calculation shows how RCOSC_CTL[USER_TRIM] field is used to trim the IRCOSC frequency.&lt;p/&gt;
                                  &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>0</DEFAULT-VALUE>
                          <MAX>31</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:ff72d8f6-503d-4501-b816-f9e41467ae74">
                          <SHORT-NAME>McuFIRC_OffInStandby</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                    FIRC control in STANDBY mode. &lt;p/&gt;
                                    0 FIRC is switched on in STANDBY mode. &lt;p/&gt;
                                    1 FIRC is switched off in STANDBY mode. &lt;p/&gt;
                                &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:bca9b6be-e00b-4d93-8ee5-281474926f88">
                          <SHORT-NAME>McuFIRC_Div</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                      This field specifies the FIRC oscillator output clock division factor. The output clock is divided by the factor FIRCDIV+1. &lt;p/&gt;
                                  &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>0</DEFAULT-VALUE>
                          <MAX>63</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:ff72d8f6-503d-4501-b816-f9e41467ae73">
                          <SHORT-NAME>McuSIRC_En</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                    SIRC control 
                                    1 - SIRC is switched on.&lt;p/&gt;
                                    0 - SIRC is switched off.&lt;p/&gt;
                                    Note: Implementation Specific Parameter.
                                &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:bca9b6be-e00b-4d93-8ee5-281474926f89">
                          <SHORT-NAME>McuSIRC_Div</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                      This field specifies the SIRC oscillator output clock division factor. The output clock is divided by the factor SIRCDIV+1. &lt;p/&gt;
                                  &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>0</DEFAULT-VALUE>
                          <MAX>63</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:837b8956-c0f4-4719-8192-419f9e48d2bc">
                      <SHORT-NAME>McuXOSC</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                  This container contains the specific configuration of the MCU XOSC (External Oscillator) configuration.&lt;p/&gt;
                                  Note: Implementation Specific Container.
                              &lt;/html&gt;</L-2>
                      </DESC>
                      <PARAMETERS>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:eed49f44-7bf4-47e4-88ba-73c956509f35">
                          <SHORT-NAME>McuXoscByPass</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                      External Crystal Oscillator bypass.&lt;p/&gt;
                                      0 - Oscillator output is used as root clock.&lt;p/&gt;
                                      1 - XTALOUT is used as root clock.&lt;p/&gt;
                                      Configure the OSC_CTL[OSCBYP] field.&lt;p/&gt;
                                      User can write a value of &apos;1&apos; to it. Writing a &apos;0&apos; has no effect. A reset will also clear this bit.&lt;p/&gt;
                                      Note: Implementation Specific Parameter.
                                  &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:e4190259-c246-480b-a963-6ba925876643">
                          <SHORT-NAME>McuXoscCounter</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                      When the internal counter reaches the value the oscillator is stable.&lt;p/&gt;
                                      These bits specify the end of count value to be used for comparison by the
                                      oscillator stabilization counter OSCCNT after reset or whenever it is switched on from the off state.
                                      Configure the OSC_CTL[EOCV] field.&lt;p/&gt;
                                      Note: Implementation Specific Parameter.
                                  &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>100</DEFAULT-VALUE>
                          <MAX>255</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:a0ee3bdc-00f7-492b-b86f-1a273b643577">
                      <SHORT-NAME>McuPll_0</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                  This container provides the specific configuration for the PLL0.&lt;p/&gt;
                                  The PLL can be switched off when not required to achieve lower consumption by programming the
                                      ME_x_MC registers in the MC_ME module.&lt;p/&gt;
                                  Note: Implementation Specific Container.
                              &lt;/html&gt;</L-2>
                      </DESC>
                      <SUB-CONTAINERS>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:7ce3e465-02c8-49b1-89d1-02a8f6611631">
                          <SHORT-NAME>McuPll0_Parameter</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                      General configuration for PLL0 IP.&lt;p/&gt;
                                      Note: Implementation Specific Parameter.
                                  &lt;/html&gt;</L-2>
                          </DESC>
                          <PARAMETERS>
                            <ECUC-FLOAT-PARAM-DEF UUID="ECUC:972f8d21-f2d0-4acc-a248-a4fd9312aec8">
                              <SHORT-NAME>PLL0_PHI_Frequency</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                          Output value for &lt;strong&gt;PLL0_PHI&lt;/strong&gt;.&lt;p/&gt;
                                          The valid range is [4.762 ... 400] MHz.&lt;p/&gt;
                                          PLL_0_PHI_Frequency = &lt;p/&gt;
                                          &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(McuAuxClk3_Frequency * McuLoopMultiplicationClkDivider) / &lt;p/&gt;
                                          &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(McuInputClkPreDivider * McuPHI_ReducedFreqDivider)&lt;p/&gt;&lt;p/&gt;
                                          Note: Implementation Specific Parameter.
                                      &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>3.0E8</DEFAULT-VALUE>
                              <MAX>4.0E8</MAX>
                              <MIN>4762000.0</MIN>
                            </ECUC-FLOAT-PARAM-DEF>
                            <ECUC-FLOAT-PARAM-DEF UUID="ECUC:2ca040aa-fc34-4478-90e6-6246a10f9591">
                              <SHORT-NAME>PLL0_PHI1_Frequency</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                          Output value for &lt;strong&gt;PLL0_PHI1&lt;/strong&gt;.&lt;p/&gt;
                                          The valid range is [38 ... 78] MHz.&lt;p/&gt;
                                          PLL_0_PHI1_Frequency = &lt;p/&gt;
                                          &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(McuAuxClk3_Frequency * McuLoopMultiplicationClkDivider) / &lt;p/&gt;
                                          &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(McuInputClkPreDivider * McuPHI1_ReducedFreqDivider)&lt;p/&gt;&lt;p/&gt;
                                          Note: Implementation Specific Parameter.
                                      &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>5.0E7</DEFAULT-VALUE>
                              <MAX>7.8E7</MAX>
                              <MIN>2.0E7</MIN>
                            </ECUC-FLOAT-PARAM-DEF>
                            <ECUC-FLOAT-PARAM-DEF UUID="ECUC:0068a430-ea7e-4ee6-9b54-62be9e11e3a0">
                              <SHORT-NAME>PLL0_VCO_Frequency</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                          Voltage Controlled Oscillator Frequency.&lt;p/&gt;
                                          PLL0_VCO_Frequency = &lt;p/&gt;
                                          &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(2 * McuAuxClk3_Frequency * McuLoopMultiplicationClkDivider) / &lt;p/&gt;
                                          &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(McuInputClkPreDivider)&lt;p/&gt;&lt;p/&gt;
                                          Note: Implementation Specific Parameter.
                                      &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>6.0E8</DEFAULT-VALUE>
                              <MAX>1.25E9</MAX>
                              <MIN>4.0E8</MIN>
                            </ECUC-FLOAT-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:c9779a24-0834-41fd-9d16-a9de2cc6e604">
                              <SHORT-NAME>McuInputClkPreDivider</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                          Set PLL0 Input Clock Pre-Divider.&lt;p/&gt;
                                          Set the PLL0: PLL0DV[PREDIV] field register.&lt;p/&gt;
                                          Note: Implementation Specific Parameter.&lt;p/&gt;
                                      &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>4</DEFAULT-VALUE>
                              <MAX>7</MAX>
                              <MIN>1</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:063224c6-dc43-4025-bd30-e424471cf11a">
                              <SHORT-NAME>McuPHI_ReducedFreqDivider</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                          Set PLL0 PHI reduced frequency divider.&lt;p/&gt;
                                          Set the PLL0: PLL0DV[RFDPHI] field register.&lt;p/&gt;
                                          Valid values are 1..63.&lt;p/&gt;
                                          Note: Implementation Specific Parameter.
                                      &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>8</DEFAULT-VALUE>
                              <MAX>63</MAX>
                              <MIN>1</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:f3e7e411-abde-4776-8fbf-8279c7a1b422">
                              <SHORT-NAME>McuPHI1_ReducedFreqDivider</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                          Set PLL0 PHI reduced frequency divider.&lt;p/&gt;
                                          Set the PLL0: PLL0DV[RFDPHI1] field register.&lt;p/&gt;
                                          Valid values are 4..15.&lt;p/&gt;
                                          Note: Implementation Specific Parameter.&lt;p/&gt;
                                      &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>5</DEFAULT-VALUE>
                              <MAX>15</MAX>
                              <MIN>4</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:1fe3b2d6-8702-41d8-97f8-71f26b3b0cdf">
                              <SHORT-NAME>McuLoopMultiplicationClkDivider</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                          Set PLL0 Loop Multiplication Factor divider.&lt;p/&gt;
                                          Set the PLL0: PLL0DV[MFD] field register.&lt;p/&gt;
                                          Valid range is in [8..127].&lt;p/&gt;
                                          Note: Implementation Specific Parameter.
                                      &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>80</DEFAULT-VALUE>
                              <MAX>127</MAX>
                              <MIN>8</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:35201878-3f07-4ffa-84ac-4c3fba61be56">
                              <SHORT-NAME>McuExternalPowerDownCycleInt</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                          External Power Down cycle Complete indication interrupt enable.&lt;p/&gt;
                                          Configure the PLL0CR[EXPDIE] bit.&lt;p/&gt;
                                          0 - Interrupt disabled.&lt;p/&gt;
                                          1 - Interrupt enabled.&lt;p/&gt;
                                          Note: Implementation Specific Parameter.
                                      &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:919346a1-ffd7-4595-92e5-249edb41f81c">
                              <SHORT-NAME>McuLossOfLockInt</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                          Loss-of-clock interrupt request.&lt;p/&gt;
                                          Set the PLL0: PLL0CR[LOLIE] field register.&lt;p/&gt;
                                          0 - Ignore loss of lock. Interrupt not requested.&lt;p/&gt;
                                          1 - Enable interrupt request upon loss of lock.&lt;p/&gt;
                                          Note: Implementation Specific Parameter.
                                      &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                          </PARAMETERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                      </SUB-CONTAINERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:57573a94-88e2-4a4c-9bab-f86d15fe405a">
                      <SHORT-NAME>McuPll_1</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                    This container provides the specific configuration for the PLL1.&lt;p/&gt;
                                    The FMPLL can be switched off when not required to achieve lower consumption by programming the
                                        ME_x_MC registers in the MC_ME module.&lt;p/&gt;
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <SUB-CONTAINERS>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:d4f22905-830d-4763-b280-fb9904c3001d">
                          <SHORT-NAME>McuPll1_Parameter</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        General configuration for PLL1 IP.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <PARAMETERS>
                            <ECUC-FLOAT-PARAM-DEF UUID="ECUC:93f368a5-9288-472f-bcc1-f490b52287c0">
                              <SHORT-NAME>PLL1_PHI_Frequency</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            Clock value for PLL1_PHI.&lt;p/&gt;
                                            The valid range is [4.762 ... 625] MHz.&lt;p/&gt;
                                            PLL1_PHI_Frequency = &lt;p/&gt;
                                            &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(McuAuxClk4_Frequency * (McuLoopMultiplicationClkDivider + (McuFractionalDivider / 4096))) / &lt;p/&gt;
                                            &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(2 * McuPHI_ReducedFreqDivider)&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>6.0E8</DEFAULT-VALUE>
                              <MAX>8.0E8</MAX>
                              <MIN>4762000.0</MIN>
                            </ECUC-FLOAT-PARAM-DEF>
                            <ECUC-FLOAT-PARAM-DEF UUID="ECUC:8876a224-0f2c-4e63-b7fd-20be83840b37">
                              <SHORT-NAME>PLL1_VCO_Frequency</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            Voltage Controlled Oscillator Frequency.&lt;p/&gt;
                                            PLL1_VCO_Frequency = McuAuxClk4_Frequency *  (McuLoopMultiplicationClkDivider + (McuFractionalDivider / 4096)).&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>1.2E9</DEFAULT-VALUE>
                              <MAX>1.25E9</MAX>
                              <MIN>4.0E8</MIN>
                            </ECUC-FLOAT-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:103454f6-b26d-4841-9d1c-5e21e584a39b">
                              <SHORT-NAME>McuPHI_ReducedFreqDivider</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            Set PLL1 PHI reduced frequency divider.&lt;p/&gt;
                                            Set the PLL1: PLL1DV[RFDPHI] field register.&lt;p/&gt;
                                            Valid values are 1..63.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>4</DEFAULT-VALUE>
                              <MAX>63</MAX>
                              <MIN>0</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:ec2dfe88-4dab-4dd4-833a-82bdbd0bc204">
                              <SHORT-NAME>McuLoopMultiplicationClkDivider</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            Set PLL1 Loop Multiplication Factor divider.&lt;p/&gt;
                                            Set the PLL1: PLL0DV[MFD] field register.&lt;p/&gt;
                                            Valid range is in [16..34].&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>16</DEFAULT-VALUE>
                              <MAX>127</MAX>
                              <MIN>16</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:8971db37-1563-437e-9286-01a134e236aa">
                              <SHORT-NAME>McuExternalPowerDownCycleInt</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            External Power Down cycle Complete indication interrupt enable.&lt;p/&gt;
                                            Configure the PLL1CR[EXPDIE] bit.&lt;p/&gt;
                                            0 - Interrupt disabled.&lt;p/&gt;
                                            1 - Interrupt enabled.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:f413b1a2-8f94-409d-8b19-21a7892e80e8">
                              <SHORT-NAME>McuLossOfLockInt</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            Loss of lock interrupt enable.&lt;p/&gt;
                                            Set the PLL1: PLL1CR[LOLIE] field register.&lt;p/&gt;
                                            0 - Interrupt disabled.&lt;p/&gt;
                                            1 - Interrupt enabled.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:7aa5576a-9b38-475b-bc3c-28ef9161861f">
                              <SHORT-NAME>McuModulationEnable</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            Modulation Enable.&lt;p/&gt;
                                            Set the PLL1: PLL1FM[MODEN] field register.&lt;p/&gt;
                                            0 - Frequency modulation disabled.&lt;p/&gt;
                                            1 - Frequency modulation enabled.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:f29c1af0-c1a1-4464-8753-bbb69a83143f">
                              <SHORT-NAME>McuFracDivEnable</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            Fractional Divide Enable.&lt;p/&gt;
                                            Set the PLL1: PLL1FD[FDEN] field register.&lt;p/&gt;
                                            0 - Fractional divide disabled.&lt;p/&gt;
                                            1 - Fractional divide enabled.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                          </PARAMETERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:dc3a49bc-fe70-487e-a13c-bfe85b922cec">
                          <SHORT-NAME>McuFmPll1_Parameter</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        This parameter is enabled only if McuModulationEnable = true.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <PARAMETERS>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:936dfef8-01fb-4bc6-a1ee-ee19e4550a74">
                              <SHORT-NAME>McuModulationPeriod</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            Frequency for the triangular wave modulation (Fmod).&lt;p/&gt;
                                            The units is in Hz.&lt;p/&gt;
                                            The maximum configurable value for this parameter has to be configured based on the formula:&lt;p/&gt;
                                            Modulation Frequency = (Reference_Frequency) / (4 * Modulation_Period). See MR[MOD_PERIOD] field description from RM.
                                            Modulation_Period can be in range [0 .. 0x1FFF].&lt;p/&gt;
                                            Reference_Frequency represent the output freq of the feedback divider: &lt;p/&gt;
                                              Reference_Frequency = Fvco/NDIV = ((CLKIN*NDIV)/IDF)/NIDV = CLKIN/IDF&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>0</DEFAULT-VALUE>
                              <MAX>8191</MAX>
                              <MIN>0</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:9b32db77-9531-4665-8dab-982fa53f3d21">
                              <SHORT-NAME>McuModulationIncrementStep</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            Modulation increment step.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>0</DEFAULT-VALUE>
                              <MAX>32767</MAX>
                              <MIN>0</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:61f0bbe4-1c1b-4a5e-81dd-aaea9d449462">
                              <SHORT-NAME>McuSpreadSelection</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            Modulation Selection:&lt;p/&gt;
                                                - Center around nominal frequency.&lt;p/&gt;
                                                - Spread below nominal frequency.&lt;p/&gt;
                                            Configure the PLL1FM[MODSEL] field register.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>Down_Spread</DEFAULT-VALUE>
                              <LITERALS>
                                <ECUC-ENUMERATION-LITERAL-DEF>
                                  <SHORT-NAME>Down_Spread</SHORT-NAME>
                                  <ORIGIN>Ccfc</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF>
                                  <SHORT-NAME>Center_Spread</SHORT-NAME>
                                  <ORIGIN>Ccfc</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                              </LITERALS>
                            </ECUC-ENUMERATION-PARAM-DEF>
                          </PARAMETERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:21a539f1-d6bf-46c5-87b4-79114775d760">
                          <SHORT-NAME>McuFdPll1_Parameter</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        This parameter is enabled only if McuFracDivEnable = true.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <PARAMETERS>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:728ce4a7-ed7e-486a-b23a-def6d6d78612">
                              <SHORT-NAME>McuDthDisable</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            Dither Disable.&lt;p/&gt;
                                            Enable / disable dithering.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:91f2fef6-8214-4d49-8c69-7ce9b1b95483">
                              <SHORT-NAME>McuFractionalDivider</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            Fractional divide input.&lt;p/&gt;
                                            When the fractional divide is disabled, the VCO clock frequency is the product of the input clock&lt;p/&gt;
                                            and the loop divide factor (MFD).&lt;p/&gt;
                                            When fractional divide is enabled, the mean VCO clock frequency is given by the equation in the Clock configuration section.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.&lt;p/&gt;
                                        &lt;/html&gt;</L-2>
                              </DESC>
