                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:89853f01-b65c-40e7-b88d-92d8d511a0ec">
                      <SHORT-NAME>McuPMC_ResetEventEnConfig</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                    This Reset Event Enable Register controls whether the voltage detect signal event causes a reset.&lt;p/&gt;
                                    Note: Implementation Specific Parameter.
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <SUB-CONTAINERS>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:7c781759-1b1b-4428-81ea-5962340a1931">
                          <SHORT-NAME>McuREE_VD3</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        This Reset Event Enable Register controls whether the voltage detect signal event causes a reset.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <PARAMETERS>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:af6b18ec-5517-469a-9fb4-55aa37da7e6a">
                              <SHORT-NAME>McuHVD3_P</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            REE_VD3[HVD3_P] field register value.&lt;p/&gt;
                                            This bit defines whether an HVD assertion on the supply of the VDD_LV cold generates a system reset.&lt;p/&gt;
                                            0 Disabled. HVD assertion on the supply of the VDD_LV cold does not cause system reset.&lt;p/&gt;
                                            1 Enabled. HVD assertion on the supply of the VDD_LV cold causes system reset.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <DEFAULT-VALUE>true</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:cea4235f-27c3-4e1a-a507-582052d8cb99">
                              <SHORT-NAME>McuLVD3_F</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            REE_VD3[LVD3_F] field register value.&lt;p/&gt;
                                            This bit defines whether an LVD assertion on the supply of the VDD_LV cold generates a system reset. &lt;p/&gt;
                                            0 Disabled. LVD assertion on the supply of the VDD_LV cold does not cause system reset.&lt;p/&gt;
                                            1 Enabled. LVD assertion on the supply of the VDD_LV cold causes system reset.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <DEFAULT-VALUE>true</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:a95a485d-2070-444d-b84e-1caeca039431">
                              <SHORT-NAME>McuLVD3_C</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            REE_VD3[LVD3_C] field register value.&lt;p/&gt;
                                            This bit defines whether an LVD assertion on the supply of the cold point generates a system reset. &lt;p/&gt;
                                            0 - Disabled. LVD assertion on the supply of the cold point does not cause system reset.&lt;p/&gt;
                                            1 - Enabled. LVD assertion on the supply of the cold point causes system reset.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <DEFAULT-VALUE>true</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                          </PARAMETERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:a70c7dce-1665-4bcc-9b73-e440dbb851a6">
