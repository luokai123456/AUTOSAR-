                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:a0b90cf6-328b-4e7b-bfec-e31f4212df1a">
                      <SHORT-NAME>McuSOFT_FUNC_ResetSource</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                    Software functional reset.&lt;p/&gt;
                                    Note: Implementation Specific Parameter.
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <PARAMETERS>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:cec21351-9eb3-4e25-a3f6-16efe74502df">
                          <SHORT-NAME>McuResetPhase</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RGM_FESS[SS_SOFT_FUNC] field register value.&lt;p/&gt;
                                        Short Sequence for software functional reset.&lt;p/&gt;
                                        0 - The reset sequence triggered by a software functional reset event will start from PHASE1.&lt;p/&gt;
                                        1 - The reset sequence triggered by a software functional reset event will start from PHASE3, skipping PHASE1 and PHASE2.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>PHASE_1</DEFAULT-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>PHASE_1</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>PHASE_3</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:a35633ae-6d3d-45a7-9d4c-ac16ced84c28">
                          <SHORT-NAME>McuResetPin</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RGM_FBRE[BE_SOFT_FUNC] field register value.&lt;p/&gt;
                                        Bidirectional Reset Enable for software functional reset.&lt;p/&gt;
                                        0 - ESR0 is asserted on a software functional reset event if the reset is enabled.&lt;p/&gt;
                                        1 - ESR0 is not asserted on a software functional reset event.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:9cbd9bf7-8f46-4fcf-bb35-5276122cc03b">
                      <SHORT-NAME>McuESR1_ResetSource</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                    ESR1 External Reset source configuration.&lt;p/&gt;
                                    Note: Implementation Specific Parameter.
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <PARAMETERS>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:bddfb51e-cfea-47c6-bd06-34db5781285d">
                          <SHORT-NAME>McuDisableReset</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RGM_FERD[D_ESR1] field register value.&lt;p/&gt;
                                        Disable external reset.&lt;p/&gt;
                                        0 - An ESR1 external reset event triggers a reset sequence.&lt;p/&gt;
                                        1 - An ESR1 external reset event generates either a SAFE mode or an interrupt request
                                            depending on the value of RGM_FEAR.AR_ESR1&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:b004c475-cebb-403d-9fea-13345aa0c60a">
                          <SHORT-NAME>McuEnableInterruptSafe</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RGM_FEAR[AR_ESR1] field register value.&lt;p/&gt;
                                        Alternate Request for ESR1 External Reset&lt;p/&gt;
                                        0 - Generate a SAFE mode request on an ESR1 external reset event if the reset is disabled.&lt;p/&gt;
                                        1 - Generate an interrupt request on an ESR1 external reset event if the reset is disabled.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:8007145b-9371-47ae-8dce-07b0016ec24d">
                          <SHORT-NAME>McuResetPhase</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RGM_FESS[SS_ESR1] field register value.&lt;p/&gt;
                                        Short Sequence for ESR1 External Reset.&lt;p/&gt;
                                        0 - The reset sequence triggered by an ESR1 external reset event will start from PHASE1.&lt;p/&gt;
                                        1 - The reset sequence triggered by an ESR1 external reset event if the reset is enabled will start
                                            from PHASE3, skipping PHASE1 and PHASE2.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>PHASE_1</DEFAULT-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>PHASE_1</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>PHASE_3</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:96ac322b-7941-4932-b0c3-0cf0daade107">
                          <SHORT-NAME>McuResetPin</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RGM_FBRE[BE_ESR1] field register value.&lt;p/&gt;
                                        Bidirectional Reset Enable for ESR1 External Reset&lt;p/&gt;
                                        0 - ESR0 is asserted on an ESR1 external reset event if the reset is enabled&lt;p/&gt;
                                        1 - ESR0 is not asserted on an ESR1 external reset event.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:fc43c958-f103-4a30-9456-22a3bba66720">
                      <SHORT-NAME>McuESR0_ResetSource</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                    ESR0 External Reset source configuration.&lt;p/&gt;
                                    Note: Implementation Specific Parameter.
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <PARAMETERS>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:bee3bac4-a323-4416-a03d-0d2bf223ae25">
                          <SHORT-NAME>McuDisableReset</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RGM_FERD[D_ESR0] field register value.&lt;p/&gt;
                                        Disable external reset.&lt;p/&gt;
                                        0 - An ESR0 external reset event triggers a reset sequence.&lt;p/&gt;
                                        1 - Not possible to set.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:3d0d356f-fdd4-4614-b99e-26178b466bd2">
                          <SHORT-NAME>McuResetPhase</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RGM_FESS[SS_ESR0] field register value.&lt;p/&gt;
                                        Short Sequence for ESR0 External Reset.&lt;p/&gt;
                                        0 - The reset sequence triggered by an ESR0 external reset event will start from PHASE1.&lt;p/&gt;
                                        1 - The reset sequence triggered by an ESR0 external reset event if the reset is enabled will start
                                            from PHASE3, skipping PHASE1 and PHASE2&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>PHASE_1</DEFAULT-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>PHASE_1</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>PHASE_3</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:fffb3753-4c78-449f-a252-468e85832750">
                          <SHORT-NAME>McuResetPin</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RGM_FBRE[BE_ESR0] field register value.&lt;p/&gt;
                                        Bidirectional Reset Enable for ESR0 External Reset&lt;p/&gt;
                                        0 - ESR0 is asserted on an ESR0 external reset event if the reset is enabled.&lt;p/&gt;
                                        1 - Not possible to set.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
