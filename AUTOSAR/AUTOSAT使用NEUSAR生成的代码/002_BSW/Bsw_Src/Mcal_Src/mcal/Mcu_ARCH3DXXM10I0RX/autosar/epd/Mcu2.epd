                                      <MIN>0.0</MIN>
                                    </ECUC-FLOAT-PARAM-DEF>
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:8c7419db-e330-4e7a-95f0-55b794e82b64">
                                      <SHORT-NAME>McuAuxClk5CasDiv0_En</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">&lt;html&gt;
                                                    CGM_AC5_CDC0[DE] field register.&lt;p/&gt;
                                                    Enable the Aux Clock for PSI5_S_TS_CLK.&lt;p/&gt;
                                                    0 - Disable auxiliary clock 5 cascaded divider 0.&lt;p/&gt;
                                                    1 - Enable auxiliary clock 5 cascaded divider 0.&lt;p/&gt;
                                                    Note: Implementation Specific Parameter.
                                                &lt;/html&gt;</L-2>
                                      </DESC>
                                      <ORIGIN>Ccfc</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
