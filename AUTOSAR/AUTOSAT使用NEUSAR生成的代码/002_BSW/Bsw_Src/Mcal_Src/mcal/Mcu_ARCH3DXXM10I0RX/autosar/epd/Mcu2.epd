                                            </ECUC-FLOAT-PARAM-DEF>
                                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:73ea7deb-400e-49f5-9504-04ed717251c8">
                                              <SHORT-NAME>McuAuxClk5CasDiv21_En</SHORT-NAME>
                                              <DESC>
                                                <L-2 L="EN">&lt;html&gt;
                                                            CGM_AC5_CDC21[DE] field register.&lt;p/&gt;
                                                            Enable the Aux Clock for PSI5_S_WD1_CLK.&lt;p/&gt;
                                                            0 - Disable auxiliary clock 5 cascaded divider 21.&lt;p/&gt;
                                                            1 - Enable auxiliary clock 5 cascaded divider 21.&lt;p/&gt;
                                                            Note: Implementation Specific Parameter.
                                                        &lt;/html&gt;</L-2>
                                              </DESC>
                                              <ORIGIN>Ccfc</ORIGIN>
                                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                              <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                              </VALUE-CONFIG-CLASSES>
                                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                            </ECUC-BOOLEAN-PARAM-DEF>
                                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:16db3f22-8ba4-4bca-8894-b52985d068db">
                                              <SHORT-NAME>McuAuxClk5CasDiv21_Divisor</SHORT-NAME>
                                              <DESC>
                                                <L-2 L="EN">&lt;html&gt;
                                                            Set Auxiliary Clock 5 Cascaded Divider 21 Division value.&lt;p/&gt;
                                                            The resultant peripheral clock will have a period &apos;(DIV + 1) x (CGM_AC5_CDC2[DIV] + 1) x (CGM_AC5_DC2[DIV] + 1)&apos; times that of auxiliary clock 5. &lt;p/&gt;
                                                            If DE is set to 0 (divider is disabled), any write access to the DIV field is ignored and the peripheral clock remains disabled.&lt;p/&gt;
                                                            Note: Implementation Specific Parameter.
                                                        &lt;/html&gt;</L-2>
                                              </DESC>
                                              <ORIGIN>Ccfc</ORIGIN>
                                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                              <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                              </VALUE-CONFIG-CLASSES>
                                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                              <DEFAULT-VALUE>1</DEFAULT-VALUE>
                                              <MAX>1024</MAX>
                                              <MIN>1</MIN>
                                            </ECUC-INTEGER-PARAM-DEF>
                                          </PARAMETERS>
                                        </ECUC-PARAM-CONF-CONTAINER-DEF>
