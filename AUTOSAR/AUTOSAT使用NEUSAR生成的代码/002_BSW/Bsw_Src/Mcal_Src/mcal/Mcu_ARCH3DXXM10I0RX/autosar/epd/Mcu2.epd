                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:a8f9e80a-92a4-43f4-b6a1-2c01d0250f7a">
                      <SHORT-NAME>McuAuxClock6</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                    This container enables and selects the configuration clocks for SYSCLK0.&lt;p/&gt;
                                    Note: Implementation Specific Parameter.
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <PARAMETERS>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:aebf6f5e-85ba-4eb0-912f-e05b4b014695">
                          <SHORT-NAME>McuAuxClk6_Source</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        Select the Auxiliary Clock 6 Source Selection.&lt;p/&gt;
                                        Configure the CGM_AC6_SC[SELCTL] field register.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>IRC</DEFAULT-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>IRC</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>XOSC</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>PLL0_PHI</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>PLL1_PHI</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:a709e758-f3fb-4d14-b5b2-ebe7631af022">
                          <SHORT-NAME>McuAuxiliaryClock6Input_Clk</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        This is the frequency for input to dividers.&lt;p/&gt;
                                        Value calculated for user info. It is given in Hz.&lt;p/&gt;
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>0</DEFAULT-VALUE>
                          <MAX>400000000</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                      </PARAMETERS>
                      <SUB-CONTAINERS>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:e7d77faa-1d1e-4ceb-bdb4-7d91481d15b2">
                          <SHORT-NAME>McuAuxiliaryClock6Divider0</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        This container controls Auxiliary Clock 6 Divider 0.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <PARAMETERS>
                            <ECUC-FLOAT-PARAM-DEF UUID="ECUC:07523171-18d8-4796-a403-9289f94d4d2f">
                              <SHORT-NAME>McuAuxiliaryClock6Divider0_Clk</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            This is the frequency for the specific instance of the &quot;McuClockReferencePoint&quot; container.&lt;p/&gt;
                                            Value calculated for user info. It is given in Hz.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>0.0</DEFAULT-VALUE>
                              <MAX>1.0E8</MAX>
                              <MIN>0.0</MIN>
                            </ECUC-FLOAT-PARAM-DEF>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:8128e33c-4007-4de7-8d40-ef17f263c209">
                              <SHORT-NAME>McuAuxClk6Div0_En</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            CGM_AC6_DC0[DE] field register.&lt;p/&gt;
                                            Enable the Aux Clock for SYSCLK0.&lt;p/&gt;
                                            If it is set to 0 (Divider 0 is disabled), any write access to the CGM_AC6_DC0[DIV] field is ignored and the SYSCLK0 clock remains disabled.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:3ede8e5f-fe93-4567-bad9-7716b74441f7">
                              <SHORT-NAME>McuAuxClk6Div0_Divisor</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            CGM_AC6_DC0[DIV] field register with value (McuAuxClk6Div0_Divisor - 1).&lt;p/&gt;
                                            The resultant SYSCLK0 clock will have a period (CGM_AC6_DC0[DIV] + 1) times that of auxiliary clock 6.&lt;p/&gt;
                                            This parameter is enabled only if McuAuxClk6Div0_En is true.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>1</DEFAULT-VALUE>
                              <MAX>512</MAX>
                              <MIN>1</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                          </PARAMETERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                      </SUB-CONTAINERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:e27a84d7-637e-4f49-bf6d-2c01adcd0b62">
                      <SHORT-NAME>McuAuxClock7</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                    This container enables and selects the configuration clocks for SYSCLK1.&lt;p/&gt;
                                    Note: Implementation Specific Parameter.
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <PARAMETERS>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:818a5328-3c0f-4ae5-aa81-e2b8664d4fde">
                          <SHORT-NAME>McuAuxClk7_Source</SHORT-NAME>
                          <DESC>
