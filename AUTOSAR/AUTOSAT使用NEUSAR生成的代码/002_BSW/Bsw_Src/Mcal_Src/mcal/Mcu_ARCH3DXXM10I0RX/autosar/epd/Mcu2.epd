                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:a3d7a3a4-7b86-4373-9fa9-0c21f28a3e70">
                          <SHORT-NAME>McuAuxiliaryClock12Divider1</SHORT-NAME>
