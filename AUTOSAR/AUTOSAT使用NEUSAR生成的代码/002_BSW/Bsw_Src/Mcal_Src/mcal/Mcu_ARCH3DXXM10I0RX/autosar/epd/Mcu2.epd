                          <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/McuConfig/Mcu/McuModuleConfiguration/McuRunConfig</DESTINATION-REF>
                        </ECUC-REFERENCE-DEF>
                        <ECUC-REFERENCE-DEF UUID="ECUC:39629a67-9ecc-453a-b2c8-800385d34a2b">
