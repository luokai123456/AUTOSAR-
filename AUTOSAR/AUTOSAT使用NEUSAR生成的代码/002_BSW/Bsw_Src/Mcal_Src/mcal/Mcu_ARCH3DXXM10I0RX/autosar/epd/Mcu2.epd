                              <SHORT-NAME>McuHVD15_A</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            RES_VD15[HVD15_A] field register value.&lt;p/&gt;
                                            This bit defines whether an HVD assertion on the first supply of the ADC generates a destructive reset or a functional reset.&lt;p/&gt;
                                            0 - Destructive Reset Generated. HVD assertion on the first supply of the ADC causes a destructive system reset.&lt;p/&gt;
                                            1 - Functional Reset Generated. HVD assertion on the first supply of the ADC causes a functional system reset.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:e12a4c0f-6188-4f85-8566-d0dd87c3f6c7">
                              <SHORT-NAME>McuHVD15_C</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            RES_VD15[HVD15_C] field register value.&lt;p/&gt;
                                            This bit defines whether an HVD assertion on the supply of the SDADC generates a destructive reset or a functional reset.&lt;p/&gt;
                                            0 - Destructive Reset Generated. HVD assertion on the supply of the SDADC causes a destructive system reset.&lt;p/&gt;
                                            1 - Functional Reset Generated. HVD assertion on the supply of the SDADC causes a functional system reset.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                          </PARAMETERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                      </SUB-CONTAINERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
