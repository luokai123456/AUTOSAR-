                              <DEFAULT-VALUE>2.5E7</DEFAULT-VALUE>
                              <MAX>2.6E7</MAX>
                              <MIN>0.0</MIN>
                            </ECUC-FLOAT-PARAM-DEF>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:e78e4320-0491-438e-a233-d911cb534d7b">
                              <SHORT-NAME>McuAuxClk1Div0_En</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            CGM_AC1_DC0[DE] field register.&lt;p/&gt;
                                            Enable the Aux Clock for BD LFAST PLL, PD LFAST PLL.&lt;p/&gt;
                                            If it is set to 0 (Divider 0 is disabled), any write access to the CGM_AC1_DC0[DIV] field is ignored and the BD LFAST PLL, PD LFAST PLL clock remains disabled.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:0375cf98-c1d3-421b-a50b-4b2e77d83d64">
                              <SHORT-NAME>McuAuxClk1Div0_Divisor</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            Set Aux1 Divider 0 Division value.&lt;p/&gt;
                                            Set the CGM_AC1_DC0[DIV] field register with value (McuAuxClk1Div0_Divisor - 1).&lt;p/&gt;
                                            The resultant motor control clock will have a period (CGM_AC1_DC0[DIV] + 1) times that of auxiliary clock 1.&lt;p/&gt;
                                            This parameter is enabled only if McuAuxClk1Div0_En is true.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>2</DEFAULT-VALUE>
                              <MAX>128</MAX>
                              <MIN>1</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                          </PARAMETERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                      </SUB-CONTAINERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:1e727408-1787-42d6-8bcb-d75662a6ac04">
                      <SHORT-NAME>McuAuxClock2</SHORT-NAME>
