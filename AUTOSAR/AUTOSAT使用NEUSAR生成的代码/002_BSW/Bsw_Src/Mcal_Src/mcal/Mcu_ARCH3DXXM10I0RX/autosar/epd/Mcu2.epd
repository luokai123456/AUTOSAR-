                <ECUC-INTEGER-PARAM-DEF UUID="e53e0e3d-b437-4147-8870-2d06fda2544b">
                  <SHORT-NAME>McuNumberOfMcuModes</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">This parameter shall represent the number of Modes available for the MCU.                        The calculation method for the value is num:i( count(.. /McuModeSettingConf/*))</L-2>
                  </DESC>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
