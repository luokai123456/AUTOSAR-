                                            This is the frequency for the specific instance of the &quot;McuClockReferencePoint&quot; container.&lt;p/&gt;
                                            Value calculated for user info. It is given in Hz.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>0.0</DEFAULT-VALUE>
                              <MAX>2.5E7</MAX>
                              <MIN>0.0</MIN>
                            </ECUC-FLOAT-PARAM-DEF>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:1f92bd14-0447-4b93-be09-9a2fa6efdea9">
                              <SHORT-NAME>McuAuxClk12Div0_En</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            CGM_AC12_DC0[DE] field register.&lt;p/&gt;
                                            Enable the Aux Clock for MCLK.&lt;p/&gt;
                                            If it is set to 0 (Divider 12 is disabled), any write access to the CGM_AC12_DC0[DIV] field is ignored and the MCLK clock remains disabled.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:15a219b0-23f8-4781-b935-6264e45f1acb">
                              <SHORT-NAME>McuAuxClk12Div0_Divisor</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            Set Aux12 Divider 0 Division value.&lt;p/&gt;
                                            Set the CGM_AC12_DC0[DIV] field register with value (McuAuxClk12Div0_Divisor - 1).&lt;p/&gt;
                                            The resultant motor control clock will have a period (CGM_AC12_DC0[DIV] + 1) times that of auxiliary clock 0.&lt;p/&gt;
                                            This parameter is enabled only if McuAuxClk12Div0_En is true.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>1</DEFAULT-VALUE>
                              <MAX>8192</MAX>
                              <MIN>1</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
