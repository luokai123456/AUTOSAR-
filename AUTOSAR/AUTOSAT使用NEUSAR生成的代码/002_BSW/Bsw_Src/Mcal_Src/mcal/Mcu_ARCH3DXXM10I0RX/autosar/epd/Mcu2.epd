                                              <DEFAULT-VALUE>1</DEFAULT-VALUE>
                                              <MAX>1024</MAX>
                                              <MIN>1</MIN>
                                            </ECUC-INTEGER-PARAM-DEF>
                                          </PARAMETERS>
                                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:684f77a7-6ce8-4668-bfc0-2efd5bcb0b63">
