                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:236d775a-fd9d-428b-9e2e-9a26f311caec">
                      <SHORT-NAME>McuPMC_ResetEventSelConfig</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                    This Reset Event Select Register controls whether the voltage detect signal event causes a destructive or functional reset.&lt;p/&gt;
                                    Note: Implementation Specific Parameter.
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <SUB-CONTAINERS>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:c4a89db5-948d-44da-8777-423ffc36dbea">
                          <SHORT-NAME>McuRES_VD3</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        This Reset Event Select Register controls whether the voltage detect signal event causes a destructive or functional reset.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <PARAMETERS>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:65bde650-bf1c-4c90-9d99-35716a52a8b7">
                              <SHORT-NAME>McuHVD3_P</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            RES_VD3[HVD3_P] field register value.&lt;p/&gt;
                                            This bit defines whether an HVD assertion on the supply of the VDD_LV cold generates a destructive reset or
                                            a functional reset. The REE_VD3[HVD3_P] bit determines whether the reset event is enabled.&lt;p/&gt;
                                            0 - Destructive Reset Generated. HVD assertion on the supply of the VDD_LV cold causes a destructive system reset.&lt;p/&gt;
                                            1 - Functional Reset Generated. HVD assertion on the supply of the VDD_LV cold causes a functional system reset.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:dcaed3c1-2a2a-475f-8559-d825db9e5c5f">
                              <SHORT-NAME>McuLVD3_F</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            RES_VD3[LVD3_F] field register value.&lt;p/&gt;
                                            This bit defines whether an LVD assertion on the supply of the VDD_LV cold generates a destructive reset or
                                            a functional reset. The REE_VD3[LVD3_F] bit determines whether the reset event is enabled.&lt;p/&gt;
                                            0 - Destructive Reset Generated. LVD assertion on the supply of the VDD_LV cold causes a destructive system reset.&lt;p/&gt;
                                            1 - Functional Reset Generated. LVD assertion on the supply of the VDD_LV cold causes a functional system reset.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
