                              <DEFAULT-VALUE>1</DEFAULT-VALUE>
                              <MAX>8192</MAX>
                              <MIN>1</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:8914a8be-301d-43dc-a0f3-d56c9a37f115">
