                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:943f55e6-e7a6-49cf-93de-515b0c3c6cbb">
                              <SHORT-NAME>McuAuxClk2Div0_Divisor</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                            Set Aux2 Divider 0 Division value.&lt;p/&gt;
                                            Set the CGM_AC2_DC0[DIV] field register with value (McuAuxClk2Div0_Divisor - 1).&lt;p/&gt;
                                            The resultant motor control clock will have a period (CGM_AC2_DC0[DIV] + 1) times that of auxiliary clock 2.&lt;p/&gt;
                                            This parameter is enabled only if McuAuxClk2Div0_En is true.&lt;p/&gt;
                                            Note: Implementation Specific Parameter.
                                        &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Ccfc</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
