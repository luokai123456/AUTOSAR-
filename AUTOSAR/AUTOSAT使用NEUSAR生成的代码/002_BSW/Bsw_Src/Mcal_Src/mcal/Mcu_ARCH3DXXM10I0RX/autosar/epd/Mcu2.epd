                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:aa37b90f-c7c5-4206-8db7-503480e72715">
                      <SHORT-NAME>McuPMC_VoltageSupplyConfig</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                    The Voltage Supply for I/O Segments (VSIO) register indicates if the I/O segment indicated uses a 3.3V or 5.0V supply.
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <PARAMETERS>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:7640dafb-d6d4-4941-a155-9971c7b66a04">
                          <SHORT-NAME>McuVSIO_IF2</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        VSIO[VSIO_IF2] field register value.&lt;p/&gt;
                                        This bit is used to control the supply levels used by the second Flexray I/O segment.&lt;p/&gt;
                                        0 - The I/O segment uses a 3.3V supply.&lt;p/&gt;
                                        1 - The I/O segment uses a 5.0V supply.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:702bff34-3cca-46d3-8964-7221002d9f6d">
                          <SHORT-NAME>McuVSIO_IF</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        VSIO[VSIO_IF] field register value.&lt;p/&gt;
                                        This bit is used to control the supply levels used by the Flexray I/O segment.&lt;p/&gt;
                                        0 - The I/O segment uses a 3.3V supply.&lt;p/&gt;
                                        1 - The I/O segment uses a 5.0V supply.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:c39b3b41-739f-4b07-93f7-3f42a1b2a729">
                          <SHORT-NAME>McuVSIO_IJ</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        VSIO[VSIO_IJ] field register value.&lt;p/&gt;
                                        This bit is used to control the supply levels used by the JTAG I/O segment.&lt;p/&gt;
                                        0 - The I/O segment uses a 3.3V supply.&lt;p/&gt;
                                        1 - The I/O segment uses a 5.0V supply.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:047ddfdb-48dd-404a-83ad-a2b274183012">
                          <SHORT-NAME>McuVSIO_IM</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        VSIO[VSIO_IM] field register value.&lt;p/&gt;
                                        This bit is used to control the supply levels used by the Main I/O segment.&lt;p/&gt;
                                        0 - The I/O segment uses a 3.3V supply.&lt;p/&gt;
                                        1 - The I/O segment uses a 5.0V supply.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:cbaa6401-f185-4ef5-9950-2fc7085ebfe4">
                      <SHORT-NAME>McuPMC_TempResetEventEnConfig</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                    This Reset Event Enable Register controls whether the temperature detect signal event causes a reset.
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <PARAMETERS>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:51ecb9b1-e176-44d2-a49c-8a2155a60cb4">
                          <SHORT-NAME>McuTEMP_3</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        REE_TD[TEMP_3] field register value.&lt;p/&gt;
                                        This bit defines whether a temperature detect assertion generates a system reset.&lt;p/&gt;
                                        0 - Disabled. Temperature Sensor detect does not cause system reset.&lt;p/&gt;
                                        1 - Enabled. Temperature Sensor detect causes system reset.&lt;p/&gt;
                                        Note: Implementation Specific Parameter. Force it to false because of the errata e8412.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:e7646067-4144-4135-9a2f-676cf8dfbf87">
                          <SHORT-NAME>McuTEMP_2</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        REE_TD[TEMP_2] field register value.&lt;p/&gt;
                                        This bit defines whether a temperature detect assertion generates a system reset.&lt;p/&gt;
                                        0 - Disabled. Temperature Sensor detect does not cause system reset.&lt;p/&gt;
                                        1 - Enabled. Temperature Sensor detect causes system reset.&lt;p/&gt;
                                        Note: Implementation Specific Parameter. Force it to false because of the errata e8412.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:2fe099c5-a623-42c6-bb8c-fcdd693dded7">
                          <SHORT-NAME>McuTEMP_0</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        REE_TD[TEMP_0] field register value.&lt;p/&gt;
                                        This bit defines whether a temperature detect assertion generates a system reset.&lt;p/&gt;
                                        0 - Disabled. Temperature Sensor detect does not cause system reset.&lt;p/&gt;
                                        1 - Enabled. Temperature Sensor detect causes system reset.&lt;p/&gt;
                                        Note: Implementation Specific Parameter. Force it to false because of the errata e8412.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:8bcf087f-03b3-4684-ac19-97ff2eed8a25">
                      <SHORT-NAME>McuPMC_TempResetEventSelConfig</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                    This Reset Event Select Register controls whether the temperature sensor detect signal event causes
                                    a destructive or functional reset.
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <PARAMETERS>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:82e21db7-9655-44bf-b838-7302b8a0c96e">
                          <SHORT-NAME>McuTEMP_3</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RES_TD[TEMP_3] field register value.&lt;p/&gt;
                                        This bit defines whether a temperature detect assertion generates a destructive reset or a functional reset.&lt;p/&gt;
                                        0 - Destructive Reset Generated. Temperature Sensor assertion causes a destructive system reset.&lt;p/&gt;
                                        1 - Functional Reset Generated. Temperature Sensor assertion causes a functional system reset.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:80b2f1e4-7182-4825-9135-698d1410a856">
                          <SHORT-NAME>McuTEMP_2</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RES_TD[TEMP_2] field register value.&lt;p/&gt;
                                        This bit defines whether a temperature detect assertion generates a destructive reset or a functional reset.&lt;p/&gt;
                                        0 - Destructive Reset Generated. Temperature Sensor assertion causes a destructive system reset.&lt;p/&gt;
                                        1 - Functional Reset Generated. Temperature Sensor assertion causes a functional system reset.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:004f5b1c-5691-4acd-9ad0-9de49f8fd708">
                          <SHORT-NAME>McuTEMP_0</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        RES_TD[TEMP_0] field register value.&lt;p/&gt;
                                        This bit defines whether an temperature detect assertion generates a destructive reset or a functional reset.&lt;p/&gt;
                                        0 - Destructive Reset Generated. Temperature Sensor assertion causes a destructive system reset.&lt;p/&gt;
                                        1 - Functional Reset Generated. Temperature Sensor assertion causes a functional system reset.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:e38f2950-93eb-4342-8ebf-21dd880c9eed">
                      <SHORT-NAME>McuPMC_TempDetectorConfig</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                    The Temperature Sensor Registers contains two enables that must both be enabled in order for the Temperature Sensor to be operable.
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <PARAMETERS>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:f327d35c-fcd4-4a14-8df1-2a7ef12b3aa9">
                          <SHORT-NAME>McuTS3IE</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        CTL_TD[TS3IE] field register value.&lt;p/&gt;
                                        This bit determines whether an interrupt is seen by the system when the voltage detect event occurs.&lt;p/&gt;
                                        0 - No interrupt occurs.&lt;p/&gt;
                                        1 - An interrupt occurs.&lt;p/&gt;
                                        Note: Implementation Specific Parameter. Force it to false because of the errata e8412.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:55bcb5d1-df9b-4806-8f13-de5062f813ea">
                          <SHORT-NAME>McuTS2IE</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        CTL_TD[TS2IE] field register value.&lt;p/&gt;
                                        This bit determines whether an interrupt is seen by the system when the voltage detect event occurs.&lt;p/&gt;
                                        0 - No interrupt occurs.&lt;p/&gt;
                                        1 - An interrupt occurs.&lt;p/&gt;
                                        Note: Implementation Specific Parameter. Force it to false because of the errata e8412.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:bb437286-aa9f-459c-93b9-8e0428474d7c">
                          <SHORT-NAME>McuTS0IE</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        CTL_TD[TS0IE] field register value.&lt;p/&gt;
                                        This bit determines whether an interrupt is seen by the system when the voltage detect event occurs.&lt;p/&gt;
                                        0 - No interrupt occurs.&lt;p/&gt;
                                        1 - An interrupt occurs.&lt;p/&gt;
                                        Note: Implementation Specific Parameter. Force it to false because of the errata e8412.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:abfb2673-4057-4cdf-bbb0-38756bcb31ee">
                          <SHORT-NAME>McuTRIM_ADJ_OVER</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        CTL_TD[TRIM_ADJ_OVER[3:0] field register.&lt;p/&gt;
                                        These bits are a signed binary number that is added to the over temperature trim (NT_TD2)value.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.&lt;p/&gt;
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>0</DEFAULT-VALUE>
                          <MAX>15</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:eee053a4-be8a-4219-99ea-9c4fb35aeb1f">
                          <SHORT-NAME>McuTRIM_ADJ_UNDER</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        CTL_TD[TRIM_ADJ_UNDER[3:0] field register.&lt;p/&gt;
                                        These bits are a signed binary number that is added to the Under temperature trim value (NT_TD0).&lt;p/&gt;
                                        Note: Implementation Specific Parameter.&lt;p/&gt;
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>0</DEFAULT-VALUE>
                          <MAX>15</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:e73e63bb-4121-489c-a5df-fbdeb3d26fa1">
                          <SHORT-NAME>McuDOUT_EN</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        CTL_TD[DOUT_EN] field register value.&lt;p/&gt;
                                        0 - Disable digital output.&lt;p/&gt;
                                        1 - Enable digital output.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:8c4e83cc-9d50-4811-a290-52bdd193561c">
                          <SHORT-NAME>McuAOUT_EN</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        CTL_TD[AOUT_EN] field register value.&lt;p/&gt;
                                        0 - Disable analog output.&lt;p/&gt;
                                        1 - Enable analog output.&lt;p/&gt;
                                        Note: Implementation Specific Parameter.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:124ac0e9-e490-48ae-9c90-dabaf697193f">
                      <SHORT-NAME>McuPMC_TempFCCUEventEnConfig</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                    This Temp Sensor FCCU Event Enable Register controls whether the temperature sensor detect signal event
                                    causes an event signal to be sent to the FCCU (Fault Collection and Control Unit).&lt;p/&gt;
                                    Note: Implementation Specific Parameter.
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <PARAMETERS>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:661ef00e-e700-425b-8524-5efdffb4b573">
                          <SHORT-NAME>McuFEE_TS3</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        FEE_TD[FEE_TS3] field register value.&lt;p/&gt;
                                        This bit defines whether a temperature detect assertion generates an FCCU event.&lt;p/&gt;
                                        0 - Disabled. Temp Sensor detect does not cause an FCCU event.&lt;p/&gt;
                                        1 - Enabled. Temp Sensor detect causes an FCCU event.&lt;p/&gt;
                                        Note: Implementation Specific Parameter. Force it to false because of the errata e8412.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:93f258be-6833-481b-97b7-f43d0886f99d">
                          <SHORT-NAME>McuFEE_TS2</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        FEE_TD[FEE_TS2] field register value.&lt;p/&gt;
                                        This bit defines whether a temperature detect assertion generates an FCCU event.&lt;p/&gt;
                                        0 - Disabled. Temp Sensor detect does not cause an FCCU event.&lt;p/&gt;
                                        1 - Enabled. Temp Sensor detect causes an FCCU event.&lt;p/&gt;
                                        Note: Implementation Specific Parameter. Force it to false because of the errata e8412.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:7e12d03b-ac72-431c-b90b-dc10854df68b">
                          <SHORT-NAME>McuFEE_TS0</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                        FEE_TD[FEE_TS0] field register value.&lt;p/&gt;
                                        This bit defines whether a temperature detect assertion generates an FCCU event.&lt;p/&gt;
                                        0 - Disabled. Temp Sensor detect does not cause an FCCU event.&lt;p/&gt;
                                        1 - Enabled. Temp Sensor detect causes an FCCU event.&lt;p/&gt;
                                        Note: Implementation Specific Parameter. Force it to false because of the errata e8412.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                  </SUB-CONTAINERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:3fda88af-5143-4276-b8b8-a58cf5b7d256">
                  <SHORT-NAME>FccuConfigSet</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">&lt;html&gt;
                        &lt;p&gt;&lt;/p&gt;This container is the base for a multiple configuration set.
                            &lt;/html&gt;</L-2>
                  </DESC>
                  <PARAMETERS>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:378b0655-d873-48a7-b3e7-9dd13005552e">
                      <SHORT-NAME>FccuGlitchFilterBypass</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                            FCCU Glitch Filter Bypass.
                            &lt;/html&gt;</L-2>
                      </DESC>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <DEFAULT-VALUE>true</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:9889877e-7535-411c-875d-f66f6df20e29">
                      <SHORT-NAME>FccuGlitchFilterWidth</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                            FCCU Glitch Filter Width
                            &lt;ul&gt;
                            &lt;li&gt; Filters glitches of up to 50 us &lt;/li&gt;
                            &lt;li&gt; Filters glitches of up to 75 us &lt;/li&gt;
                            &lt;li&gt; Filters glitches of up to 100 us &lt;/li&gt;
                            &lt;/ul&gt;
                            &lt;/html&gt;</L-2>
                      </DESC>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <DEFAULT-VALUE>Up_To_50_us</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>Up_To_50_us</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>Up_To_75_us</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>Up_To_100_us</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:1f40c244-6e74-494e-877e-9a7288eaecdc">
                      <SHORT-NAME>FaultTimeout</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                              &lt;p&gt;Non-critical fault timeout. If the fault with enabled recovery timeout is not recovered 
                              within the timeout period the FCCU moves from the ALARM state to the FAULT state.&lt;/p&gt;
                              &lt;p&gt;NCF timeout can be computed using the following equations:&lt;/p&gt;
                              &lt;p style=&quot;margin-left: 5em;&quot;&gt;Timeout&amp;nbsp;=&amp;nbsp;T&lt;sub&gt;RC16MHz&lt;/sub&gt;&amp;nbsp;&amp;times;&amp;nbsp;FaultTimeout&lt;/p&gt;
                              &lt;p style=&quot;margin-left: 5em;&quot;&gt;Timeout&amp;nbsp;=&amp;nbsp;0.0625&amp;nbsp;&amp;times;&amp;nbsp;FaultTimeout&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[&amp;mu;s]&lt;/p&gt;
                              &lt;/html&gt;</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <DEFAULT-VALUE>65535</DEFAULT-VALUE>
                      <MAX>4294967295</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:16b5d888-ff9f-4df7-82a1-9858fc540475">
                      <SHORT-NAME>DeltaT</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                              &lt;p&gt;In case of a failure event, the pin(s) are set to faulty state for a minimum time T_min, even if SW
                                tries to release it before (for the case of error pin configured in Bistable mode only).&lt;/p&gt;
                              &lt;p style=&quot;margin-left: 5em;&quot;&gt;T_min&amp;nbsp;=&amp;nbsp;250&amp;nbsp;&amp;mu;s&amp;nbsp;+&amp;nbsp;delta_T&lt;/p&gt;
                              &lt;p&gt;with delta_T parameter being configurable by SW up to 16,383&amp;nbsp;&amp;mu;s (10&amp;nbsp;ms).&lt;/p&gt;
                            &lt;/html&gt;</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <DEFAULT-VALUE>0</DEFAULT-VALUE>
                      <MAX>16383</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:858cdd75-7dd4-4b6b-b6e2-5bde89cc0744">
                      <SHORT-NAME>ConfigTimeout</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt; 
                              &lt;p&gt;If the configuration is not completed within the time-out, 
                                the FCCU moves automatically from the CONFIG state to the NORMAL state and 
                                the default values for the configuration register is restored.&lt;/p&gt;
                              &lt;p&gt;Configuration timeout can be computed using the following equation:&lt;/p&gt;
                              &lt;p style=&quot;margin-left: 5em;&quot;&gt;Timeout&amp;nbsp;=&amp;nbsp;T&lt;sub&gt;RC16MHz&lt;/sub&gt;&amp;nbsp;&amp;times;&amp;nbsp;2&lt;sup&gt;(ConfigTimeout&amp;nbsp;+&amp;nbsp;10)&lt;/sup&gt;&lt;/p&gt;
                              &lt;table style=&quot;border: 2px black solid; border-collapse: collapse;&quot;&gt;
                                &lt;tr&gt;
                                  &lt;th style=&quot;width: 8em; border: 1px black solid; border-collapse: collapse;&quot;&gt;Value&lt;/th&gt;
                                  &lt;th style=&quot;width: 8em; border: 1px black solid; border-right: 2px black solid; border-collapse: collapse;&quot;&gt;Timeout&lt;br /&gt;[&amp;mu;s]&lt;/th&gt;
                                  &lt;th style=&quot;width: 8em; border: 1px black solid; border-collapse: collapse;&quot;&gt;Value&lt;/th&gt;
                                  &lt;th style=&quot;width: 8em; border: 1px black solid; border-collapse: collapse;&quot;&gt;Timeout&lt;br /&gt;[&amp;mu;s]&lt;/th&gt;
                                &lt;/tr&gt;
                                &lt;tr&gt;
                                  &lt;td style=&quot;text-align: center; border: 1px black solid; border-collapse: collapse;&quot;&gt;0&lt;/td&gt;
                                  &lt;td style=&quot;text-align: center; border: 1px black solid; border-right: 2px black solid; border-collapse: collapse;&quot;&gt;64&lt;/td&gt;
                                  &lt;td style=&quot;text-align: center; border: 1px black solid; border-collapse: collapse;&quot;&gt;1&lt;/td&gt;
                                  &lt;td style=&quot;text-align: center; border: 1px black solid; border-collapse: collapse;&quot;&gt;128&lt;/td&gt;
                                &lt;/tr&gt;
                                &lt;tr&gt;
                                  &lt;td style=&quot;text-align: center; border: 1px black solid; border-collapse: collapse;&quot;&gt;2&lt;/td&gt;
                                  &lt;td style=&quot;text-align: center; border: 1px black solid; border-right: 2px black solid; border-collapse: collapse;&quot;&gt;256&lt;/td&gt;
                                  &lt;td style=&quot;text-align: center; border: 1px black solid; border-collapse: collapse;&quot;&gt;3&lt;/td&gt;
                                  &lt;td style=&quot;text-align: center; border: 1px black solid; border-collapse: collapse;&quot;&gt;512&lt;/td&gt;
                                &lt;/tr&gt;
                                &lt;tr&gt;
                                  &lt;td style=&quot;text-align: center; border: 1px black solid; border-collapse: collapse;&quot;&gt;4&lt;/td&gt;
                                  &lt;td style=&quot;text-align: center; border: 1px black solid; border-right: 2px black solid; border-collapse: collapse;&quot;&gt;1024&lt;/td&gt;
                                  &lt;td style=&quot;text-align: center; border: 1px black solid; border-collapse: collapse;&quot;&gt;5&lt;/td&gt;
                                  &lt;td style=&quot;text-align: center; border: 1px black solid; border-collapse: collapse;&quot;&gt;2048&lt;/td&gt;
                                &lt;/tr&gt;
                                &lt;tr&gt;
                                  &lt;td style=&quot;text-align: center; border: 1px black solid; border-collapse: collapse;&quot;&gt;&lt;strong&gt;6&lt;/strong&gt;&lt;/td&gt;
                                  &lt;td style=&quot;text-align: center; border: 1px black solid; border-right: 2px black solid; border-collapse: collapse;&quot;&gt;&lt;strong&gt;4096&lt;/strong&gt;&lt;/td&gt;
                                  &lt;td style=&quot;text-align: center; border: 1px black solid; border-collapse: collapse;&quot;&gt;7&lt;/td&gt;
                                  &lt;td style=&quot;text-align: center; border: 1px black solid; border-collapse: collapse;&quot;&gt;8192&lt;/td&gt;
                                &lt;/tr&gt;
                              &lt;/table&gt;
                              &lt;/html&gt;</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <DEFAULT-VALUE>6</DEFAULT-VALUE>
                      <MAX>7</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:9779877e-7535-411c-875d-f66f6df20e29">
                      <SHORT-NAME>EOUT_FaultOutputMode</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                            Fault Output Mode Selection
                            &lt;ul&gt;
                            &lt;li&gt; Dual-Rail (default state) [fccu_eout[1:0]= outputs] &lt;/li&gt;
                            &lt;li&gt; Time Switching [fccu_eout[1:0]= output to be used] &lt;/li&gt;
                            &lt;li&gt; Bi-Stable &lt;/li&gt;
                            &lt;/ul&gt;
                            &lt;p&gt;&lt;/p&gt; Note: In the Test mode, a simple double-stage resynchronization stage is used to resynchronize the EOUT input/outputs on the system/safe clock. 
                            &lt;/html&gt;</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <DEFAULT-VALUE>EOUT_DualRail</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>EOUT_DualRail</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>EOUT_TimeSwitching</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>EOUT_BiStable</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FCCU_FOM_TEST_0</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FCCU_FOM_TEST_1</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FCCU_FOM_TEST_2</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:9779877e-7355-411c-875d-f66f6df20e29">
                      <SHORT-NAME>EOUT_Prescaler</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                            Fault Output Prescaler configuration (applicable for Dual-Rail or Time-Switching mode only). When in Dual-Rail or Time-Switching mode, the togglling frequency of EOUT signal is calculated by the following equation: 
                            &lt;p style=&quot;margin-left: 5em;&quot;&gt;EOUT&lt;sub&gt;freq&lt;/sub&gt;&amp;nbsp;=&amp;nbsp;CLK_SAFE&lt;sub&gt;freq&lt;/sub&gt;&amp;nbsp;&amp;divide;&amp;nbsp;((EOUT_Prescaler&amp;nbsp;+&amp;nbsp;1)&amp;times;&amp;nbsp;2&amp;nbsp;&amp;times;&amp;nbsp;2048&amp;nbsp;)&lt;/p&gt;
                            &lt;p&gt;&lt;/p&gt; Note: This value will not impact functional in BiStable mode. 
                            &lt;/html&gt;</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <DEFAULT-VALUE>0</DEFAULT-VALUE>
                      <MAX>127</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:377b0655-c873-48a7-b3e7-9dd13005552e">
                      <SHORT-NAME>CfgToIrqEnabled</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                            Configuration Timeout Interrupt Enable.
                            &lt;/html&gt;</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <DEFAULT-VALUE>true</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:bbe1e60f-0e7c-402d-8068-e89799970f43">
                      <SHORT-NAME>FccuLockedConfiguration</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                            Hard-lock this configuration set: 
                            &lt;ul&gt;
                                &lt;li&gt;Unchecked: After Fccu_Init, the configuration is not locked. &lt;/li&gt;
                                &lt;li&gt;TRANSIENTLY: After Fccu_Init, the configuration is hardlocked. &lt;/li&gt;
                                &lt;li&gt;PERANENTLY: After Fccu_Init, the configuration is hardlocked. &lt;/li&gt;
                            &lt;/ul&gt;
                            &lt;/html&gt;</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <DEFAULT-VALUE>FCCU_TRANSIENTLY_UNLOCK</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FCCU_TRANSIENTLY_UNLOCK</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FCCU_TRANSIENTLY_LOCK</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FCCU_PERANENTLY_LOCK</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:f8c348ee-b9ff-41c6-87ee-c182e9b87e25">
                      <SHORT-NAME>EOUT_SwitchingMode</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                            EOUT Switching mode
                            &lt;ul&gt;
                            &lt;li&gt;Unchecked: EOUT protocol (dual-rail, time-switching) slow switching mode. &lt;/li&gt;
                            &lt;li&gt;Checked  : EOUT protocol (dual-rail, time-switching) fast switching mode. &lt;/li&gt;
                            &lt;/ul&gt;
                            Switching Mode has no effect on the bi-stable protocol.
                            &lt;/html&gt;</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:50970b86-6dfc-44d2-a0d8-3b533828790c">
                      <SHORT-NAME>EOUT_PolaritySelection</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                            EOUT Polarity Selection
                            &lt;ul&gt;
                            &lt;li&gt;Unchecked: fcc_eout[1] active high, fcc_eout[0] active low. &lt;/li&gt;
                            &lt;li&gt;Checked: fcc_eout[1] active low, fcc_eout[0] active high. &lt;/li&gt;
                            &lt;/ul&gt;
                            This bit can be read and written by the software. Active state means a state indicating FAULT and 
                            is applicable for non-toggling protocols only.
                            &lt;/html&gt;</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:f1167cd6-5eda-4d34-ac2d-a7250e7f52d9">
                      <SHORT-NAME>EOUT_AfterReset</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                            This bit controls the enable of the error output pins after reset lifts:
                            &lt;ul&gt;
                            &lt;li&gt;Unchecked: error pins move to HI-Z state.&lt;/li&gt;
                            &lt;li&gt;Checked  : start EOUT pins functioning.&lt;/li&gt;
                            &lt;/ul&gt;
                            Unless is this bit written to 1, the error outout pins stay in High-Z state after reset lifts and 
                            the FCCU EOUT reporting is not functioning.
                            &lt;/html&gt;</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:9779877e-7535-411c-875d-f66f6df20e29">
                      <SHORT-NAME>FCCU_SET_CLEAR</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                Error pin state can be controlled by these bits 
                            &lt;/html&gt;</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <DEFAULT-VALUE>FCCU_EP_INDEPENDENT_ABOVE_SW</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FCCU_EP_INDEPENDENT_ABOVE_SW</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FCCU_EP_FAULTY_STATE</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FCCU_EP_OK_STATE</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:9779877e-7535-411c-875d-f66f6df20e29">
                      <SHORT-NAME>OD</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                Mechanism to select between Push-pull and Open drain(OD) mode for the error indicating pin(s) 
                            &lt;/html&gt;</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <DEFAULT-VALUE>FCCU_EP_OUTPUT_OPEN_DRAIN</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FCCU_EP_OUTPUT_OPEN_DRAIN</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FCCU_EP_OUTPUT_PUSH_PULL</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:9779877e-7535-411c-875d-f66f6df20e29">
                      <SHORT-NAME>FOP</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                EOUT Output Frequency Selete.
                            &lt;/html&gt;</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <DEFAULT-VALUE>FCCU_EOUT_FOP_VARIABLE</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FCCU_EOUT_FOP_VARIABLE</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FCCU_EOUT_FOP_FIXED_61HZ</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:9779877e-7535-411c-875d-f66f6df20e29">
                      <SHORT-NAME>EOF</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                EOUT Output Frequency Selete.
                                EOF[6] and EOF[5:0] are combined to select the EOUT Output Frequency. 
                            &lt;/html&gt;</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <DEFAULT-VALUE>FCCU_EOUT_EOF_61HZ</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FCCU_EOUT_EOF_61HZ</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FCCU_EOUT_EOF_122HZ</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FCCU_EOUT_EOF_244HZ</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FCCU_EOUT_EOF_488HZ</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FCCU_EOUT_EOF_976HZ</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FCCU_EOUT_EOF_1952HZ</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FCCU_EOUT_EOF_3904HZ</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FCCU_EOUT_EOF_7808HZ</SHORT-NAME>
                          <ORIGIN>Ccfc</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-FUNCTION-NAME-DEF UUID="ECUC:58b5e6c6-4207-499b-9b26-f473d37fdff6">
                      <SHORT-NAME>AlarmNotificationApi</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                              &lt;p&gt;In case of a failure event, if alarm interrupt is enabled, the fault shall be notified to 
                                application using this callback. The prototype of the notification function is&lt;/p&gt;
                              &lt;p style=&quot;margin-left: 5em;&quot;&gt;void Fccu_NotificationCallbackFunction( Fccu_FaultType FaultID );&lt;/p&gt;
                            &lt;/html&gt;</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <ECUC-FUNCTION-NAME-DEF-VARIANTS>
                        <ECUC-FUNCTION-NAME-DEF-CONDITIONAL>
                          <DEFAULT-VALUE>NULL_PTR</DEFAULT-VALUE>
                        </ECUC-FUNCTION-NAME-DEF-CONDITIONAL>
                      </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                    </ECUC-FUNCTION-NAME-DEF>
                    <ECUC-FUNCTION-NAME-DEF UUID="ECUC:58b5e6c6-4207-466b-9b26-f473d37fdff6">
                      <SHORT-NAME>FccuConfigTimeOutNotificationAPI</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                              &lt;p&gt;In case of a timeout during mode configuration, if Configuration TimeOut Interrupt is enabled, the timeout shall be notified to 
                                application using this callback. The prototype of the notification function is&lt;/p&gt;
                              &lt;p style=&quot;margin-left: 5em;&quot;&gt;void &lt;Fccu_NotificationCallbackFunction(void)&gt;;&lt;/p&gt;
                            &lt;/html&gt;</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>Ccfc</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <ECUC-FUNCTION-NAME-DEF-VARIANTS>
                        <ECUC-FUNCTION-NAME-DEF-CONDITIONAL>
                          <DEFAULT-VALUE>NULL_PTR</DEFAULT-VALUE>
                        </ECUC-FUNCTION-NAME-DEF-CONDITIONAL>
                      </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                    </ECUC-FUNCTION-NAME-DEF>
                  </PARAMETERS>
                  <SUB-CONTAINERS>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:ac16f412-b19d-48a6-ab7b-6c7a806afd6a">
                      <SHORT-NAME>DefaultFaultConfig</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                &lt;p&gt;This subcontainer specifies default configuration of all non-critical fault sources.
                                   All sources are enabled by default.&lt;/p&gt;
                                &lt;p&gt;Possible deviations must to be explicitly specified at  the &lt;b&gt;Fault&lt;/b&gt; tab.&lt;/p&gt;
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <PARAMETERS>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:51dce42e-4ecc-4baa-9f55-6b8bf350eff5">
                          <SHORT-NAME>RecoveryType</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                    Non-critical fault configuration
                                    &lt;ul&gt;
                                    &lt;li&gt;HW recoverable fault&lt;/li&gt;
                                    &lt;li&gt;SW recoverable fault&lt;/li&gt;
                                    &lt;/ul&gt;
                                    &lt;p&gt;&lt;/p&gt;The non-critical fault configuration defines the fault recovery mode.
                                    &lt;p&gt;&lt;/p&gt;HW recoverable faults are self recovered (status flag clearing and related) if the root cause (input fault)has been removed.
                                    &lt;p&gt;&lt;/p&gt;SW recoverable faults are recovered (status flag clearing) by SW clearing of the related status flag.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>SwRecoverableFault</DEFAULT-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>SwRecoverableFault</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>HwRecoverableFault</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:d1fec224-4ecc-481d-8fc1-ac559f77edc6">
                          <SHORT-NAME>ReactionType</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                    Non-critical fault state configuration
                                    &lt;ul&gt;
                                    &lt;li&gt; Short functional reset request pulse (FAULT state reaction)&lt;/li&gt;
                                    &lt;li&gt; Long functional reset request pulse (FAULT state reaction)&lt;/li&gt;
                                    &lt;li&gt; No reset reaction &lt;/li&gt;
                                    &lt;/ul&gt;
                                    &lt;!--/** Workaround Errata e7429 */ --!&gt;
                                    &lt;p&gt;Note:&lt;/p&gt;
                                    Due to hardware limitations then:
                                    &lt;ul&gt;
                                    &lt;li&gt;Reset Reaction of all Faults default is No Reset Reaction. &lt;/li&gt;
                                    &lt;li&gt;User can change this configuration for each Fault in Fault tab. &lt;/li&gt;
                                    &lt;li&gt;With Fault MCEM_FCCU_FLASH_INIT allways configured is No Reset Reaction.&lt;/li&gt;
                                    &lt;/ul&gt;
                                    &lt;!--/** End Workaround Errata e7429 */ --!&gt;
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>NoResetReaction</DEFAULT-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>ShortResetReaction</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>LongResetReaction</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>NoResetReaction</SHORT-NAME>
                              <ORIGIN>Ccfc</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:789e1d41-4ecc-458f-b9cc-2f433d73c11e">
                          <SHORT-NAME>RecoveryTimeOutEnabled</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                    Fault time-out enable
                                    &lt;ul&gt;
                                    &lt;li&gt;Unchecked: FCCU moves into the FAULT state if the respective fault is enabled&lt;/li&gt;
                                    &lt;li&gt;Checked: FCCU moves into the ALARM state if the respective fault is enabled&lt;/li&gt;
                                    &lt;/ul&gt;
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:61000e3f-4ecc-4bb1-9a1d-4549f0c93299">
                          <SHORT-NAME>AlarmIrqEnabled</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                    IRQ alarm enable
                                    &lt;ul&gt;
                                    &lt;li&gt;Unchecked: Alarm is disabled for the configured error source.&lt;/li&gt;
                                    &lt;li&gt;Checked: Alarm is enabled for the configured error source. &lt;/li&gt;
                                    &lt;/ul&gt;
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:9a901a2f-4ecc-4366-9720-ed4596ca730a">
                          <SHORT-NAME>FaultNmiEnabled</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                    NMI enable
                                    &lt;ul&gt;
                                    &lt;li&gt;Unchecked: NMI is disabled for error (NCF/) source x.&lt;/li&gt;
                                    &lt;li&gt;Checked: NMI is enabled for error (NCF/) source x. &lt;/li&gt;
                                    &lt;/ul&gt;
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:573d22a8-4ecc-455c-bff4-b6cca35ac3d9">
                          <SHORT-NAME>ActivateOutputPins</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                    EOUT signaling enable
                                    &lt;ul&gt;
                                    &lt;li&gt;Unchecked:EOUT signaling is disabled for error (NCF/) source x. Error pins are as if in non-faulty state.&lt;/li&gt;
                                    &lt;li&gt;Checked: EOUT signaling is enabled for error (NCF/) source x. &lt;/li&gt;
                                    &lt;/ul&gt;
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:e2d99ec4-d1ad-4aab-8bbf-b262974338d8">
                      <SHORT-NAME>Fault</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                Reference to faults with non-default handlings.
                                &lt;p&gt;&lt;/p&gt;By default, all non-reserved faults are enabled and handled according to the default configurations. The explicitly created fault is enabled, and the default values for recovery and reaction type are selected. It can be disabled or configured differently.
                                &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY-INFINITE>1</UPPER-MULTIPLICITY-INFINITE>
                      <MULTIPLICITY-CONFIG-CLASSES>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      </MULTIPLICITY-CONFIG-CLASSES>
                      <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                      <PARAMETERS>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:0f02227e-6eae-4546-b144-245da2ecfcf5">
                          <SHORT-NAME>SignalDesc</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                    Non-critical fault enable
                                    &lt;ul&gt;
                                    &lt;li&gt; No actions following the respective non-critical fault assertion &lt;/li&gt;
                                    &lt;li&gt; FCCU moves to ALARM or FAULT state &lt;/li&gt;
                                    &lt;/ul&gt;
                                    &lt;p&gt;&lt;/p&gt;If fault is selected, it is automatically enabled, and the default values for recovery and reaction type are selected.
                                    Also Alarm and Fault interrupts (IRQ and NMI), Timeout and EOUT signaling are selected.
                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>Ccfc</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
