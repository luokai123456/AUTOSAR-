                  <PARAMETERS>
                    <ECUC-INTEGER-PARAM-DEF UUID="4f802290-7b7e-4da7-aa17-ba42d243c04c">
                      <SHORT-NAME>SpiSequenceId</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">SPI Sequence ID, used as parameter in SPI API functions.</L-2>
                      </DESC>
                      <SCOPE>ECU</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
