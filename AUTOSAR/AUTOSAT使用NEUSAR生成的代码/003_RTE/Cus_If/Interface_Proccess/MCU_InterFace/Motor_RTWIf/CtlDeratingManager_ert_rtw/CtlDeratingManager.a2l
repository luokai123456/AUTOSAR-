  /begin  RECORD_LAYOUT Record_BOOLEAN
    FNC_VALUES 1 UBYTE COLUMN_DIR DIRECT
  /end  RECORD_LAYOUT 

  /begin  RECORD_LAYOUT Record_FLOAT32_IEEE
    FNC_VALUES 1 FLOAT32_IEEE COLUMN_DIR DIRECT
  /end  RECORD_LAYOUT 

  /begin  RECORD_LAYOUT Record_UBYTE
    FNC_VALUES 1 UBYTE COLUMN_DIR DIRECT
  /end  RECORD_LAYOUT 

  /begin  RECORD_LAYOUT Record_UWORD
    FNC_VALUES 1 UWORD COLUMN_DIR DIRECT
  /end  RECORD_LAYOUT 

  /* Record Layouts for Lookup Tables in Standard Axis format */

  /begin RECORD_LAYOUT Axis_FLOAT32_IEEE
    AXIS_PTS_X 1 FLOAT32_IEEE INDEX_INCR DIRECT
  /end RECORD_LAYOUT 


